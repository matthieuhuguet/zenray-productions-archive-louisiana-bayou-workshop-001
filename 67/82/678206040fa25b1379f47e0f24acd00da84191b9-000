# 20 October 2026 : per chart statistics of a tailor run, to see which charts take the seams. Usage : python -I TailorCharts.py <mesh.json> <tailor.json>
import sys, json, numpy as np
sys.path.insert(0, 'Scripts'); sys.path.insert(0, '/Users/zenray/.claude/skills/zenray-houdini/scripts/zenray_uv')
import TailorDev as D, ZruvTailor as T
m, S, org, must = D.load(sys.argv[1])
t = json.load(open(sys.argv[2]))
lab = np.array(t['lab'])
cut = np.zeros(S.ne, dtype=bool)
for a, b in t['seams']:
    cut[S.emap[(min(a, b), max(a, b))]] = True
cut |= S.EF1 < 0
kinds = dict()
for (a, b), k in zip(t['seams'], t['seam_kind']):
    kinds[S.emap[(min(a, b), max(a, b))]] = k
rows = []
for k in np.unique(lab[lab >= 0]):
    fs = [int(f) for f in np.where(lab == k)[0]]
    loc = T.Local(S, fs, cut)
    uv = t['uv']
    U = np.zeros((loc.n, 2))
    for (f, j), lv in loc.corner.items():
        U[lv] = uv['%d_%d' % (f, j)]
    s, a, sc = T.measure(S.P[loc.gv], loc.tris, U)
    q = T.quantiles(s, a)
    inner = [e for f in fs for e in S.fe[f] if cut[e] and S.EF1[e] >= 0 and lab[S.EF0[e]] == k and lab[S.EF1[e]] == k]
    inner = sorted(set(inner))
    border = sorted(set(e for f in fs for e in S.fe[f] if cut[e] and S.EF1[e] >= 0 and (lab[S.EF0[e]] != k or lab[S.EF1[e]] != k)))
    kc = {}
    for e in inner:
        kc[kinds.get(e, '?')] = kc.get(kinds.get(e, '?'), 0) + S.EL[e]
    rows.append((float(S.FA[fs].sum()), k, len(fs), q[0], q[1], float(S.EL[inner].sum()), float(S.EL[border].sum()), {x: round(y, 3) for x, y in kc.items()}))
rows.sort(reverse=True)
for r in rows:
    print('chart %4d faces %5d area %.4f  p50 %.3f p95 %.3f  inner seams %.3f m  border %.3f m  %s' % (r[1], r[2], r[0], r[3], r[4], r[5], r[6], r[7]))
