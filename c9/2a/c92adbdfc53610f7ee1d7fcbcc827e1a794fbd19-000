def evaluate(geo, name='uv'):
    m = Z.from_geo(geo, (name,), [])
    il, _ = Z.uv_islands(m, name)
    R, S, A, chis = [], [], [], []
    for i in range(int(il.max()) + 1):
        ff = np.where(il == i)[0]
        P3, T, uv, _c = O._island_arrays(m, name, ff)
        E = set()
        for f in ff:
            p = m.polys[f]
            for k in range(len(p)):
                E.add((min(p[k], p[(k + 1) % len(p)]), max(p[k], p[(k + 1) % len(p)])))
        chis.append(len(set(pp for f in ff for pp in m.polys[f])) - len(E) + len(ff))
        r, s, a3 = O.distortion(P3, T, uv)
        sc = np.sqrt(a3.sum() / max((r ** 2 * a3).sum(), 1e-30))
        uv = O.arap(P3, T, uv * sc)
        r, s, a3 = O.distortion(P3, T, uv)
        R.append(r); S.append(s); A.append(a3)
    R, S, A = np.concatenate(R), np.concatenate(S), np.concatenate(A)
    w = A / A.sum()
    return {'islands': int(il.max()) + 1, 'chi': dict(Counter(chis)), 'd5': round(float(w[np.abs(R - 1) <= 0.05].sum()), 4), 'd10': round(float(w[np.abs(R - 1) <= 0.1].sum()), 4),
            's10': round(float(w[S <= 0.1].sum()), 4), 'prims': len(geo.prims()), 'points': len(geo.points())}


