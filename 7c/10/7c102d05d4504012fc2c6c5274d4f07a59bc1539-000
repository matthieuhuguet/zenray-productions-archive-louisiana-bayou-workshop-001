// 8 October 2026 : siding with EXACT openings. EN: every clapboard row is cut analytically around the windows and the door (left, right, below the sill, above the lintel), so no boolean is needed and every piece stays a clean quad. The row count is multiplied by plank_multiplier (x1 = the old 28 rows, x2, x3). FR : ouvertures exactes, plus de boolean, nombre de planches multiplie.
int addq(vector a; vector b; vector c; vector d; int rid; string grp) {
    int p0 = addpoint(0, a); int p1 = addpoint(0, b); int p2 = addpoint(0, c); int p3 = addpoint(0, d);
    int pr = addprim(0, "poly", p0, p1, p2, p3);
    setprimattrib(0, "piece_id", pr, pr);
    setprimattrib(0, "plank_row", pr, rid);
    setprimgroup(0, grp, pr, 1);
    return pr;
}
void sq(int flip; float xb; float xt; float yb; float yt; float ya; float yc; float z0; float z1; int rid; string grp) {
    if (z1 - z0 < 0.0001 || yc - ya < 0.0001) return;
    float ta = (ya - yb) / max(yt - yb, 0.000001); float tc = (yc - yb) / max(yt - yb, 0.000001);
    float xa = lerp(xb, xt, ta); float xc = lerp(xb, xt, tc);
    if (flip == 0) addq(set(xa, ya, z0), set(xc, yc, z0), set(xc, yc, z1), set(xa, ya, z1), rid, grp);
    else addq(set(xa, ya, z1), set(xc, yc, z1), set(xc, yc, z0), set(xa, ya, z0), rid, grp);
}
void side_row(int flip; float xb; float xt; float yb; float yt; float l; float wz[]; float hw; float oy0; float oy1; int rid; string grp) {
    float cur = -l * 0.5;
    if (yb < oy1 && yt > oy0) {
        for (int i = 0; i < len(wz); ++i) {
            float z0 = wz[i] - hw; float z1 = wz[i] + hw;
            sq(flip, xb, xt, yb, yt, yb, yt, cur, z0, rid, grp);                          // column left of the window, full row
            if (yb < oy0) sq(flip, xb, xt, yb, yt, yb, min(yt, oy0), z0, z1, rid, grp);   // under the sill
            if (yt > oy1) sq(flip, xb, xt, yb, yt, max(yb, oy1), yt, z0, z1, rid, grp);   // over the lintel
            cur = z1;
        }
    }
    sq(flip, xb, xt, yb, yt, yb, yt, cur, l * 0.5, rid, grp);
}
void gq(int flip; float zb; float zt; float yb; float yt; float hb; float ht; float ya; float yc; float x0; float x1; int rid; string grp) {
    if (yc - ya < 0.0001) return;
    float ta = (ya - yb) / max(yt - yb, 0.000001); float tc = (yc - yb) / max(yt - yb, 0.000001);
    float ha = lerp(hb, ht, ta); float hc = lerp(hb, ht, tc);
    float xla = max(x0, -ha); float xra = min(x1, ha); float xlc = max(x0, -hc); float xrc = min(x1, hc);
    if (xra - xla < 0.0001 && xrc - xlc < 0.0001) return;
    float za = lerp(zb, zt, ta); float zc = lerp(zb, zt, tc);
    if (flip == 0) addq(set(xla, ya, za), set(xlc, yc, zc), set(xrc, yc, zc), set(xra, ya, za), rid, grp);
    else addq(set(xra, ya, za), set(xrc, yc, zc), set(xlc, yc, zc), set(xla, ya, za), rid, grp);
}
void gable_row(int flip; float zb; float zt; float yb; float yt; float hb; float ht; float ox0[]; float ox1[]; float oy0[]; float oy1[]; int rid; string grp) {
    float cur = -1000000.0;
    for (int i = 0; i < len(ox0); ++i) {
        if (yb < oy1[i] && yt > oy0[i]) {
            gq(flip, zb, zt, yb, yt, hb, ht, yb, yt, cur, ox0[i], rid, grp);
            if (yb < oy0[i]) gq(flip, zb, zt, yb, yt, hb, ht, yb, min(yt, oy0[i]), ox0[i], ox1[i], rid, grp);
            if (yt > oy1[i]) gq(flip, zb, zt, yb, yt, hb, ht, max(yb, oy1[i]), yt, ox0[i], ox1[i], rid, grp);
            cur = ox1[i];
        }
    }
    gq(flip, zb, zt, yb, yt, hb, ht, yb, yt, cur, 1000000.0, rid, grp);
}

