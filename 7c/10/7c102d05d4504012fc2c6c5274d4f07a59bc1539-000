int add_pt(int geo; vector p; float sc) {
    int pt = addpoint(geo, p);
    setpointattrib(geo, "pscale", pt, sc);
    return pt;
}

void build_arm(int geo; float side; float y_king; float R; float th; int nseg; float z; float peak_y; float slope; float dstop; float sc) {
    int prim = addprim(geo, "polyline");
    float prev_perp = 1e9;
    vector prev = set(0, y_king, z);
    float sl = sqrt(1.0 + slope * slope);
    for (int i = 0; i <= nseg; ++i) {
        float phi = th * float(i) / float(nseg);
        float x = side * R * (1.0 - cos(phi));
        float y = y_king + R * sin(phi);
        vector cur = set(x, y, z);
        float perp = (peak_y - slope * abs(x) - y) / sl;
        if (i > 0 && perp <= dstop) {
            float t = (prev_perp - dstop) / max(1e-6, prev_perp - perp);
            addvertex(geo, prim, add_pt(geo, lerp(prev, cur, clamp(t, 0.0, 1.0)), sc));
            return;
        }
        addvertex(geo, prim, add_pt(geo, cur, sc));
        prev_perp = perp; prev = cur;
    }
}

