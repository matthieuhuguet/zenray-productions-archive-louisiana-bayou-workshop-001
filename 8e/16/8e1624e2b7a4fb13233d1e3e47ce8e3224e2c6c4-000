    const mem = m.textures.reduce((a, t) => a + t.mib, 0);
    const tex = m.textures.map(t => `${t.count > 1 ? t.count + ' × ' : ''}${fr(t.w)} × ${fr(t.h)}`).join(' + ');
    return `<tr><td><a href="#${m.id}">${m.id}</a> ${esc(m.title)}</td><td>${badge(m.score)}</td><td>${tex}</td><td>${n(mem, 1)} Mio</td>
      <td>${n(m.islands)}</td><td>${n(m.seams.seams_m, 1)} m</td><td>${n(m.cook_s, 2)} s</td></tr>`;
  }).join('');
  return `<div class="card"><h2>Comparaison</h2><p class="muted">Mémoire par carte en BC7 (un octet par pixel) avec mipmaps ; un matériau complet en compte
  plusieurs (couleur, normale, rugosité).</p><div class="scroll"><table><thead><tr><th>Méthode</th><th>Score</th><th>Textures</th><th>Mémoire, une carte de chaque texture</th>
  <th>Îles</th><th>Coutures</th><th>Calcul</th></tr></thead><tbody>${rows}</tbody></table></div></div>`;
}
function method(m) {
  const v = m.views, t = m.texel, s = m.seams;
  const comps = Object.entries(m.components).map(([k, x]) => `<tr><td><code>${esc(k)}</code></td><td>${badge(x)}</td></tr>`).join('');
  const tex = m.textures.map(t => `<tr><td>${esc(t.label)}</td><td>${n(t.count)} × ${n(t.w)} × ${n(t.h)}</td><td>${n(t.mib_each, 1)} Mio</td></tr>`).join('');
  // 19 October 2026 : one image per texture : M5 base tile and decal atlas, M3 trim bands and tileable faces, otherwise the single uv set
  const parts = v.uv_family_base ? [['_base', 'la base sur sa tuile'], ['_decals', 'les decals dans leur atlas']]
              : v.uv_family_bands ? [['_bands', 'les bandes de la trim sheet (u se répète)'], ['_tile', 'les grandes faces sur la tuile de leur famille']] : [['', 'à leur vraie place']];
  const base = parts.map(([k, c]) => fig(v['uv_family' + k], 'UV par famille : ' + c));
  const dens = parts.map(([k, c]) => fig(v['uv_density' + k], 'Densité : ' + c));
  const uv2 = v.uv2_family ? `<h3 style="margin-top:18px">uv2, le jeu unique du masque</h3><div class="grid g2" style="margin-top:8px">${fig(v.uv2_family, 'uv2 par famille')}
    ${fig(v.uv2_density, 'Densité de uv2 (' + fr(m.uv2.texel.target_px_per_m) + ' px/m)')}</div>` : '';
  const bake = Object.keys(m.bake || {}).length ? `<h3 style="margin-top:18px">Cartes cuites</h3><div class="grid g3" style="margin-top:8px">${
      Object.entries(m.bake).map(([k, p]) => fig(p, k)).join('')}</div>` : '';
  return `<section class="card" id="${m.id}"><div class="head"><h2>${m.id} ${esc(m.title)}</h2>${badge(m.score)}</div>
  <p>${esc(m.idea)}</p>
  <h3>Couleur ID par famille : la vue 3D et le placement des UV</h3><div class="grid g2" style="margin-top:8px">${fig(v.family_3d, 'Vue 3D en perspective, une couleur par famille')}${base.join('')}</div>
  <h3 style="margin-top:18px">Texel density, ${n(t.target_px_per_m)} px/m demandés</h3>
  <p class="muted">Blanc ${pct(t.exact_frac)}, rouge (pas assez) ${pct(t.low_frac)}, bleu (trop) ${pct(t.high_frac)} de la surface ; mesuré de ${n(t.px_per_m_min, 1)}
  à ${n(t.px_per_m_max, 1)} px/m, étirement maximal ${pct(t.stretch_max)}.</p>
  <div class="grid g2" style="margin-top:8px">${fig(v.density_3d, 'Densité sur le modèle (blanc juste à 1 %)')}${dens.join('')}</div>
  <h3 style="margin-top:18px">UV checker et UV Seam Checker</h3>
  <div class="legend"><span><span class="dot" style="background:#e8559a"></span> <span class="dot" style="background:#3a7bf2"></span> damier : des carrés égaux veulent dire une densité égale</span>
  <span><span class="dot" style="background:#ec48aa"></span> couture</span><span><span class="dot" style="background:#5adceb"></span> arête vive gardée dans une île</span></div>
  <div class="grid g2" style="margin-top:8px">${fig(v.checker_3d, 'Damier rose et bleu lu dans les UV')}${fig(v.seams_3d, 'UV Seam Checker')}</div>
  <p class="muted">Pli demandé ${n(s.crease_requested, 1)}°, appliqué ${n(s.crease_effective, 3)}° (jamais sur un angle du maillage), ${n(s.ambiguous_edges)} arête ambiguë,
  ${n(s.chains_mixed)} chaîne coupée à moitié ; coutures ${n(s.seams_m, 1)} m dont ${n(s.seams_on_smooth_m, 2)} m sur des arêtes lisses (fermeture des tubes).</p>
  ${uv2}${bake}${m.variant ? `<h3 style="margin-top:18px">Variante hotspot, mesurée et écartée</h3><p class="muted">${esc(m.variant.nodes)}. Densité juste à 1 % sur
  ${pct(m.variant.density_within_1pc)} de la surface, à 30 % sur ${pct(m.variant.density_within_30pc)} ; de ${n(m.variant.px_per_m_min)} à ${n(m.variant.px_per_m_max)} px/m ;
  ${pct(1 - m.variant.not_mirrored)} des faces en miroir. ${esc(m.variant.verdict)}</p>` : ''}
  <div class="grid g2" style="margin-top:18px"><div><h3>Composantes du score</h3><div class="scroll"><table><tbody>${comps}</tbody></table></div></div>
  <div><h3>Textures</h3><div class="scroll"><table><tbody>${tex}</tbody></table></div>
  <p class="muted">${n(m.islands)} îles${m.fill != null ? ', remplissage ' + pct(m.fill) : ''}, calcul ${n(m.cook_s, 2)} s${m.bake_s ? ', cuisson ' + n(m.bake_s, 1) + ' s' : ''}.</p>
  <p class="muted">Rapport : <code>${esc(m.report)}</code></p></div></div></section>`;
}
function footer() {
  return `<div class="card"><h2>Relancer</h2><p class="muted">Depuis un terminal, Houdini ouvert :</p>
  <p><code>/Users/zenray/.venvs/shorts/bin/python -I /Users/zenray/.claude/skills/zenray-houdini/scripts/zenray_uv/ZenRayUV.py run --methods ${D.methods.map(m => m.id).join(',')} --asset ${esc(D.asset)} --td ${D.texel_density} --scale ${D.asset_scale}</code></p>
  <p class="muted">Ou dans Houdini, bouton « Run, score and write the sheet » de <code>CTRL_zruv</code> ; chaque réglage y vit, huit au plus par dossier.</p></div>`;
}
document.getElementById('app').innerHTML = D ? header() + summary() + D.methods.map(method).join('') + footer() : '<p>Aucune donnée.</p>';
</script>
</body>
</html>
