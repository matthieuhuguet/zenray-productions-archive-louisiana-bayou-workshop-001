minority_m": 0.2346}, {"angle": 90.0, "edges": 12, "cut": 8, "minority_m": 1.5403}, {"angle": 90.0, "edges": 12, "cut": 8, "minority_m": 1.4419}, {"angle": 45.0, "edges": 4, "cut": 3, "minority_m": 0.3442}], "consistency": 0.866079, "seams_m": 291.379, "seams_on_smooth_m": 0, "sharp_kept_m": 107.753, "sharp_m": 273.827, "border_m": 125.305, "pass": false}, "islands": 565, "fill": 0.0, "u_range": [-0.0003, 13.6182], "v_range": [0.4343, 2.998], "cook_s": 0.84, "bake_s": null, "date": "20 October 2026 06:59", "report": "M5/report.json", "example": {"texture": "M5/texture_decal_relief.png", "normal": "M5/texture_decal_normal.png", "textured_3d": "M5/view_textured_3d.png", "textured_close": "M5/view_textured_close.png"}, "method_text": {"steps": ["La base est M2 ; sur chaque arête convexe de 80 à 120 degrés des familles choisies, une bande pliée sur l'arête, soulevée de 1 mm, ne porte qu'un biseau arrondi d'usure dans la normale.", "Sur les grandes faces planes choisies (le panneau), une rainure suit leur contour en retrait de 5 cm, et des rivets la longent tous les 18 cm ; aucun texte, aucune couleur : le decal ne change que la normale.", "Toutes les bandes se répètent le long de u : l'atlas tient en quelques rangées, la plus petite feuille permise (512 sur 256 px), au lieu de pixels uniques pour une face entière."], "when": "Détail de surface sur de grandes coques ou de grands murs : arêtes usées, rainures, rivets, sans agrandir la texture de base (les panel decals de DECALmachine, les decals DBuffer de normale d'Unreal Engine 5).", "check": "L'atlas de normales et son relief éclairé, puis la vue texturée : lumière et ombre le long des arêtes et du panneau, la couleur de la base inchangée."}}], "scale_img": "view_scale.png", "scale": {"asset_h": 5.957, "asset_w": 3.55, "asset_d": 0.316, "mannequin_h": 1.76}, "materials": {"iron": "metal001_basecolor.png", "pillar": "wood_color.jpg", "sign": "wood_color.jpg"}}</script>
<script>
// 19 October 2026 : renders the sheet from the JSON above ; one function per block, the same for every asset and every method.
const D = JSON.parse(document.getElementById('zruv-data').textContent);
const fr = (x, d = 0) => Number(x).toLocaleString('fr-FR', {minimumFractionDigits: d, maximumFractionDigits: d}).replace(/ /g, ' ');
const pct = x => fr(100 * x, 2) + ' %';
const n = (x, d = 0) => `<span class="num">${fr(x, d)}</span>`;
const esc = s => String(s).replace(/[&<>]/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;'}[c]));
const fig = (src, cap) => src ? `<figure><img loading="lazy" src="${src}" alt="${esc(cap)}"><figcaption>${cap}</figcaption></figure>` : '';
const badge = s => `<span class="badge ${s >= 0.999 ? 'pass' : 'fail'}">${fr(s, 4)}</span>`;
function toggleTheme() { const r = document.documentElement; r.dataset.theme = r.dataset.theme === 'dark' ? 'light' : 'dark'; }
function header() {
  const fam = D.families.map(f => `<span class="chip"><span class="dot" style="background:rgb(${f.rgb.join(',')})"></span>${esc(f.name)}</span>`).join('');
  const sc = D.scale || {};
  return `<div class="card"><div class="head"><h1>ZenRay UV, cinq méthodes</h1><span class="muted">${esc(D.date)}</span></div>
  <p class="muted">Asset <code>${esc(D.asset)}</code>, échelle ${n(D.asset_scale, 2)}, densité demandée ${n(D.texel_density)} px/m. Chaque score est la plus petite
  de ses composantes, mesurées sur les UV réellement écrites ; une méthode est finie à ${n(0.999, 3)}.</p>
  <h3 style="margin-top:12px">Familles de matériaux (couleur ID)</h3><div class="chips" style="margin-top:6px">${fam}</div>
  <nav class="toc">${D.methods.map(m => `<a href="#${m.id}">${m.id} ${esc(m.title)}</a>`).join('')}</nav></div>
  <div class="card"><h2>Échelle, à côté du mannequin de ${n(sc.mannequin_h || 1.76, 2)} m</h2>
  <p class="muted">Vue de face orthographique, mêmes mètres par pixel pour l'asset et le mannequin, une ligne par mètre. Asset : ${n(sc.asset_w || 0, 2)} m de large,
  ${n(sc.asset_h || 0, 2)} m de haut, ${n(sc.asset_d || 0, 2)} m de profondeur.</p>${fig(D.scale_img, 'Asset et mannequin à la même échelle')}</div>`;
}
function summary() {
  const rows = D.methods.map(m => {
    const mem = m.textures.reduce((a, t) => a + t.mib, 0);
    const tex = m.textures.map(t => `${t.count > 1 ? t.count + ' × ' : ''}${fr(t.w)} × ${fr(t.h)}`).join(' + ');
    return `<tr><td><a href="#${m.id}">${m.id}</a> ${esc(m.title)}</td><td>${badge(m.score)}</td><td>${tex}</td><td>${n(mem, 1)} Mio</td>
      <td>${n(m.islands)}</td><td>${n(m.seams.seams_m, 1)} m</td><td>${n(m.cook_s, 2)} s</td></tr>`;
  }).join('');
  return `<div class="card"><h2>Comparaison</h2><p class="muted">Mémoire par carte en BC7 (un octet par pixel) avec mipmaps ; un matériau complet en compte
  plusieurs (couleur, normale, rugosité).</p><div class="scroll"><table><thead><tr><th>Méthode</th><th>Score</th><th>Textures</th><th>Mémoire, une carte de chaque texture</th>
  <th>Îles</th><th>Coutures</th><th>Calcul</th></tr></thead><tbody>${rows}</tbody></table></div></div>`;
}
function method(m) {
  const v = m.views, t = m.texel, s = m.seams;
  const comps = Object.entries(m.components).map(([k, x]) => `<tr><td><code>${esc(k)}</code></td><td>${badge(x)}</td></tr>`).join('');
  const tex = m.textures.map(t => `<tr><td>${esc(t.label)}</td><td>${n(t.count)} × ${n(t.w)} × ${n(t.h)}</td><td>${n(t.mib_each, 1)} Mio</td></tr>`).join('');
  // 19 October 2026 : one image per texture : M5 base tile and decal atlas, M3 trim bands and tileable faces, otherwise the single uv set
  const parts = v.uv_family_base ? [['_base', 'la base sur sa tuile'], ['_decals', 'les decals dans leur atlas']]
              : v.uv_family_bands ? [['_bands', 'les bandes de la trim sheet (u se répète)'], ['_tile', 'les grandes faces sur la tuile de leur famille']] : [['', 'à leur vraie place']];
  const base = parts.map(([k, c]) => fig(v['uv_family' + k], 'UV par famille : ' + c));
  const dens = parts.map(([k, c]) => fig(v['uv_density' + k], 'Densité : ' + c));
  const uv2 = v.uv2_family ? `<h3 style="margin-top:18px">uv2, le jeu unique du masque</h3><div class="grid g2" style="margin-top:8px">${fig(v.uv2_family, 'uv2 par famille')}
    ${fig(v.uv2_density, 'Densité de uv2 (' + fr(m.uv2.texel.target_px_per_m) + ' px/m)')}</div>` : '';
  const LAB = {custom: 'couleur ID', occlusion: 'occlusion', curvature: 'courbure', edge: 'arêtes', alpha: 'couverture', worldnormal: 'normale monde', position: 'position',
               mask_R: 'canal rouge : usure des arêtes', mask_G: 'canal vert : faces tournées vers le ciel', mask_B: 'canal bleu : vers le sol', base: 'matières avant les couches',
               layered: 'résultat des couches (Copernicus)', mask_rgb: 'masque RVB empaqueté (Channel Join, Copernicus)'};
  const ORDER = ['mask_rgb', 'mask_R', 'mask_G', 'mask_B', 'base', 'layered', 'custom', 'occlusion', 'curvature', 'edge', 'worldnormal', 'position', 'alpha'];
  const bk = Object.entries(m.bake || {}).sort((a, b) => ORDER.indexOf(a[0]) - ORDER.indexOf(b[0]));
  const bake = bk.length ? `<h3 style="margin-top:18px">${m.id === 'M4' ? 'Les trois canaux, puis le mélange des couches' : 'Cartes cuites'}</h3><div class="grid g3" style="margin-top:8px">${
      bk.map(([k, p]) => fig(p, LAB[k] || k)).join('')}</div>` : '';
  const mt = m.method_text || {}, ex = m.example || {};
  const steps = (mt.steps || []).map(x => `<li>${esc(x)}</li>`).join('');
  const meth = mt.steps ? `<h3>Méthodologie</h3><ol class="steps">${steps}</ol><p><b class="lab">Quand la choisir :</b> ${esc(mt.when)}</p>
    <p><b class="lab">Comment la valider ici :</b> ${esc(mt.check)}</p>` : '';
  const exm = ex.textured_3d ? `<h3 style="margin-top:18px">Exemple texturé, avec les matières de Houdini</h3><div class="grid g2" style="margin-top:8px">
    ${fig(ex.textured_3d, 'Vue trois-quarts texturée')}${fig(ex.textured_close, 'Gros plan texturé : chapiteau du pilier et départ de l’arche')}</div>
    ${ex.texture ? `<div class="grid g2" style="margin-top:8px">${fig(ex.texture, 'La texture de la méthode')}</div>` : ''}` : '';
  return `<section class="card" id="${m.id}"><div class="head"><h2>${m.id} ${esc(m.title)}</h2>${badge(m.score)}</div>
  <p>${esc(m.idea)}</p>${meth}${exm}
  <h3>Couleur ID par famille : la vue 3D et le placement des UV</h3><div class="grid g2" style="margin-top:8px">${fig(v.family_3d, 'Vue 3D en perspective, une couleur par famille')}${base.join('')}</div>
  <h3 style="margin-top:18px">Texel density, ${n(t.target_px_per_m)} px/m demandés</h3>
  <p class="muted">Blanc ${pct(t.exact_frac)}, rouge (pas assez) ${pct(t.low_frac)}, bleu (trop) ${pct(t.high_frac)} de la surface ; mesuré de ${n(t.px_per_m_min, 1)}
  à ${n(t.px_per_m_max, 1)} px/m, étirement maximal ${pct(t.stretch_max)}.</p>
  <div class="grid g2" style="margin-top:8px">${fig(v.density_3d, 'Densité sur le modèle (blanc juste à 1 %)')}${dens.join('')}</div>
  <h3 style="margin-top:18px">UV checker et UV Seam Checker</h3>
  <div class="legend"><span><span class="dot" style="background:#ebebeb"></span> <span class="dot" style="background:#19191c"></span> damier noir et blanc : des carrés égaux veulent dire une densité égale</span>
  <span><span class="dot" style="background:#ec48aa"></span> couture</span><span><span class="dot" style="background:#5adceb"></span> arête vive gardée dans une île</span></div>
  <div class="grid g2" style="margin-top:8px">${fig(v.checker_3d, 'Damier noir et blanc lu dans les UV')}${fig(v.seams_3d, 'UV Seam Checker')}</div>
  <p class="muted">Pli demandé ${n(s.crease_requested, 1)}°, appliqué ${n(s.crease_effective, 3)}° (jamais sur un angle du maillage), ${n(s.ambiguous_edges)} arête ambiguë,
  ${n(s.chains_mixed)} chaîne coupée à moitié ; coutures ${n(s.seams_m, 1)} m dont ${n(s.seams_on_smooth_m, 2)} m sur des arêtes lisses (fermeture des tubes).</p>
  ${uv2}${bake}${m.variant ? `<h3 style="margin-top:18px">Variante hotspot, mesurée et écartée</h3><p class="muted">${esc(m.variant.nodes)}. Densité juste à 1 % sur
  ${pct(m.variant.density_within_1pc)} de la surface, à 30 % sur ${pct(m.variant.density_within_30pc)} ; de ${n(m.variant.px_per_m_min)} à ${n(m.variant.px_per_m_max)} px/m ;
  ${pct(1 - m.variant.not_mirrored)} des faces en miroir. ${esc(m.variant.verdict)}</p>` : ''}
  <div class="grid g2" style="margin-top:18px"><div><h3>Composantes du score</h3><div class="scroll"><table><tbody>${comps}</tbody></table></div></div>
  <div><h3>Textures</h3><div class="scroll"><table><tbody>${tex}</tbody></table></div>
  <p class="muted">${n(m.islands)} îles${m.fill != null ? ', remplissage ' + pct(m.fill) : ''}, calcul ${n(m.cook_s, 2)} s${m.bake_s ? ', cuisson ' + n(m.bake_s, 1) + ' s' : ''}.</p>
  <p class="muted">Rapport : <code>${esc(m.report)}</code></p></div></div></section>`;
}
function footer() {
  return `<div class="card"><h2>Relancer</h2><p class="muted">Depuis un terminal, Houdini ouvert :</p>
  <p><code>/Users/zenray/.venvs/shorts/bin/python -I /Users/zenray/.claude/skills/zenray-houdini/scripts/zenray_uv/ZenRayUV.py run --methods ${D.methods.map(m => m.id).join(',')} --asset ${esc(D.asset)} --td ${D.texel_density} --scale ${D.asset_scale}</code></p>
  <p class="muted">Ou dans Houdini, bouton « Run, score and write the sheet » de <code>CTRL_zruv</code> ; chaque réglage y vit, huit au plus par dossier.</p></div>`;
}
document.getElementById('app').innerHTML = D ? header() + summary() + D.methods.map(method).join('') + footer() : '<p>Aucune donnée.</p>';
</script>
</body>
