cut = seq.add_track(unreal.MovieSceneCameraCutTrack); f0 = 0; asp = C['aspect_w'] / C['aspect_h']
def _chs(sec):
    for f in (lambda: sec.get_all_channels(), lambda: sec.get_channels()):
        try: return f()
        except Exception: pass
for s in C['shots']:
    f1 = f0 + s['frames']; p0, p1 = s['start'], s['end']
    cam = eas.spawn_actor_from_class(unreal.CineCameraActor, V(*p0['pos'])); cam.set_actor_label('LB_CINE_' + s['name'])
    cc = cam.get_cine_camera_component(); fb = cc.filmback; fb.sensor_width = C['sensor_width_mm']; fb.sensor_height = C['sensor_width_mm'] / asp; cc.set_editor_property('filmback', fb)
    cc.current_focal_length = float(s['focal_mm']); cc.current_aperture = C['fstop']
    fs = cc.focus_settings; fs.focus_method = unreal.CameraFocusMethod.MANUAL; fs.manual_focus_distance = 1500.0; cc.set_editor_property('focus_settings', fs)
