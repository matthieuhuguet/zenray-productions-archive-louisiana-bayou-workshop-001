    sec = b.add_track(unreal.MovieScene3DTransformTrack).add_section(); sec.set_range(f0, f1); chs = {str(c.channel_name): c for c in _chs(sec)}
    # FR : par défaut deux clés (début, fin) ; une liste optionnelle 'keys' (t de 0 à 1, pos, pitch, yaw déroulé) donne un trajet courbe, par exemple un tour complet.
    kl = [(f0, p0['pos'] + r0), (f1, p1['pos'] + r1)] if 'keys' not in s else [(f0 + int(round(k['t'] * s['frames'])), k['pos'] + [0.0, k['pitch'], k['yaw']]) for k in s['keys']]
    for nm_i, nm in enumerate(['Location.X', 'Location.Y', 'Location.Z', 'Rotation.X', 'Rotation.Y', 'Rotation.Z']):
        for fr, vals in kl: chs[nm].add_key(unreal.FrameNumber(fr), float(vals[nm_i]))
    for nm in ('Scale.X', 'Scale.Y', 'Scale.Z'): chs[nm].set_default(1.0)
    rep[s['name']] = (f0, f1); f0 = f1
eal.save_loaded_asset(seq); unreal.EditorLevelLibrary.save_current_level(); unreal.LevelSequenceEditorBlueprintLibrary.open_level_sequence(seq)
rep['total_frames'] = total; print(json.dumps(rep))
