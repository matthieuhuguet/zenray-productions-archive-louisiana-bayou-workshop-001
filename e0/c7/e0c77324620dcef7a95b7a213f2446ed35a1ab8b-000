# 29 October 2026 (v3) : rebuilds LB_CINE cameras and LS_LouisianaBayouCinematic from the explicit poses of lb_cine_v3_29-October-2026.json and opens the sequence. FR : séquence v3, poses explicites.
import unreal, json
UD = '/Users/zenray/Create/Build/Productions/ZenRayHoudini/LouisianaBayou/unreal'; C = json.load(open(UD + '/lb_cine_v3_29-October-2026.json'))
eal = unreal.EditorAssetLibrary; eas = unreal.get_editor_subsystem(unreal.EditorActorSubsystem); tools = unreal.AssetToolsHelpers.get_asset_tools(); V = unreal.Vector; rep = {}
try: unreal.EditorLevelLibrary.eject_pilot_level_actor()
except Exception: pass
for a in list(eas.get_all_level_actors()):
    if a.get_actor_label().startswith('LB_CINE_'): eas.destroy_actor(a)
SD, SN = '/Game/ZenRayShards/LouisianaBayou/Cinematics', 'LS_LouisianaBayouCinematic'
if eal.does_asset_exist(SD + '/' + SN):
    seq = eal.load_asset(SD + '/' + SN)
    for b in list(unreal.MovieSceneSequenceExtensions.get_bindings(seq)): unreal.MovieSceneBindingExtensions.remove(b)
