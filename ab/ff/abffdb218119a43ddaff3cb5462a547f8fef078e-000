def score(geo, name):
    m = Z.from_geo(geo, (name,), ['zruv_organic'])
    isl, _ = Z.uv_islands(m, name)
    fail = 0.0; zero = 0
    for i in range(int(isl.max()) + 1):
        fs = [int(f) for f in np.where(isl == i)[0]]
        res, r, s, a3 = O._relax(m, fs, {f: m.uv[name][f] for f in fs})
        fail += O._fail_area(r, s, a3, 0.1)
    allv = np.array([q for qs in m.uv[name] for q in qs])
    return {'islands': int(isl.max()) + 1, 'fail_m2': round(fail, 5), 'zero_uv_share': round(float((np.abs(allv).sum(1) == 0).mean()), 4)}


