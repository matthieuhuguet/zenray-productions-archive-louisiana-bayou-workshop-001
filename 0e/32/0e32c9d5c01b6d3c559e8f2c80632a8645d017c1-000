near = [e for e, fs in m.edges.items() if len(fs) == 2 and not (fs[0] in fn or fs[1] in fn) and (e[0] in ring_pts or e[1] in ring_pts)]
q = lambda E: np.percentile([dih.get(e, 0.0) for e in E], [0, 10, 50, 90, 100]).round(1).tolist()
print('nose island', nose, 'faces', len(fn), 'border edges', len(bnd), 'dihedral border p0 p10 p50 p90 p100', q(bnd))
