import ZrMesh as Z


def thickness(m, faces=None, max_rel=0.3):
    """Per face : distance along -normal from its centre to the nearest face whose normal looks the other way (the back of a thin sheet), inf when none."""
    faces = range(m.n) if faces is None else faces
    A, B, C = m.P[m.tri[:, 0]], m.P[m.tri[:, 1]], m.P[m.tri[:, 2]]
    e1, e2 = B - A, C - A
    diag = float(np.linalg.norm(m.P.max(0) - m.P.min(0)))
    out = np.full(m.n, np.inf)
    nt = m.normal[m.tf]
    for f in faces:
        o = m.centroid[f] - 1e-6 * diag * m.normal[f]
        d = -m.normal[f]
        h = np.cross(d, e2)
        a = (e1 * h).sum(1)
        ok = np.abs(a) > 1e-14
        fa = np.where(ok, 1.0 / np.where(ok, a, 1.0), 0.0)
        s = o - A
        u = fa * (s * h).sum(1)
        q = np.cross(s, e1)
        v = fa * (q @ d)
        t = fa * (q * e2).sum(1)
        hit = ok & (u >= 0) & (v >= 0) & (u + v <= 1) & (t > 1e-9 * diag) & (m.tf != f) & ((nt @ m.normal[f]) < -0.3)
        if hit.any():
            out[f] = float(t[hit].min())
    return out


