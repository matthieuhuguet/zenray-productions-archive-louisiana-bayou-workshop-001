    <label><b>Pas de rangée visible (m)</b><input type="number" id="sp_h" step="0.001" value="0.2552"></label>
    <label><b>Marge de sécurité en hauteur (m)</b><input type="number" id="sp_s" step="0.005" value="0.065"></label>
    <label><b>Marge entre emplacements (px)</b><input type="number" id="sp_m" step="1" value="8"></label>
    <button type="button" id="sp_mode" aria-pressed="true">Afficher la texture</button>
    <button type="button" id="sp_seed">Autre tirage</button>
  </div>
  <canvas id="sp_cv" width="900" height="900" role="img" aria-label="Feuille avec ses emplacements de tuiles"></canvas>
  <div class="stats ui" id="sp_out"></div>
  <p class="svgtext2" style="margin:.6rem 0 0">Valeurs de départ : celles de ton toit actuel (0,32 m de large, pas de rangée 0,2552 m, 1 024 px par mètre). Pour l'ancienne tuile de 0,41 m de large, mets 0,41 : tu retrouves 4 colonnes × 6 rangées.</p>
</div>
<script>
(function(){
 var $=function(i){return document.getElementById(i)},cv=$('sp_cv'),ctx=cv.getContext('2d'),img=new Image(),tex=true,seed=1;
 img.src='img/height-tile-A.webp';
 function rnd(a){return function(){a|=0;a=a+0x6D2B79F5|0;var t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
 var COL=['#d97e63','#e9a35c','#c8b25a','#7fb08a','#6fa3bd','#8a86c7','#b57fb6'];
 function go(){
  var S=+$('sp_sheet').value,d=+$('sp_d').value,w=+$('sp_w').value,h=+$('sp_h').value,sf=+$('sp_s').value,m=+$('sp_m').value;
  var pw=Math.round(w*d),ph=Math.round((h+sf)*d),cols=Math.max(0,Math.floor((S-m)/(pw+m))),rows=Math.max(0,Math.floor((S-m)/(ph+m))),slots=cols*rows,R=cv.width/S;
  ctx.clearRect(0,0,cv.width,cv.height);ctx.fillStyle='#faf9f6';ctx.fillRect(0,0,cv.width,cv.height);
  ctx.strokeStyle='#5b5953';ctx.lineWidth=2;ctx.strokeRect(1,1,cv.width-2,cv.height-2);
  var r=rnd(seed*977),mx=(S-cols*pw-(cols+1)*m)/2;
  for(var j=0;j<rows;j++)for(var i=0;i<cols;i++){
   var x=(m+mx+i*(pw+m))*R,y=(m+j*(ph+m))*R,ww=pw*R,hh=ph*R,k=j*cols+i;
   if(tex&&img.complete&&img.naturalWidth){
     var f=Math.floor(r()*4);ctx.save();ctx.translate(x+ww/2,y+hh/2);ctx.scale((f==1||f==3)?-1:1,(f==2||f==3)?-1:1);ctx.drawImage(img,-ww/2,-hh/2,ww,hh);ctx.restore();
   }else{ctx.fillStyle=COL[k%7];ctx.globalAlpha=.85;ctx.fillRect(x,y,ww,hh);ctx.globalAlpha=1;}
   ctx.fillStyle='rgba(255,255,255,.92)';ctx.font=(Math.max(11,ww/5))+'px Inter, sans-serif';ctx.textAlign='center';ctx.fillText(k+1,x+ww/2,y+hh/2+4);
  }
  var use=slots*pw*ph/(S*S);
  $('sp_out').innerHTML=['<span>Emplacement : <b>'+pw+' × '+ph+' px</b></span>','<span>Grille : <b>'+cols+' × '+rows+'</b></span>','<span>Emplacements : <b>'+slots+'</b></span>','<span>Aspects (× 4) : <b>'+slots*4+'</b></span>','<span>Surface utilisée : <b>'+(Math.round(use*100))+' %</b></span>'].join('');
 }
 ['sp_sheet','sp_d','sp_w','sp_h','sp_s','sp_m'].forEach(function(i){$(i).oninput=go});
 $('sp_seed').onclick=function(){seed++;go()};
 $('sp_mode').onclick=function(){tex=!tex;this.setAttribute('aria-pressed',tex);this.textContent=tex?'Afficher la texture':'Afficher les couleurs';go()};
 img.onload=go;go();
})();
</script>
<div class="callout"><div class="t">Ce qu'il faut retenir</div>
Le zoom (1 024 px par mètre) se choisit <b>une fois</b>. La taille d'une tuile en pixels vient de <b>sa taille réelle</b>, jamais de la taille du toit. La taille du toit décide seulement <b>combien</b> de tuiles on pose, donc combien de fois chaque aspect se répète. La feuille, elle, reste de la même taille.</div>

</div></main>
<script>
(function(){
 var $=function(i){return document.getElementById(i)},fmt=function(x,d){return (Math.round(x*Math.pow(10,d))/Math.pow(10,d)).toString().replace('.',',')};
 function go(){
  var w=+$('w').value,h=+$('h').value,d=+$('d').value,a=+$('a').value,s=+$('s').value,m=8;
  var pw=Math.round(w*d),ph=Math.round((h+0.065)*d),cols=Math.floor((s-m)/(pw+m)),rows=Math.floor((s-m)/(ph+m)),slots=cols*rows,looks=slots*4;
  var vis=(w*0.81)*h,tiles=Math.round(a/vis),reps=tiles/Math.max(looks,1),uniq=a*d*d/(s*s);
  $('o').innerHTML=[['Emplacement',pw+' × '+ph+' px'],['Emplacements par feuille',slots+' ('+cols+' × '+rows+')'],['Aspects (× 4)',looks],['Tuiles (estimation)',tiles],['Répétitions par aspect',fmt(reps,0)],['Feuilles en peinture unique',fmt(uniq,1)],['Feuilles avec trim sheet',1]].map(function(p){return '<span>'+p[0]+' : <b>'+p[1]+'</b></span>'}).join('');
 }
 ['w','h','d','a','s'].forEach(function(i){$(i).oninput=go});
 function set(v){$('w').value=v.w;$('h').value=v.h;$('a').value=v.a;go()}
 $('pc').onclick=function(){$('pc').setAttribute('aria-pressed',true);$('pp').setAttribute('aria-pressed',false);set({w:0.32,h:0.2552,a:144.8})};
 $('pp').onclick=function(){$('pp').setAttribute('aria-pressed',true);$('pc').setAttribute('aria-pressed',false);set({w:0.18,h:0.213,a:7.0})};
 go();
})();
</script>
