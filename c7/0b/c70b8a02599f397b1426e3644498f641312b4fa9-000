.ui{font-family:var(--zr-police-sans);font-weight:var(--zr-poids-sans)}
header.hero{padding:4rem 0 2rem;border-bottom:1px solid var(--line)}
.kicker{font-family:var(--zr-police-sans);font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;color:var(--acc);margin-bottom:1rem}
