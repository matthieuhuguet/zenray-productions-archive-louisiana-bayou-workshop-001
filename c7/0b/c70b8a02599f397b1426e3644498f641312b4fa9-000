:root[data-theme="dark"]{--bg:#171614;--bg2:#1f1d1b;--card:#242220;--ink:#efece6;--ink2:#aaa69d;--line:#3a3733;--acc:#d98d70;--acc2:#5b3d31;--ok:#8fb598;--warn:#d4a35e}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
