.callout.warn{border-color:var(--warn)}
.callout .t{font-family:var(--zr-police-sans);font-size:.78rem;letter-spacing:.1em;text-transform:uppercase;color:var(--acc);margin-bottom:.2rem}
.callout.warn .t{color:var(--warn)}
figure{margin:1.8rem 0}
figure svg{overflow:hidden}
figure img,figure svg{width:100%;height:auto;display:block;border-radius:var(--r);border:1px solid var(--line);background:var(--card)}
figcaption{font-family:var(--zr-police-sans);font-size:.88rem;color:var(--ink2);margin-top:.5rem;line-height:1.5}
.pair{display:grid;grid-template-columns:1fr 1fr;gap:var(--gap)}
@media(max-width:760px){.pair{grid-template-columns:1fr}nav.toc ol{columns:1}}
table{display:block;overflow-x:auto;max-width:100%;border-collapse:collapse;font-family:var(--zr-police-sans);font-size:.95rem;margin:1.2rem 0}
th,td{text-align:left;padding:.55rem .7rem;border-bottom:1px solid var(--line);vertical-align:top}
th{font-weight:500;color:var(--ink2);font-size:.82rem;letter-spacing:.06em;text-transform:uppercase}
td.n,td .n{font-family:var(--zr-police-serif);font-weight:var(--zr-poids-nombres);font-size:1.05rem}
.formula{font-family:var(--zr-police-mono);font-size:.95rem;background:var(--bg2);border:1px solid var(--line);border-radius:var(--r);padding:.9rem 1.1rem;overflow-x:auto;white-space:pre;margin:1.1rem 0;line-height:1.6}
.demo{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:1rem 1.2rem;margin:1.6rem 0}
.demo .ctl{display:flex;flex-wrap:wrap;gap:.9rem 1.4rem;align-items:center;font-family:var(--zr-police-sans);font-size:.92rem;margin-bottom:.8rem}
.demo label{display:flex;flex-direction:column;gap:.15rem;min-width:9rem}
.demo label b{font-weight:400;color:var(--ink2);font-size:.8rem}
.demo output{font-family:var(--zr-police-serif);font-size:1.15rem}
.demo canvas{width:100%;height:auto;border-radius:10px;border:1px solid var(--line);display:block;background:var(--bg2)}
button,.btn{font-family:var(--zr-police-sans);font-weight:400;font-size:.9rem;background:var(--bg2);color:var(--ink);border:1px solid var(--line);border-radius:999px;padding:.45rem 1rem;cursor:pointer}
button:hover{border-color:var(--acc)}button[aria-pressed="true"]{background:var(--acc);color:#fff;border-color:var(--acc)}
input[type=range]{accent-color:var(--acc);width:100%}
.stats{display:flex;flex-wrap:wrap;gap:.6rem 1.6rem;font-family:var(--zr-police-sans);font-size:.9rem;color:var(--ink2);margin-top:.7rem}
.stats b{font-family:var(--zr-police-serif);font-weight:var(--zr-poids-nombres);color:var(--ink);font-size:1.15rem}
details{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:.7rem 1.1rem;margin:.8rem 0}
summary{cursor:pointer;font-family:var(--zr-police-sans);font-size:.98rem}
dl{margin:1rem 0}dt{font-weight:500;margin-top:.9rem}dd{margin:.1rem 0 0;color:var(--ink2)}
footer{overflow-wrap:anywhere;border-top:1px solid var(--line);margin:4rem 0 3rem;padding-top:1.4rem;color:var(--ink2);font-family:var(--zr-police-sans);font-size:.88rem}
.svgtext{font-family:var(--zr-police-sans);font-size:13px;fill:var(--ink)}
.svgtext2{font-family:var(--zr-police-sans);font-size:12px;fill:var(--ink2)}
.svgnum{font-family:var(--zr-police-serif);font-size:15px;fill:var(--ink);font-weight:400}
