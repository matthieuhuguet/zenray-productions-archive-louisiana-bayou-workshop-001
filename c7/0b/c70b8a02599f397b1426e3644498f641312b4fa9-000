.step{display:inline-flex;align-items:center;justify-content:center;width:2.1rem;height:2.1rem;border-radius:50%;background:var(--acc);color:#fff;font-family:var(--zr-police-sans);font-size:.95rem;margin-right:.6rem;vertical-align:.1em}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:1.1rem 1.3rem;margin:1.4rem 0}
