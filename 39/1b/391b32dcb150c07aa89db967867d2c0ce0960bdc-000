def solve(data, log=None):
    """20 October 2026 : the whole tailor on plain data, with no Houdini : data = {P, polys, face_open, organic (0/1 per face), sharp (edge pairs), crease_rad, prm}.
    Returns {uv: {"f_j": [u, v]}, chart: [id per face], seams: [[a, b]], demoted: [[a, b]], required: n, report: {...}}."""
    import time as _time
    t0 = _time.time()
    prm = data.get('prm') or {}
    S = Surf(data['P'], data['polys'], face_open=data.get('face_open'), prm=prm)
    flag = np.asarray(data['organic'], dtype=np.int64) == 1
    sharp = [S.emap[(min(a, b), max(a, b))] for a, b in data.get('sharp', []) if (min(a, b), max(a, b)) in S.emap]
    req, dem = required_seams(S, sharp, flag, float(data.get('crease_rad', math.radians(30.0))))
    tl = Tailor(S, must_cut=req, faces=np.where(flag)[0], log=log)
    tl.cut_necks()
    tl.flatten_all()
    tl.improve()
    tl.economy_all()
    rep = tl.report()
    uv, chart = {}, [-1] * S.nf
    for kk, (k, ch) in enumerate(sorted(tl.charts.items())):
        if ch is None or not ch.ok:
            continue
        for (f, j), lv in ch.loc.corner.items():
            uv['%d_%d' % (f, j)] = [float(ch.uv[lv, 0]), float(ch.uv[lv, 1])]
        for f in ch.loc.faces:
            chart[f] = kk
    inner = np.where(tl.cut & (S.EF1 >= 0) & flag[S.EF0] & flag[np.maximum(S.EF1, 0)])[0]
    rep.update({'method': 'tailor', 'required_hard_edges': len(req), 'demoted_hard_edges': len(dem), 'demoted_m': round(float(S.EL[dem].sum()), 3) if dem else 0.0,
                'params': {k: S.prm.get(k) for k in ('p95', 'p50', 'back_weight', 'vis_power', 'open_power', 'eps', 'gain_power', 'symmetry', 'front')},
                'seconds': round(_time.time() - t0, 1)})
    return {'uv': uv, 'chart': chart, 'seams': [[int(a), int(b)] for a, b in S.E[inner]], 'demoted': [[int(a), int(b)] for a, b in S.E[dem]],
            'report': rep}


