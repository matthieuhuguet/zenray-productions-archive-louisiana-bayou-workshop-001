CTRL_MAP = (('p95', 'tailor_p95'), ('p50', 'tailor_p50'), ('back_weight', 'tailor_back_weight'), ('vis_power', 'tailor_vis_power'),
            ('gain_power', 'tailor_gain_power'), ('concave_bonus', 'tailor_concave'))


def params_from_ctrl(c):
    """The tailor parameters read from CTRL_zruv (the HDA interface) over the defaults of PARAMS."""
    prm = {}
    for key, pn in CTRL_MAP:
        if c.parm(pn) is not None:
            prm[key] = float(c.evalParm(pn))
    if c.parm('tailor_symmetry') is not None:
        prm['symmetry'] = bool(c.evalParm('tailor_symmetry'))
    if c.parm('tailor_front') is not None:
        try:
            prm['front'] = tuple(float(x) for x in c.evalParm('tailor_front').split()[:3])
        except ValueError:
            pass
    prm['td'] = float(c.evalParm('texel_density'))
    return prm


def required_seams(S, sharp, active, crease_rad):
    """20 October 2026 : the hard edges an organic surface must keep as seams : geometrically sharp (dihedral over the crease) and closing a loop (they bound a part :
    a sole, a window rim). A split normal on a smooth surface (the trace of an old uv layout : Manny's, 88 fragments of Epic's seams) and a dangling design groove are
    demoted : the new hard edges follow the new seams. Returns (required edge ids, demoted edge ids)."""
    act = active[S.EF0] & ((S.EF1 < 0) | active[np.maximum(S.EF1, 0)])
    cand = [e for e in sharp if act[e]]
    keep = [e for e in cand if abs(S.dih[e]) >= crease_rad]
    par = {}

    def find(x):
        while par.setdefault(x, x) != x:
            par[x] = par[par[x]]
            x = par[x]
        return x
    for e in keep:
        par[find(int(S.E[e, 0]))] = find(int(S.E[e, 1]))
    nv, ne = {}, {}
    for e in keep:
        r = find(int(S.E[e, 0]))
        ne[r] = ne.get(r, 0) + 1
    for v in list(par):
        r = find(v)
        nv[r] = nv.get(r, 0) + 1
    req = [e for e in keep if ne[find(int(S.E[e, 0]))] >= nv[find(int(S.E[e, 0]))]]
    rs = set(req)
    return req, [e for e in cand if e not in rs]


