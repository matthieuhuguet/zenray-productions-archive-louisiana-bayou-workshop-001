void make_symmetric_prism_z(vector pts[]; float z_start, z_end; string grp_name; int pid) {
    int p_l[];
    resize(p_l, 8);
    for (int i = 0; i < 4; ++i) {
        p_l[i]   = addpoint(0, set(pts[i].x, pts[i].y, z_start));
        p_l[i+4] = addpoint(0, set(pts[i].x, pts[i].y, z_end));
    }
    
    // Left side faces (strictly outward normals)
    int pr0 = addprim(0, "poly", p_l[0], p_l[4], p_l[5], p_l[1]); // Top (+Y outward)
    int pr1 = addprim(0, "poly", p_l[1], p_l[5], p_l[6], p_l[2]); // Eave cut
    int pr2 = addprim(0, "poly", p_l[2], p_l[6], p_l[7], p_l[3]); // Bottom (-Y ceiling outward)
    int pr3 = addprim(0, "poly", p_l[3], p_l[7], p_l[4], p_l[0]); // Peak cut
    int pr4 = addprim(0, "poly", p_l[0], p_l[1], p_l[2], p_l[3]); // -Z end cap
    int pr5 = addprim(0, "poly", p_l[4], p_l[7], p_l[6], p_l[5]); // +Z end cap
    
    int prims_l[] = array(pr0, pr1, pr2, pr3, pr4, pr5);
    foreach (int pr; prims_l) {
        setprimgroup(0, grp_name, pr, 1);
        setprimattrib(0, "piece_id", pr, pid);
    }
    
    // Right side (mirrored across X=0 with reversed winding)
    int p_r[];
    resize(p_r, 8);
    for (int i = 0; i < 4; ++i) {
        p_r[i]   = addpoint(0, set(-pts[i].x, pts[i].y, z_start));
        p_r[i+4] = addpoint(0, set(-pts[i].x, pts[i].y, z_end));
    }
    
    int r0 = addprim(0, "poly", p_r[1], p_r[5], p_r[4], p_r[0]); // Top (+Y outward)
    int r1 = addprim(0, "poly", p_r[2], p_r[6], p_r[5], p_r[1]); // Eave cut
    int r2 = addprim(0, "poly", p_r[3], p_r[7], p_r[6], p_r[2]); // Bottom (-Y ceiling outward)
    int r3 = addprim(0, "poly", p_r[0], p_r[4], p_r[7], p_r[3]); // Peak cut
    int r4 = addprim(0, "poly", p_r[3], p_r[2], p_r[1], p_r[0]); // -Z end cap
    int r5 = addprim(0, "poly", p_r[5], p_r[6], p_r[7], p_r[4]); // +Z end cap
    
    int prims_r[] = array(r0, r1, r2, r3, r4, r5);
    foreach (int pr; prims_r) {
        setprimgroup(0, grp_name, pr, 1);
        setprimattrib(0, "piece_id", pr, pid + 10000);
    }
}
