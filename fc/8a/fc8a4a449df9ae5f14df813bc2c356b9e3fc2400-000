#### cut_ridge
// 9 October 2026 : ridge cut. EN: each slope's shingles are cut flush by the TOP surface of the opposite slope, so the two slopes meet in a clean mitre with the real shingle thickness left visible (replaces the inverted-gutter ridge cap). FR : coupe au faitage par le plan de la pente opposée, l'épaisseur reste visible.
float wh = ch("../wall_height");
float gh = ch("../gable_height");
float peak_y = wh + gh;
float half_w = ch("../width") * 0.5 + ch("../eave_overhang");
float p = atan2(gh, half_w);
float off = 0.03;                                       // height of the shingle top above the deck at the ridge
vector Q = set(0.0, peak_y + off, 0.0);
vector n_r = set(sin(p), cos(p), 0.0);                  // outward normal of the RIGHT slope
vector dir = set(cos(p), sin(p), 0.0);                  // up-slope direction of the LEFT slope
int mirror = (prim(0, "piece_id", @primnum) >= 10000);
foreach (int vtx; primvertices(0, @primnum)) {
    int pt = vertexpoint(0, vtx);
    vector pos = point(0, "P", pt);
    if (mirror) pos.x = -pos.x;
    float d = dot(pos - Q, n_r);
    if (d > 0.0) pos -= dir * (d / dot(n_r, dir));
    if (mirror) pos.x = -pos.x;
    setpointattrib(0, "P", pt, pos);
}
