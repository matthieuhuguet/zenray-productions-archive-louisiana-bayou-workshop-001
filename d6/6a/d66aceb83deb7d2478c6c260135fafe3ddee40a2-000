def flatten(faces, method):
    gg = hou.Geometry()
    pts = sorted(set(p for f in faces for p in m.polys[f])); idx = {p: i for i, p in enumerate(pts)}
    gg.createPoints([tuple(float(x) for x in m.P[p]) for p in pts])
    gg.addAttrib(hou.attribType.Prim, 'zruv_src', -1); gg.addAttrib(hou.attribType.Vertex, 'uv', (0.0, 0.0, 0.0))
    for pr, f in zip(gg.createPolygons([tuple(idx[p] for p in m.polys[f]) for f in faces]), faces):
        pr.setAttribValue('zruv_src', int(f))
    vb = hou.sopNodeTypeCategory().nodeVerb('uvflatten::3.0')
    vb.setParms({'method': method, 'uvattrib': 'uv', 'seamgroup': '', 'rectifygroup': ''})
    out = hou.Geometry(); vb.execute(out, [gg])
    return {pr.attribValue('zruv_src'): [tuple(vt.attribValue('uv')[:2]) for vt in pr.vertices()] for pr in out.prims()}

def folds(faces, uvd):
    sa = []
    for f in faces:
        q = np.array(uvd[f])
        for k in range(1, len(q) - 1):
            a, b, c = q[0], q[k], q[k + 1]
            sa.append((b[0] - a[0]) * (c[1] - a[1]) - (c[0] - a[0]) * (b[1] - a[1]))
    sa = np.array(sa)
    return int(min((sa > 0).sum(), (sa < 0).sum()))

