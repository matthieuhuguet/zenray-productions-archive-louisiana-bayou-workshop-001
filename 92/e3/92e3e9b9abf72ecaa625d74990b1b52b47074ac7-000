# 20 October 2026 : the artist's clicks. An artist cuts in Maya with two selection tools : double click an edge and the whole edge LOOP is taken (it goes
# straight through every point with four edges), or click two points and the SHORTEST EDGE PATH between them is taken. This script finds, for every seam
# segment of an artist's uv, the fewest clicked points (anchors) such that loops and shortest paths between consecutive anchors give back exactly the
# artist's edges, and replays the clicks to prove it. Usage : python -I PathFit.py <asset>  ->  runs/reference/study/<asset>/clicks.json
# FR : les clics de l'artiste, la plus petite suite de boucles et de plus courts chemins qui redonne exactement sa decoupe.
import sys, os, json, heapq
import numpy as np
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
