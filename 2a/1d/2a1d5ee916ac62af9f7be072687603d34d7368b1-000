    <g transform="translate(95,80)"><text y="22" style="fill:#fff">F</text></g>
    <g transform="translate(265,80) scale(-1,1)"><text y="22" style="fill:#fff">F</text></g>
    <g transform="translate(435,80) scale(1,-1)"><text y="22" style="fill:#fff">F</text></g>
    <g transform="translate(605,80) rotate(180)"><text y="22" style="fill:#fff">F</text></g>
  </g>
  <text class="svgtext2" x="95" y="152" text-anchor="middle">normale</text>
