# 19 October 2026 15:20 : the lesson quotes numbers in its text ; this script recomputes each one from its definition and checks that the text says exactly that. Exit code 0 = every number agrees.
# FR : recalcule chaque nombre cite dans la lecon et verifie que le texte dit la meme chose.
import math, re, sys, html
LESSON = sys.argv[1] if len(sys.argv) > 1 else 'index.html'
text = html.unescape(re.sub(r'<[^>]+>', ' ', open(LESSON, encoding='utf-8').read()))
text = re.sub(r'\s+', ' ', text)
fr = lambda x, d=0: f"{x:,.{d}f}".replace(',', ' ').replace('.', ',')   # 1 024 ; 21,3
mib = lambda px, bpp: px * px * bpp * 4 / 3 / 2**20
screen = lambda W, d, fov=90: W / (2 * d * math.tan(math.radians(fov / 2)))
side = lambda S, td, fill=0.7: math.sqrt(S * td * td / fill)
p2 = lambda x: 2 ** math.ceil(math.log2(x))
checks = [
    ('texels of a 1 024 texture', fr(1024 * 1024), '1 048 576'),
    ('wall 2 m, 2 048 px island', fr(2048 / 2), '2 048 ÷ 2 = 1 024 px/m'),
    ('same image on a 2 m crate', fr(1024 / 2), 'tombe à 512 px/m'),
    ('screen px per metre at 1 m', fr(screen(1920, 1)), 'reçoit 960 pixels'),
    ('screen px per metre at 2 m', fr(screen(1920, 2)), "plus que 480"),
    ('4096 BC7 without mips (MiB)', fr(4096 * 4096 / 2**20), '16 Mio'),
    ('4096 BC7 with mips (MiB)', fr(mib(4096, 1), 1), '21,3 Mio'),
    ('material of 3 maps at 4096 (MiB)', fr(3 * mib(4096, 1)), 'soit 64 Mio'),
    ('arch unique side at 1 024', fr(side(19.34, 1024)), '5 382 px'),
    ('arch unique image', fr(p2(side(19.34, 1024))), 'image de 8 192'),
    ('arch three maps (MiB)', fr(3 * mib(p2(side(19.34, 1024)), 1)), '256 Mio'),
    ('roof unique side at 1 024', fr(side(144.8, 1024)), '14 728 px'),
    ('planks band height at 1 024 (cm)', fr(512 / 1024 * 100), 'couvre 50 cm'),
]
bad = 0
for name, value, phrase in checks:
    ok_value = value in phrase.replace(' ', ' ')
    ok_text = phrase in text
    print(('PASS ' if ok_value and ok_text else 'FAIL ') + f'{name} : computed {value} ; text "{phrase}" {"found" if ok_text else "MISSING"}')
    bad += not (ok_value and ok_text)
print('ALL PASS' if not bad else f'{bad} FAIL')
sys.exit(1 if bad else 0)
