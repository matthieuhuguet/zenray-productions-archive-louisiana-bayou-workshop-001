#!/bin/zsh
# 20 October 2026 (fifth pass) : the whole bench, the arch first (fast, it shows the twin, trim and decal fixes first), then the ball, the toy and Manny (their
# tailor solves run in 16 processes). One asset per bridge call, its own log ; a summary line per asset in RunBench.sum.
W=/Users/zenray/.claude/tmp/tmp-houdini-september-2026/tmp-bayou-louisiana/03_work/uv/ZenRayUV_5Methods_19-October-2026
B="/opt/homebrew/bin/python3 /Users/zenray/.claude/Memory1/Houdini/MCP/zrhoudini.py hom"
: > $W/Scripts/RunBench.sum
ZR_BRIDGE_TIMEOUT=1800 $=B "import sys; sys.path.insert(0, '/Users/zenray/.claude/skills/zenray-houdini/scripts/zenray_uv'); import importlib, TestBench; importlib.reload(TestBench); result = TestBench.setup('$W/runs')" > $W/Scripts/RunBench_setup.out 2>&1
echo "setup $(date +%H:%M:%S)" >> $W/Scripts/RunBench.sum
for spec in "ZRUV_Arch:M1,M2,M3,M3B,M3C,M4,M5" "ZRUV_ArchLibrary:M3B" "ZRUV_ShaderBall:M1,M2,M3,M3B,M3C,M4,M5" "ZRUV_RubberToy:M1,M2,M3,M3B,M3C,M4,M5" "ZRUV_Manny:M1,M2,M3,M3B,M3C,M4,M5"; do
  obj=${spec%%:*}; meths=${spec#*:}; py_meths="('${meths//,/','}',)"
  ZR_BRIDGE_TIMEOUT=5400 $=B "OBJS=('$obj',); METHS=$py_meths; BAKE=True; RUNS='$W/runs'; exec(open('$W/Scripts/RunSheets.py').read())" > $W/Scripts/RunBench_$obj.out 2>&1
  /opt/homebrew/bin/python3 -c "
import json, sys
try:
    r = json.load(open('$W/Scripts/RunBench_$obj.out'))['result']['$obj']
    print('$obj', r['s'], {k: (v['score'], v['weakest'], (v['errors'] or [''])[0][:160] if v['errors'] else '') for k, v in r['res'].items()})
except Exception as e:
    print('$obj', 'unreadable', e, open('$W/Scripts/RunBench_$obj.out').read()[-600:])
" >> $W/Scripts/RunBench.sum
  echo "$obj done $(date +%H:%M:%S)" >> $W/Scripts/RunBench.sum
done
echo "all done $(date +%H:%M:%S)" >> $W/Scripts/RunBench.sum
