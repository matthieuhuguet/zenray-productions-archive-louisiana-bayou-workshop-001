    float gh = gables_h[g];
    float z = gables_z[g];
    float timber_drop = half * sqrt(1.0 + pow(2.0 * gh / w, 2.0)) + 0.005;
    float peak_y = wh + gh - timber_drop;
    float peak_eff = peak_y + zr_dy(cva, 0.0, z);   // apex of the curved rafter
