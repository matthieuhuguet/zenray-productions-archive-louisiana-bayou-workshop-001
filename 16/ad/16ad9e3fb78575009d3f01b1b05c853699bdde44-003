snippet	[ 0	locks=0 ]	(	"
int pt = vertexpoint(0, @vtxnum);
vector p = point(0, \"P\", pt);
int pr = vertexprim(0, @vtxnum);
int pid = prim(0, \"piece_id\", pr);

float density = chf(\"../../texel_density\");
if (density <= 0.0) density = 2.0;

float W = ch(\"../porch_width\");
float hw = W * 0.5;
float y0 = ch(\"../landing_y\");
float wh = ch(\"../wall_height\");
float gh = ch(\"../gable_height\");
float ye = y0 + wh;
float yp = ye + gh;

float overhang_eave = 0.11;
float hw_eave = hw + overhang_eave;
float r_zb = 2.92;
float r_zf = ch(\"../z_front\") + 0.12;

float pitch_ang = atan2(gh, hw_eave);
float cos_p = cos(pitch_ang);
float sin_p = sin(pitch_ang);

vector T_l = set( cos_p, sin_p, 0.0);
vector T_r = set(-cos_p, sin_p, 0.0);
vector eave_l = set(-hw_eave, ye, 0.0);
vector eave_r = set( hw_eave, ye, 0.0);

vector T = (p.x < 0.0) ? T_l : T_r;
vector eave_ref = (p.x < 0.0) ? eave_l : eave_r;

float z_norm = p.z - r_zb;
float dist_slope = dot(p - eave_ref, T);

int is_checker = chi(\"../../debug_uv_01\") || chi(\"../../debug_uv_02\") || chi(\"../../debug_uv_all\") || chi(\"../../debug_uv_checker\");

// CRUCIAL TECH ART FIX : row_id calcule au centre de la PRIMITIVE (et non par vertex) !
// Cela evite le cisaillement diagonal de la texture sur les planches 3D !
vector pr_center = 0;
int nv = primvertexcount(0, pr);
for (int i = 0; i < nv; ++i) {
    pr_center += point(0, \"P\", vertexpoint(0, primvertex(0, pr, i)));
}
if (nv > 0) pr_center /= float(nv);

int row_id = int(floor(pr_center.y * 10.0 + 0.5));
float u_offset = is_checker ? 0.0 : rand(float(row_id) * 97.0 + 17.0) * 5.0;

vector n = normalize(prim_normal(0, pr, 0.5, 0.5));
vector2 uv_val = set(0.0, 0.0);

if (inprimgroup(0, \"group_siding_left\", pr) || inprimgroup(0, \"group_siding_right\", pr) || inprimgroup(0, \"group_siding_front\", pr)) {
    // Si la face est orientee X (cote)
    if (abs(n.x) > 0.5) {
        float dir = (n.x > 0.0) ? -1.0 : 1.0;
        float u = (p.z - ch(\"../z_back\")) * dir + u_offset;
        uv_val = set(u * density, p.y * density);
    }
    // Si la face est orientee Z (facade avant ou bout de latte)
    else if (abs(n.z) > 0.5) {
        float dir = (n.z > 0.0) ? 1.0 : -1.0;
        float u = (p.x + hw) * dir + u_offset;
        uv_val = set(u * density, p.y * density);
    }
    // Si la face est orientee Y (biseau dessus/dessous)
    else {
        float u = (p.z - ch(\"../z_back\")) + u_offset;
        uv_val = set(u * density, p.x * density);
    }
}
else if (inprimgroup(0, \"group_shingles\", pr)) {
    uv_val = set(dist_slope * density, z_norm * density);
}
else if (inprimgroup(0, \"group_ridge_cap\", pr)) {
    uv_val = set(z_norm * density, p.x * density);
}
else if (inprimgroup(0, \"group_roof_deck\", pr)) {
    uv_val = set(z_norm * density, dist_slope * density);
}
else if (inprimgroup(0, \"group_floor\", pr)) {
    uv_val = set((p.z - ch(\"../z_back\")) * density, (p.x + hw) * density);
}
else if (inprimgroup(0, \"group_trim\", pr)) {
    if (abs(n.x) > 0.6) {
        uv_val = set((p.z - ch(\"../z_back\")) * density, p.y * density);
    } else if (abs(n.y) > 0.6) {
        uv_val = set((p.x + hw) * density, (p.z - ch(\"../z_back\")) * density);
    } else {
        uv_val = set((p.x + hw) * density, p.y * density);
    }
}
else if (inprimgroup(0, \"group_glass\", pr)) {
    uv_val = set((p.x + hw) * density, p.y * density);
}
else {
    if (abs(n.x) > 0.6) {
        uv_val = set((p.z - ch(\"../z_back\")) * density, p.y * density);
    } else if (abs(n.y) > 0.6) {
        uv_val = set((p.x + hw) * density, (p.z - ch(\"../z_back\")) * density);
    } else {
        uv_val = set((p.x + hw) * density, p.y * density);
    }
}

@uv = set(uv_val.x, uv_val.y, 0.0);
"	)
