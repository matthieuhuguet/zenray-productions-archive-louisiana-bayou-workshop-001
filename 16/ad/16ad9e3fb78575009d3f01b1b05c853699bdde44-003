python	[ 0	locks=0 ]	(	"# four rivet backbones along z, standing on the recessed floor of the sign. The point attribute scale = (radius, radius, 1) sizes the circle section : the base at the floor, the top tapered.
# The top rivets are placed so that their base stays clear of the inner outline of the frame (the old model let them cut into the frame wall).
import hou
c = hou.pwd().parent().node('CTRL_sign')
ev = c.evalParm
src = hou.pwd().inputs()[0].geometry()
H, yb, e = ev('sign_half'), ev('sign_bottom'), ev('sign_e')
r, h, rin, clear, taper = ev('rivet_r'), ev('rivet_h'), ev('rivet_in'), ev('rivet_clear'), ev('rivet_taper')
zr = 0.5 * e - ev('sign_recess')
floor = None
for pr in src.prims():
    zs = [v.point().position()[2] for v in pr.vertices()]
    if abs(min(zs) - zr) < 1e-5 and abs(max(zs) - zr) < 1e-5 and pr.normal()[2] > 0.99:
        floor = [(v.point().position()[0], v.point().position()[1]) for v in pr.vertices()]
assert floor, 'recessed floor of the sign not found'


def top_y(x):
    ys = []
    for i in range(len(floor)):
        (x0, y0), (x1, y1) = floor[i], floor[(i + 1) % len(floor)]
        if (x0 - x) * (x1 - x) <= 0 and x0 != x1:
            ys.append(y0 + (y1 - y0) * (x - x0) / (x1 - x0))
    return max(ys)


geo = hou.pwd().geometry()
geo.clear()
if geo.findPointAttrib('scale') is None:
    geo.addAttrib(hou.attribType.Point, 'scale', (1.0, 1.0, 1.0))
for sx in (-1, 1):
    x = sx * (H - rin)
    for y in (yb + rin, top_y(x) - r - clear):
