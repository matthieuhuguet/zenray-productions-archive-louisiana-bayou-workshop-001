version 0.8
python	[ 0	locks=0 ]	(	"# edge group arm_edges : the horizontal edges (top and bottom) of the two arms that are not on the mast side plane, they carry the chamfer of the old arm
import hou
c = hou.pwd().parent().node('CTRL_cross')
y0, y1, hw = c.evalParm('arm_y0'), c.evalParm('arm_y1'), c.evalParm('mast_w') * 0.5
geo = hou.pwd().geometry()
grp = geo.createEdgeGroup('arm_edges')
tol = 1e-4
for pr in geo.prims():
    for e in pr.edges():
        a, b = [p.position() for p in e.points()]
        if abs(a[1] - b[1]) > tol:
            continue
        if not (abs(a[1] - y0) < tol or abs(a[1] - y1) < tol):
            continue
        if abs(abs(a[0]) - hw) < tol and abs(abs(b[0]) - hw) < tol:
            continue
        if max(abs(a[0]), abs(b[0])) > hw + tol:
            grp.add(e)
"	)
maintainstate	[ 0	locks=0 ]	(	"off"	)
}
