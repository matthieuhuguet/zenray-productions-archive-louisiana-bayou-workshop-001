    resize(p, 4);
    p[0] = addpoint(geo, set(x0_bot, y_bot, z_out));
    p[1] = addpoint(geo, set(x1_bot, y_bot, z_out));
    p[2] = addpoint(geo, set(x1_top, y_top, z_in));
    p[3] = addpoint(geo, set(x0_top, y_top, z_in));
    
