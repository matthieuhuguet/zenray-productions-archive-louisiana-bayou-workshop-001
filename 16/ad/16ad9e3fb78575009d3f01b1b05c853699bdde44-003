addvertex(0, prim_c_bar, add_pt(0, set(-crossbar_half_w, crossbar_y, zc), SC_POST));
addvertex(0, prim_c_bar, add_pt(0, set( crossbar_half_w, crossbar_y, zc), SC_POST));
