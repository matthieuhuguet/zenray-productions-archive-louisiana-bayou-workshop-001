import hou
c = hou.pwd().parent().node('CTRL_arch')
T, W, B = c.evalParm('arch_t'), c.evalParm('arch_w'), c.evalParm('arch_bevel')
h, d = T * 0.5, W * 0.5
pts = [(-h + B, -d), (h - B, -d), (h, -d + B), (h, d - B), (h - B, d), (-h + B, d), (-h, d - B), (-h, -d + B)]
geo = hou.pwd().geometry()
ps = [geo.createPoint() for _ in pts]
for p, q in zip(ps, pts):
    p.setPosition(hou.Vector3(q[0], q[1], 0.0))
poly = geo.createPolygon()
for p in ps:
    poly.addVertex(p)
"	)
