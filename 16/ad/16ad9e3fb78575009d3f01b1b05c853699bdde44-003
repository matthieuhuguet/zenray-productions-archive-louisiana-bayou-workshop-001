// Solid 3D lap plank for side walls (both outward and inward faces)
void add_lap_plank_side(int geo; float x_wall; float y_bot, y_top; float z0, z1; float th; int side; string grp; int piece) {
    float x_in = x_wall;
    float x_out = x_wall + th * float(side);
    
    int p[];
    resize(p, 4);
    p[0] = addpoint(geo, set(x_out, y_bot, z0));
    p[1] = addpoint(geo, set(x_out, y_bot, z1));
    p[2] = addpoint(geo, set(x_in,  y_top, z1));
    p[3] = addpoint(geo, set(x_in,  y_top, z0));
    
    int p_bot[];
    resize(p_bot, 2);
    p_bot[0] = addpoint(geo, set(x_in,  y_bot, z0));
    p_bot[1] = addpoint(geo, set(x_in,  y_bot, z1));
    
    int pr_out, pr_in, pr_bot, pr_z0, pr_z1;
    if (side == -1) {
        // Left wall: outward normal is -X, inward normal is +X
        pr_out = addprim(geo, \"poly\", p[3], p[2], p[1], p[0]);
        pr_in  = addprim(geo, \"poly\", p_bot[0], p_bot[1], p[2], p[3]);
        pr_bot = addprim(geo, \"poly\", p_bot[1], p_bot[0], p[0], p[1]);
        pr_z0  = addprim(geo, \"poly\", p_bot[0], p[3], p[0]);
        pr_z1  = addprim(geo, \"poly\", p_bot[1], p[1], p[2]);
    } else {
        // Right wall: outward normal is +X, inward normal is -X
        pr_out = addprim(geo, \"poly\", p[0], p[1], p[2], p[3]);
        pr_in  = addprim(geo, \"poly\", p[3], p[2], p_bot[1], p_bot[0]);
        pr_bot = addprim(geo, \"poly\", p_bot[0], p_bot[1], p[1], p[0]);
        pr_z0  = addprim(geo, \"poly\", p_bot[0], p[0], p[3]);
        pr_z1  = addprim(geo, \"poly\", p_bot[1], p[2], p[1]);
    }
    
    int prims[] = array(pr_out, pr_in, pr_bot, pr_z0, pr_z1);
    string sgrp = (side == -1) ? \"group_siding_left\" : \"group_siding_right\";
    foreach (int pr; prims) {
        setprimgroup(geo, grp, pr, 1);
        setprimgroup(geo, sgrp, pr, 1);
        setprimattrib(geo, \"piece_id\", pr, piece);
    }
}

// Solid 3D lap plank for front wall (both outward and inward faces)
void add_lap_plank_front(int geo; float x0, x1; float y_bot, y_top; float z_wall; float th; string grp; int piece) {
    float z_in = z_wall;
