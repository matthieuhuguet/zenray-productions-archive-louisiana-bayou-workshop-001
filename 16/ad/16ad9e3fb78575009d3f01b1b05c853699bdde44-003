python	[ 0	locks=0 ]	(	"# Sign outline : the dense NURBS top is reduced to the fewest vertices that stay within curve_tol of it (Douglas Peucker on the right half, then mirrored so that the outline is exactly symmetric), closed by the straight sides and the bottom.
# The polygon runs clockwise seen from +z, which is the front facing order of Houdini, so that its normal is +z.
import hou
import numpy as np
c = hou.pwd().parent().node('CTRL_sign')
ev = c.evalParm
src = hou.pwd().inputs()[0].geometry()
P = np.array([p.position() for p in src.points()])[:, :2]
H, yb, tol = ev('sign_half'), ev('sign_bottom'), ev('curve_tol')
i = int(np.searchsorted(P[:, 0], 0.0))
a, b = P[i - 1], P[i]
axis_pt = a + (b - a) * ((0.0 - a[0]) / (b[0] - a[0]))
right = np.vstack([axis_pt, P[i:]])
keep = np.zeros(len(right), bool)
keep[0] = keep[-1] = True
stack = [(0, len(right) - 1)]
while stack:
    lo, hi = stack.pop()
    if hi <= lo + 1:
        continue
    p, q = right[lo], right[hi]
    d = q - p
    L = float(np.hypot(d[0], d[1]))
    seg = right[lo + 1:hi] - p
    dist = np.abs(d[0] * seg[:, 1] - d[1] * seg[:, 0]) / L
    k = int(np.argmax(dist))
    if dist[k] > tol:
        keep[lo + 1 + k] = True
        stack.append((lo, lo + 1 + k))
        stack.append((lo + 1 + k, hi))
V = right[keep].copy()
V[0, 0] = 0.0
# no top edge shorter than min_edge : two vertices closer than that would collapse when the frame is inset (the outline has a sharp peak), so the less important of the two is dropped
min_edge = ev('min_edge')
while len(V) > 3:
    d = np.hypot(*np.diff(V, axis=0).T)
    j = int(np.argmin(d))
    if d[j] >= min_edge:
        break
    cand = [m for m in (j, j + 1) if 0 < m < len(V) - 1]
    if not cand:
        break
    def importance(m):
        p, q, r = V[m - 1], V[m], V[m + 1]
        t = r - p
        return abs(t[0] * (q[1] - p[1]) - t[1] * (q[0] - p[0])) / float(np.hypot(*t))
    V = np.delete(V, min(cand, key=importance), axis=0)
top = [(-x, y) for x, y in V[:0:-1]] + [(x, y) for x, y in V]
outline = [(-H, yb)] + top + [(H, yb)]
geo = hou.pwd().geometry()
geo.clear()                                        # a Python SOP starts from a copy of its input : only the outline is kept
poly = geo.createPolygon()
for x, y in outline:
    pt = geo.createPoint()
    pt.setPosition((float(x), float(y), 0.0))
    poly.addVertex(pt)
"	)
maintainstate	[ 0	locks=0 ]	(	"off"	)
}
