python	[ 0	locks=0 ]	(	"# Hanging corbel under the arch crown, rebuilt from the measured stations of the old model (reference px, 302 px per metre) : ONE body (die, flared web, tablet) + three ribs per face + two returns, every piece a closed lofted solid.
# The ribs now sit ON the web (their back sunk rib_sink into it) and are rooted in the tablet and stopped in the die, on BOTH faces, so nothing floats and the corbel is symmetric front to back as well as left to right.
# Rings at the same height with different sizes make a step ; the measured web and ribs go through reduce_rings, so the loft keeps only the rings that are needed within pend_tol.
exec(open('/Users/zenray/.claude/skills/zenray-houdini/scripts/geo/RingSweep.py').read())
ev = hou.pwd().parent().node('CTRL_pendant').evalParm
ea = hou.pwd().parent().node('CTRL_arch').evalParm
S, Y0, TY = 302.0, 621.0, 1.6887
W = lambda px: px / S
Yw = lambda py: TY + (Y0 - py) / S
tol = ev('pend_tol')
arch_in = ea('arch_cy') + ea('arch_r') - 0.5 * ea('arch_t')
tab_bot, tab_top = Yw(280.0), arch_in + ev('tab_sink')
geo = hou.pwd().geometry()
# body : die, web (reduced), tablet, bottom to top
die = course(Yw(351.0), Yw(319.0), ev('die_w'), ev('die_d'), ev('die_bevel'))
LEGS = ((280.0, 52.0), (281.5, 51.0), (283.0, 49.0), (285.0, 45.5), (288.0, 39.5), (291.0, 34.0), (294.0, 29.5), (297.0, 28.0), (300.0, 27.0), (306.0, 24.5), (312.0, 23.2), (319.0, 23.0))
web = [(Yw(py), W(2.0 * hw), min(max(W(2.0 * hw) * 0.42, 0.050), ev('web_d'))) for py, hw in reversed(LEGS)]
web[-1] = (web[-1][0], web[-1][1] - 2.0 * ev('web_top_inset'), web[-1][2])         # the web top is a little narrower than the tablet underside, so the step between them has a real area (equal widths leave a zero area quad)
web = reduce_rings(web, tol)
tablet = [(tab_bot, W(104), 0.118), (tab_bot + 0.005, W(112), 0.128), (tab_top - 0.006, W(112), 0.128), (tab_top, W(106), 0.120)]
build_spine(geo, die + web + tablet)
# ribs : same front view as the old model, constant z on the web face
proud, sink = ev('rib_proud'), ev('rib_sink')
rd = proud + sink
zc = 0.5 * ev('web_d') - sink + 0.5 * rd
root_y = tab_bot + 0.004
end_y = Yw(319.0) - ev('rib_end_sink')
faces = (1, -1) if ev('rib_both_faces') else (1,)
CENTRE = ((318.0, 12.0), (306.0, 12.5), (296.0, 13.0), (288.0, 14.0), (282.0, 15.0))
SIDE = ((319.0, 17.0), (314.0, 18.0), (307.0, 20.5), (300.0, 24.5), (294.0, 30.0), (289.0, 37.0), (285.0, 43.0), (282.0, 46.5), (279.5, 48.0))
for sz in faces:
    centre = [(Yw(py), W(2.0 * hw), rd, 0.0, sz * zc) for py, hw in CENTRE]
    centre[0] = (end_y,) + centre[0][1:]
    centre.append((root_y, centre[-1][1], rd, 0.0, sz * zc))
    build_spine_xz(geo, reduce_rings(centre, tol))
    for sx in (-1, 1):
        side = [(Yw(py), W(14.0), rd, sx * W(dx), sz * zc) for py, dx in SIDE]
        side[0] = (end_y,) + side[0][1:]
        side.append((root_y, W(14.0), rd, side[-1][3], sz * zc))
        build_spine_xz(geo, reduce_rings(side, tol))
# returns : the two blocks where the shelf folds down at its ends
for sx in (-1, 1):
    build_spine(geo, course(Yw(290.0), Yw(277.0), W(19.0), 0.118, 0.004), origin=(sx * W(49.0), 0.0))
"	)
maintainstate	[ 0	locks=0 ]	(	"off"	)
}
