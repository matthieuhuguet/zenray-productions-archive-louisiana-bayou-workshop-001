float back_z = z_pos - l_depth*0.5 - 0.02;
int pt0 = addpoint(0, set(-total_opening_w*0.5, ifw, back_z));
int pt1 = addpoint(0, set( total_opening_w*0.5, ifw, back_z));
int pt2 = addpoint(0, set( total_opening_w*0.5, ifw + bay_h, back_z));
int pt3 = addpoint(0, set(-total_opening_w*0.5, ifw + bay_h, back_z));
int pr = addprim(0, \"poly\", pt0, pt1, pt2, pt3);
setprimgroup(0, \"group_backing\", pr, 1);
setprimattrib(0, \"piece_id\", pr, pid++);
