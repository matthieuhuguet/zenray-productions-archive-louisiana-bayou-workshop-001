function void add_box(int geo; vector pmin; vector pmax) {
    int p[];
    resize(p, 8);
    p[0] = addpoint(geo, set(pmin.x, pmin.y, pmin.z));
    p[1] = addpoint(geo, set(pmax.x, pmin.y, pmin.z));
    p[2] = addpoint(geo, set(pmax.x, pmin.y, pmax.z));
    p[3] = addpoint(geo, set(pmin.x, pmin.y, pmax.z));
    p[4] = addpoint(geo, set(pmin.x, pmax.y, pmin.z));
    p[5] = addpoint(geo, set(pmax.x, pmax.y, pmin.z));
    p[6] = addpoint(geo, set(pmax.x, pmax.y, pmax.z));
    p[7] = addpoint(geo, set(pmin.x, pmax.y, pmax.z));
    
    int pr;
    // Bottom (-Y)
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[3]); addvertex(geo, pr, p[2]); addvertex(geo, pr, p[1]); addvertex(geo, pr, p[0]);
    // Top (+Y)
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[5]); addvertex(geo, pr, p[6]); addvertex(geo, pr, p[7]); addvertex(geo, pr, p[4]);
    // Front (+Z)
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[7]); addvertex(geo, pr, p[6]); addvertex(geo, pr, p[2]); addvertex(geo, pr, p[3]);
    // Back (-Z)
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[5]); addvertex(geo, pr, p[4]); addvertex(geo, pr, p[0]); addvertex(geo, pr, p[1]);
    // Left (-X)
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[4]); addvertex(geo, pr, p[7]); addvertex(geo, pr, p[3]); addvertex(geo, pr, p[0]);
    // Right (+X)
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[6]); addvertex(geo, pr, p[5]); addvertex(geo, pr, p[1]); addvertex(geo, pr, p[2]);
}

float apron_h = 0.16;
float apron_th = 0.05;
float apron_bot_y = deck_underside_y - apron_h;

add_box(0, set(-pw*0.5, apron_bot_y, -pd), set(-pw*0.5 + apron_th, deck_underside_y, 0.0));
add_box(0, set( pw*0.5 - apron_th, apron_bot_y, -pd), set( pw*0.5, deck_underside_y, 0.0));
add_box(0, set(-pw*0.5, apron_bot_y, -pd), set( pw*0.5, deck_underside_y, -pd + apron_th));
add_box(0, set(-pw*0.5, apron_bot_y, -apron_th), set( pw*0.5, deck_underside_y, 0.0));

float leg_w = 0.12;
float leg_hw = leg_w * 0.5;

float leg_x[4];
float leg_z[4];

float inset_x = pw * 0.5 - leg_hw - 0.01;
float inset_z_back = -pd + leg_hw + 0.01;
float inset_z_front = -leg_hw - 0.01;

leg_x[0] = -inset_x; leg_z[0] = inset_z_back;
leg_x[1] =  inset_x; leg_z[1] = inset_z_back;
leg_x[2] = -inset_x; leg_z[2] = inset_z_front;
leg_x[3] =  inset_x; leg_z[3] = inset_z_front;

for (int l = 0; l < 4; ++l) {
