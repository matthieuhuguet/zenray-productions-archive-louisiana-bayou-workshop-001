python	[ 0	locks=0 ]	(	"# edge group seam : the edges that lie on the mirror plane and are shared by exactly two faces that are coplanar. Clip and mirror cut every face that crosses the plane in two ; the two halves are the same flat face, so dissolving these edges gives the original face back.
import hou
import numpy as np
geo = hou.pwd().geometry()
zc = hou.pwd().parent().node('CTRL_sym').evalParm('seam_z')
tol = 1e-5
shared = {}
for pr in geo.prims():
    ids = [v.point().number() for v in pr.vertices()]
    for i in range(len(ids)):
        a, b = ids[i], ids[(i + 1) % len(ids)]
        shared.setdefault((min(a, b), max(a, b)), []).append(pr)
grp = geo.createEdgeGroup('seam')
for (a, b), prs in shared.items():
    if len(prs) != 2:
        continue
    pa, pb = geo.point(a), geo.point(b)
    if abs(pa.position()[2] - zc) > tol or abs(pb.position()[2] - zc) > tol:
        continue
    n0, n1 = np.array(prs[0].normal()), np.array(prs[1].normal())
    if float(np.dot(n0, n1)) > 1.0 - 1e-6:
        grp.add(geo.findEdge(pa, pb))
"	)
