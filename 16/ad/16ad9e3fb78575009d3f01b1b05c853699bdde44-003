    p[0] = addpoint(geo, set(x0, y_bot, z_out));
    p[1] = addpoint(geo, set(x1, y_bot, z_out));
    p[2] = addpoint(geo, set(x1, y_top, z_in));
    p[3] = addpoint(geo, set(x0, y_top, z_in));
    
    int p_bot[];
    resize(p_bot, 2);
    p_bot[0] = addpoint(geo, set(x0, y_bot, z_in));
    p_bot[1] = addpoint(geo, set(x1, y_bot, z_in));
    
    // Outward normal +Z, Inward normal -Z
    int pr_out = addprim(geo, \"poly\", p[3], p[2], p[1], p[0]);
    int pr_in  = addprim(geo, \"poly\", p_bot[0], p_bot[1], p[2], p[3]);
    int pr_bot = addprim(geo, \"poly\", p_bot[0], p_bot[1], p[1], p[0]);
