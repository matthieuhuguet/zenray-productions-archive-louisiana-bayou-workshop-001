void make_box_xformed(vector center, size; matrix m; string grp_name; int pid) {
    vector h = size * 0.5;
    vector pts[8];
    pts[0] = (center + set(-h.x, -h.y, -h.z)) * m;
    pts[1] = (center + set( h.x, -h.y, -h.z)) * m;
    pts[2] = (center + set( h.x,  h.y, -h.z)) * m;
    pts[3] = (center + set(-h.x,  h.y, -h.z)) * m;
    pts[4] = (center + set(-h.x, -h.y,  h.z)) * m;
    pts[5] = (center + set( h.x, -h.y,  h.z)) * m;
    pts[6] = (center + set( h.x,  h.y,  h.z)) * m;
    pts[7] = (center + set(-h.x,  h.y,  h.z)) * m;
    
    int ipt[8];
    for (int k = 0; k < 8; k++) ipt[k] = addpoint(0, pts[k]);
    
    int pr0 = addprim(0, \"poly\", ipt[3], ipt[2], ipt[1], ipt[0]);
    int pr1 = addprim(0, \"poly\", ipt[4], ipt[5], ipt[6], ipt[7]);
    int pr2 = addprim(0, \"poly\", ipt[0], ipt[1], ipt[5], ipt[4]);
    int pr3 = addprim(0, \"poly\", ipt[7], ipt[6], ipt[2], ipt[3]);
    int pr4 = addprim(0, \"poly\", ipt[0], ipt[4], ipt[7], ipt[3]);
    int pr5 = addprim(0, \"poly\", ipt[1], ipt[2], ipt[6], ipt[5]);
    
    int prims[] = array(pr0, pr1, pr2, pr3, pr4, pr5);
    foreach (int pr; prims) {
        setprimgroup(0, grp_name, pr, 1);
        setprimattrib(0, \"piece_id\", pr, pid);
    }
}

void make_slat(vector slat_center, slat_size; float louver_angle; matrix m_shutter; string grp_name; int pid) {
    matrix m_rot = ident();
    rotate(m_rot, radians(louver_angle), set(1, 0, 0));
    
    vector h = slat_size * 0.5;
    vector corners[8];
    corners[0] = set(-h.x, -h.y, -h.z);
    corners[1] = set( h.x, -h.y, -h.z);
    corners[2] = set( h.x,  h.y, -h.z);
    corners[3] = set(-h.x,  h.y, -h.z);
    corners[4] = set(-h.x, -h.y,  h.z);
    corners[5] = set( h.x, -h.y,  h.z);
    corners[6] = set( h.x,  h.y,  h.z);
    corners[7] = set(-h.x,  h.y,  h.z);
    
    int ipt[8];
    for (int k = 0; k < 8; k++) {
        // Rotate corner around slat's own center, add slat position in shutter space, then transform by shutter matrix
        vector local_pt = slat_center + (corners[k] * m_rot);
        vector world_pt = local_pt * m_shutter;
        ipt[k] = addpoint(0, world_pt);
    }
    
    int pr0 = addprim(0, \"poly\", ipt[3], ipt[2], ipt[1], ipt[0]);
    int pr1 = addprim(0, \"poly\", ipt[4], ipt[5], ipt[6], ipt[7]);
    int pr2 = addprim(0, \"poly\", ipt[0], ipt[1], ipt[5], ipt[4]);
    int pr3 = addprim(0, \"poly\", ipt[7], ipt[6], ipt[2], ipt[3]);
    int pr4 = addprim(0, \"poly\", ipt[0], ipt[4], ipt[7], ipt[3]);
    int pr5 = addprim(0, \"poly\", ipt[1], ipt[2], ipt[6], ipt[5]);
    
    int prims[] = array(pr0, pr1, pr2, pr3, pr4, pr5);
    foreach (int pr; prims) {
        setprimgroup(0, grp_name, pr, 1);
        setprimattrib(0, \"piece_id\", pr, pid);
    }
}

int enable = chi(\"../enable_shutters\");
if (!enable) return;

float W = ch(\"../window_width\");
float H = ch(\"../window_height\");
float cw = ch(\"../casing_width\");
float ct = ch(\"../casing_thickness\");

float sh_open_deg = -ch(\"../shutter_angle\"); // 165 open, 0 closed
float louver_deg = ch(\"../louver_angle\");
int louver_count = chi(\"../louver_count\");
float l_thick = ch(\"../louver_thickness\");
if (l_thick <= 0.0001) l_thick = 0.008;
float l_depth = ch(\"../louver_depth\");
if (l_depth <= 0.0001) l_depth = 0.028;
float rw = ch(\"../shutter_rail_width\");
float sh_thick = 0.026;

float sh_w = (W * 0.5) + cw * 0.2;
float sh_h = H - 0.01;

int pid = 300;

// LEFT SHUTTER (side = -1)
{
    float hx = -W * 0.5 - cw * 0.7;
    float hz = ct + 0.005;
    
    // Rotate by +radians(sh_open_deg) around Y
    float rot_y = radians(sh_open_deg);
    matrix m = ident();
    rotate(m, rot_y, set(0, 1, 0));
    translate(m, set(hx, 0, hz));
    
    vector c = set(sh_w * 0.5, H * 0.5, 0.0);
    
    // Outer stile
    make_box_xformed(c + set(-sh_w*0.5 + rw*0.5, 0, 0), set(rw, sh_h, sh_thick), m, \"group_shutters\", pid++);
    // Inner stile
    make_box_xformed(c + set( sh_w*0.5 - rw*0.5, 0, 0), set(rw, sh_h, sh_thick), m, \"group_shutters\", pid++);
    // Top rail
    make_box_xformed(c + set(0, sh_h*0.5 - rw*0.5, 0), set(sh_w - rw*2.0, rw, sh_thick), m, \"group_shutters\", pid++);
    // Bottom rail
    make_box_xformed(c + set(0, -sh_h*0.5 + rw*0.5, 0), set(sh_w - rw*2.0, rw, sh_thick), m, \"group_shutters\", pid++);
    // Mid rail
    float mid_h = rw * 1.1;
    make_box_xformed(c + set(0, 0, 0), set(sh_w - rw*2.0, mid_h, sh_thick), m, \"group_shutters\", pid++);
    
    // Hinges
    float hy_list[] = array(sh_h * 0.38, 0.0, -sh_h * 0.38);
    foreach (float hy; hy_list) {
        make_box_xformed(c + set(-sh_w*0.5 + 0.04, hy, sh_thick*0.5 + 0.003), set(0.08, 0.026, 0.006), m, \"group_hinges\", pid++);
        matrix m_pin = ident();
        translate(m_pin, set(hx, H*0.5 + hy, hz));
        make_box_xformed(set(0, 0, 0), set(0.016, 0.038, 0.016), m_pin, \"group_hinges\", pid++);
    }
    
    // Louvers
    float bay_w = sh_w - rw * 2.0;
    float upper_bay_h = (sh_h * 0.5 - rw) - (mid_h * 0.5);
    float step = upper_bay_h / float(louver_count + 1);
    
    for (int k = 1; k <= louver_count; k++) {
        float ly = (mid_h * 0.5) + float(k) * step;
        vector slat_pos = c + set(0, ly, 0);
        make_slat(slat_pos, set(bay_w, l_thick, l_depth), louver_deg, m, \"group_shutters\", pid++);
    }
    for (int k = 1; k <= louver_count; k++) {
        float ly = (-sh_h * 0.5 + rw) + float(k) * step;
        vector slat_pos = c + set(0, ly, 0);
        make_slat(slat_pos, set(bay_w, l_thick, l_depth), louver_deg, m, \"group_shutters\", pid++);
    }
}

// RIGHT SHUTTER (side = 1)
{
    float hx = W * 0.5 + cw * 0.7;
    float hz = ct + 0.005;
    
    float rot_y = -radians(sh_open_deg);
    matrix m = ident();
    rotate(m, rot_y, set(0, 1, 0));
    translate(m, set(hx, 0, hz));
    
    vector c = set(-sh_w * 0.5, H * 0.5, 0.0);
    
    make_box_xformed(c + set( sh_w*0.5 - rw*0.5, 0, 0), set(rw, sh_h, sh_thick), m, \"group_shutters\", pid++);
    make_box_xformed(c + set(-sh_w*0.5 + rw*0.5, 0, 0), set(rw, sh_h, sh_thick), m, \"group_shutters\", pid++);
    make_box_xformed(c + set(0, sh_h*0.5 - rw*0.5, 0), set(sh_w - rw*2.0, rw, sh_thick), m, \"group_shutters\", pid++);
    make_box_xformed(c + set(0, -sh_h*0.5 + rw*0.5, 0), set(sh_w - rw*2.0, rw, sh_thick), m, \"group_shutters\", pid++);
    float mid_h = rw * 1.1;
    make_box_xformed(c + set(0, 0, 0), set(sh_w - rw*2.0, mid_h, sh_thick), m, \"group_shutters\", pid++);
    
    float hy_list[] = array(sh_h * 0.38, 0.0, -sh_h * 0.38);
    foreach (float hy; hy_list) {
        make_box_xformed(c + set(sh_w*0.5 - 0.04, hy, sh_thick*0.5 + 0.003), set(0.08, 0.026, 0.006), m, \"group_hinges\", pid++);
        matrix m_pin = ident();
        translate(m_pin, set(hx, H*0.5 + hy, hz));
        make_box_xformed(set(0, 0, 0), set(0.016, 0.038, 0.016), m_pin, \"group_hinges\", pid++);
    }
    
    float bay_w = sh_w - rw * 2.0;
    float upper_bay_h = (sh_h * 0.5 - rw) - (mid_h * 0.5);
    float step = upper_bay_h / float(louver_count + 1);
    
    for (int k = 1; k <= louver_count; k++) {
        float ly = (mid_h * 0.5) + float(k) * step;
        vector slat_pos = c + set(0, ly, 0);
        make_slat(slat_pos, set(bay_w, l_thick, l_depth), louver_deg, m, \"group_shutters\", pid++);
    }
    for (int k = 1; k <= louver_count; k++) {
        float ly = (-sh_h * 0.5 + rw) + float(k) * step;
        vector slat_pos = c + set(0, ly, 0);
        make_slat(slat_pos, set(bay_w, l_thick, l_depth), louver_deg, m, \"group_shutters\", pid++);
    }
}
