int num_v = primvertexcount(0, @primnum);
if (num_v < 3) return;

float min_y = 1e9, max_y = -1e9;
float min_u = 1e9, max_u = -1e9;

int pr = @primnum;
int is_left = inprimgroup(0, 'left_wall', pr);
int is_right = inprimgroup(0, 'right_wall', pr);
int is_front = inprimgroup(0, 'front_wall', pr);
int is_rear = inprimgroup(0, 'rear_wall', pr);

for (int i = 0; i < num_v; ++i)
{
    int vtx = primvertex(0, @primnum, i);
    int pt = vertexpoint(0, vtx);
    vector pos = point(0, 'P', pt);
    
    min_y = min(min_y, pos.y);
    max_y = max(max_y, pos.y);
    
    float u_val = 0.0;
    if (is_left) u_val = pos.z + 3.0;
    else if (is_right) u_val = 3.0 - pos.z;
    else if (is_front) u_val = pos.x + 2.0;
    else if (is_rear) u_val = 2.0 - pos.x;
    
    min_u = min(min_u, u_val);
    max_u = max(max_u, u_val);
}

f@min_v = min_y;
f@max_v = max_y;
f@min_u = min_u;
