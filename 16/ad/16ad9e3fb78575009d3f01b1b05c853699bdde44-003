snippet	[ 0	locks=0 ]	(	"int N = chi(\"../porch_params/step_count\");
float sh = ch(\"../porch_params/step_height\");
// 9 October 2026 : stairs and rails follow the OUTER edge of the porch posts (porch_width + 2 * porch_edge_extra).
float pw = ch(\"../porch_params/porch_width\") + 2.0 * ch(\"../porch_params/porch_edge_extra\");
float sr = ch(\"../porch_params/step_run\");
float pd = ch(\"../porch_params/porch_depth\");
float tt = ch(\"../porch_params/tread_thickness\");
float nos = ch(\"../porch_params/nosing\");
float stringer_th = 0.05;

float landing_y = float(N) * sh;

function void add_box(int geo; vector pmin; vector pmax) {
    int p[];
    resize(p, 8);
    p[0] = addpoint(geo, set(pmin.x, pmin.y, pmin.z));
    p[1] = addpoint(geo, set(pmax.x, pmin.y, pmin.z));
    p[2] = addpoint(geo, set(pmax.x, pmin.y, pmax.z));
    p[3] = addpoint(geo, set(pmin.x, pmin.y, pmax.z));
    p[4] = addpoint(geo, set(pmin.x, pmax.y, pmin.z));
    p[5] = addpoint(geo, set(pmax.x, pmax.y, pmin.z));
    p[6] = addpoint(geo, set(pmax.x, pmax.y, pmax.z));
    p[7] = addpoint(geo, set(pmin.x, pmax.y, pmax.z));
    
    int pr;
    // Bottom (-Y)
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[3]); addvertex(geo, pr, p[2]); addvertex(geo, pr, p[1]); addvertex(geo, pr, p[0]);
    // Top (+Y)
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[5]); addvertex(geo, pr, p[6]); addvertex(geo, pr, p[7]); addvertex(geo, pr, p[4]);
    // Front (+Z)
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[7]); addvertex(geo, pr, p[6]); addvertex(geo, pr, p[2]); addvertex(geo, pr, p[3]);
    // Back (-Z)
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[5]); addvertex(geo, pr, p[4]); addvertex(geo, pr, p[0]); addvertex(geo, pr, p[1]);
    // Left (-X)
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[4]); addvertex(geo, pr, p[7]); addvertex(geo, pr, p[3]); addvertex(geo, pr, p[0]);
    // Right (+X)
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[6]); addvertex(geo, pr, p[5]); addvertex(geo, pr, p[1]); addvertex(geo, pr, p[2]);
}

function void add_quad(int geo; vector p0; vector p1; vector p2; vector p3) {
    int pr = addprim(geo, \"poly\");
    int pt0 = addpoint(geo, p0);
    int pt1 = addpoint(geo, p1);
    int pt2 = addpoint(geo, p2);
    int pt3 = addpoint(geo, p3);
    addvertex(geo, pr, pt0);
    addvertex(geo, pr, pt1);
    addvertex(geo, pr, pt2);
    addvertex(geo, pr, pt3);
}

function void add_tri(int geo; vector p0; vector p1; vector p2) {
    int pr = addprim(geo, \"poly\");
    int pt0 = addpoint(geo, p0);
    int pt1 = addpoint(geo, p1);
    int pt2 = addpoint(geo, p2);
    addvertex(geo, pr, pt0);
    addvertex(geo, pr, pt1);
    addvertex(geo, pr, pt2);
}

// 1. Landing Deck (Top platform - flush with vestibule)
add_box(0, set(-pw*0.5, landing_y - tt, -pd), set(pw*0.5, landing_y, 0.0));

// 2. Steps: Treads and Risers
float step_nos = (nos > 0.0) ? nos : 0.025;
for (int i = 1; i <= N; ++i) {
    float tread_top_y = float(N - i + 1) * sh;
    float tread_bot_y = tread_top_y - tt;
    
    float tread_back_z = float(i - 1) * sr;
    float tread_front_z = float(i) * sr + step_nos;
    
    add_box(0, set(-pw*0.5, tread_bot_y, tread_back_z), set(pw*0.5, tread_top_y, tread_front_z));
    
    if (chi(\"../porch_params/open_risers\") == 0) {
        float riser_z = float(i) * sr;
        float riser_bot_y = (i == N) ? 0.0 : float(N - i) * sh;
        add_box(0, set(-pw*0.5, riser_bot_y, riser_z - 0.02), set(pw*0.5, tread_bot_y, riser_z));
    }
}

// 3. Sawtooth Stringers (Left and Right)
function float get_stringer_bot(float z; float landing_y; float tt; float sh; float sr; float H_beam) {
    float y_notch = (landing_y - tt) - (sh / sr) * z;
    return max(0.0, y_notch - H_beam);
}

void build_stringer(int geo; float x_center; float th; int N; float sh; float sr; float tt; float landing_y) {
    float x0 = x_center - th * 0.5;
    float x1 = x_center + th * 0.5;
    float H_beam = max(0.12, sh * 0.7);
    
    for (int i = 1; i <= N; ++i) {
        float za = float(i - 1) * sr;
        float zb = float(i) * sr;
        float y_top = float(N - i + 1) * sh - tt;
        float y_mid = (i < N) ? (float(N - i) * sh - tt) : 0.0;
        float y_bota = get_stringer_bot(za, landing_y, tt, sh, sr, H_beam);
        float y_botb = get_stringer_bot(zb, landing_y, tt, sh, sr, H_beam);
        
        // --- Outer face at x0 (-X normal) ---
        if (abs(y_mid - y_botb) < 1e-4) {
            add_tri(geo, set(x0, y_top, za), set(x0, y_botb, zb), set(x0, y_bota, za));
        } else {
            add_quad(geo, set(x0, y_top, za), set(x0, y_mid, zb), set(x0, y_botb, zb), set(x0, y_bota, za));
        }
        if (y_top > y_mid) {
            add_tri(geo, set(x0, y_top, zb), set(x0, y_mid, zb), set(x0, y_top, za));
        }
        
        // --- Inner face at x1 (+X normal) ---
        if (abs(y_mid - y_botb) < 1e-4) {
            add_tri(geo, set(x1, y_botb, zb), set(x1, y_top, za), set(x1, y_bota, za));
        } else {
            add_quad(geo, set(x1, y_botb, zb), set(x1, y_mid, zb), set(x1, y_top, za), set(x1, y_bota, za));
        }
        if (y_top > y_mid) {
            add_tri(geo, set(x1, y_mid, zb), set(x1, y_top, zb), set(x1, y_top, za));
        }
        
        // --- Tread shelf (+Y normal) ---
        add_quad(geo, set(x1, y_top, za), set(x1, y_top, zb), set(x0, y_top, zb), set(x0, y_top, za));
        
        // --- Riser drop (+Z normal) ---
        if (y_top > y_mid) {
            add_quad(geo, set(x0, y_top, zb), set(x1, y_top, zb), set(x1, y_mid, zb), set(x0, y_mid, zb));
        }
        
        // --- Underside (-Y / -Z normal) ---
        add_quad(geo, set(x0, y_botb, zb), set(x1, y_botb, zb), set(x1, y_bota, za), set(x0, y_bota, za));
    }
    
    // Top back face (-Z at za = 0)
    float y_top_back_bot = get_stringer_bot(0.0, landing_y, tt, sh, sr, H_beam);
    float y_top_back_top = landing_y - tt;
    add_quad(geo, set(x1, y_top_back_bot, 0.0), set(x1, y_top_back_top, 0.0), set(x0, y_top_back_top, 0.0), set(x0, y_top_back_bot, 0.0));
    
    // Bottom floor contact (if y_bot == 0.0 at zb = N*sr)
    float last_za = float(N - 1) * sr;
    float last_zb = float(N) * sr;
    float last_bota = get_stringer_bot(last_za, landing_y, tt, sh, sr, H_beam);
    float last_botb = get_stringer_bot(last_zb, landing_y, tt, sh, sr, H_beam);
    if (last_bota == 0.0 || last_botb == 0.0) {
        add_quad(geo, set(x0, 0.0, last_zb), set(x1, 0.0, last_zb), set(x1, 0.0, last_za), set(x0, 0.0, last_za));
    }
}

build_stringer(0, -pw * 0.5 + stringer_th * 0.5, stringer_th, N, sh, sr, tt, landing_y);
build_stringer(0,  pw * 0.5 - stringer_th * 0.5, stringer_th, N, sh, sr, tt, landing_y);
if (chi(\"../porch_params/middle_stringer\") == 1) build_stringer(0, 0.0, stringer_th, N, sh, sr, tt, landing_y);
