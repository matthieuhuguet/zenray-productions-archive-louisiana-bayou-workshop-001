        for (int i = 0; i < len(wz); ++i) {
            float z0 = wz[i] - hw; float z1 = wz[i] + hw;
            sq(flip, xb, xt, yb, yt, yb, yt, cur, z0, rid, grp);                          // column left of the window, full row
            if (yb < oy0) sq(flip, xb, xt, yb, yt, yb, min(yt, oy0), z0, z1, rid, grp);   // under the sill
            if (yt > oy1) sq(flip, xb, xt, yb, yt, max(yb, oy1), yt, z0, z1, rid, grp);   // over the lintel
            cur = z1;
        }
    }
    sq(flip, xb, xt, yb, yt, yb, yt, cur, l * 0.5, rid, grp);
}
void gq(int flip; float zb; float zt; float yb; float yt; float hb; float ht; float ya; float yc; float x0; float x1; int rid; string grp) {
    if (yc - ya < 0.0001) return;
    float ta = (ya - yb) / max(yt - yb, 0.000001); float tc = (yc - yb) / max(yt - yb, 0.000001);
    float ha = lerp(hb, ht, ta); float hc = lerp(hb, ht, tc);
    float xla = max(x0, -ha); float xra = min(x1, ha); float xlc = max(x0, -hc); float xrc = min(x1, hc);
    if (xra - xla < 0.0001 && xrc - xlc < 0.0001) return;
    float za = lerp(zb, zt, ta); float zc = lerp(zb, zt, tc);
    if (flip == 0) addq(set(xla, ya, za), set(xlc, yc, zc), set(xrc, yc, zc), set(xra, ya, za), rid, grp);
    else addq(set(xra, ya, za), set(xrc, yc, zc), set(xlc, yc, zc), set(xla, ya, za), rid, grp);
}
void gable_row(int flip; float zb; float zt; float yb; float yt; float hb; float ht; float ox0[]; float ox1[]; float oy0[]; float oy1[]; int rid; string grp) {
    float cur = -1000000.0;
    for (int i = 0; i < len(ox0); ++i) {
        if (yb < oy1[i] && yt > oy0[i]) {
            gq(flip, zb, zt, yb, yt, hb, ht, yb, yt, cur, ox0[i], rid, grp);
            if (yb < oy0[i]) gq(flip, zb, zt, yb, yt, hb, ht, yb, min(yt, oy0[i]), ox0[i], ox1[i], rid, grp);
            if (yt > oy1[i]) gq(flip, zb, zt, yb, yt, hb, ht, max(yb, oy1[i]), yt, ox0[i], ox1[i], rid, grp);
            cur = ox1[i];
        }
    }
    gq(flip, zb, zt, yb, yt, hb, ht, yb, yt, cur, 1000000.0, rid, grp);
}

float w = ch("../../width");
float l = ch("../../length");
float wh = ch("../../wall_height");
float fgh = ch("../../front_gable_height");
float rgh = ch("../../rear_gable_height");
int mult = chi("../../plank_multiplier") + 1;     // menu index 0,1,2 = x1 (old 28 rows), x2 (default), x3 (finest)
int count = 28 * mult;
float th = 0.025;
float overlap = 0.02 / float(mult);
float max_gh = max(fgh, rgh);
float total_h = wh + max_gh;
float step_h = total_h / float(count);
float plank_h = step_h + overlap;

float winA_w = ch("../../winA_width");
float winA_h = ch("../../winA_height");
float winA_sill = ch("../../winA_sill_y");
float winA_sp = 1.60;
if (ch("../../winA_spacing") > 0.0) winA_sp = ch("../../winA_spacing");
int nwin = chi("../../Component_WindowA/num_side_windows");
float winA_z[];
if (nwin == 4) winA_z = array(-1.5 * winA_sp, -0.5 * winA_sp, 0.5 * winA_sp, 1.5 * winA_sp);
else if (nwin == 2) winA_z = array(-winA_sp, winA_sp);
else if (nwin == 1) winA_z = array(0.0);
else winA_z = array(-winA_sp, 0.0, winA_sp);
winA_z = array();
float hwA = winA_w * 0.5 - 0.02;
float winB_w = ch("../../winB_width");
float winB_h = ch("../../winB_height");
float winB_sill = ch("../../winB_sill_y");
float hwB = winB_w * 0.5 - 0.025;

// 1. LEFT WALL (X = -w/2) and 2. RIGHT WALL (X = +w/2)
for (int k = 0; k < count; ++k) {
    float y_bot = float(k) * step_h;
    float y_top = min(y_bot + plank_h, wh);
    if (y_bot >= wh) break;
    side_row(0, -w * 0.5 - th, -w * 0.5, y_bot, y_top, l, winA_z, hwA, winA_sill, winA_sill + winA_h, k, "left_wall");
    side_row(1,  w * 0.5 + th,  w * 0.5, y_bot, y_top, l, winA_z, hwA, winA_sill, winA_sill + winA_h, 100000 + k, "right_wall");
}

// 3. FRONT GABLE (Z = +l/2) : door and window B
float door_cx = -0.38; float door_hw = 0.34; float door_bot = 0.60; float door_top = 1.85;
float f_ox0[] = array(door_cx - door_hw);
float f_ox1[] = array(door_cx + door_hw);
float f_oy0[] = array(door_bot);
float f_oy1[] = array(door_top);
float r_ox0[]; float r_ox1[]; float r_oy0[]; float r_oy1[];
float peak_f = wh + fgh;
for (int k = 0; k < count; ++k) {
    float y_bot = float(k) * step_h; float y_top = y_bot + plank_h;
    if (y_bot >= peak_f) break;
    float hb = w * 0.5; float ht = w * 0.5;
    if (y_bot > wh) hb = w * 0.5 * clamp(1.0 - (y_bot - wh) / fgh, 0.0, 1.0);
    if (y_top > wh) ht = w * 0.5 * clamp(1.0 - (y_top - wh) / fgh, 0.0, 1.0);
    gable_row(0, l * 0.5 + th, l * 0.5, y_bot, y_top, hb, ht, f_ox0, f_ox1, f_oy0, f_oy1, 200000 + k, "front_wall");
}

// 4. REAR GABLE (Z = -l/2) : window B
float peak_r = wh + rgh;
for (int k = 0; k < count; ++k) {
    float y_bot = float(k) * step_h; float y_top = y_bot + plank_h;
    if (y_bot >= peak_r) break;
    float hb = w * 0.5; float ht = w * 0.5;
    if (y_bot > wh) hb = w * 0.5 * clamp(1.0 - (y_bot - wh) / rgh, 0.0, 1.0);
    if (y_top > wh) ht = w * 0.5 * clamp(1.0 - (y_top - wh) / rgh, 0.0, 1.0);
    gable_row(1, -l * 0.5 - th, -l * 0.5, y_bot, y_top, hb, ht, r_ox0, r_ox1, r_oy0, r_oy1, 300000 + k, "rear_wall");
}
