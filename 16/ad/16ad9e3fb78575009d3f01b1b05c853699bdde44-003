}

function void add_knee_brace(int geo; vector p_post; vector p_beam; float brace_w; float brace_th; vector normal_axis) {
    vector dir = normalize(p_beam - p_post);
    vector v_w = normalize(cross(dir, normal_axis)) * (brace_w * 0.5);
    vector v_th = normal_axis * (brace_th * 0.5);
    
    int p[];
    resize(p, 8);
    p[0] = addpoint(geo, p_post - v_w - v_th);
    p[1] = addpoint(geo, p_post + v_w - v_th);
    p[2] = addpoint(geo, p_post + v_w + v_th);
    p[3] = addpoint(geo, p_post - v_w + v_th);
    p[4] = addpoint(geo, p_beam - v_w - v_th);
    p[5] = addpoint(geo, p_beam + v_w - v_th);
    p[6] = addpoint(geo, p_beam + v_w + v_th);
    p[7] = addpoint(geo, p_beam - v_w + v_th);
    
    int pr;
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[3]); addvertex(geo, pr, p[2]); addvertex(geo, pr, p[1]); addvertex(geo, pr, p[0]);
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[4]); addvertex(geo, pr, p[5]); addvertex(geo, pr, p[6]); addvertex(geo, pr, p[7]);
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[2]); addvertex(geo, pr, p[3]); addvertex(geo, pr, p[7]); addvertex(geo, pr, p[6]);
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[0]); addvertex(geo, pr, p[1]); addvertex(geo, pr, p[5]); addvertex(geo, pr, p[4]);
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[3]); addvertex(geo, pr, p[0]); addvertex(geo, pr, p[4]); addvertex(geo, pr, p[7]);
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[1]); addvertex(geo, pr, p[2]); addvertex(geo, pr, p[6]); addvertex(geo, pr, p[5]);
}

float brace_span = 0.35;
add_knee_brace(0, set(-inset_x, deck_underside_y - apron_h - brace_span, inset_z_back + leg_hw),
                  set(-inset_x, deck_underside_y - apron_h, inset_z_back + leg_hw + brace_span),
                  0.08, 0.06, set(1, 0, 0));
add_knee_brace(0, set(-inset_x + leg_hw, deck_underside_y - apron_h - brace_span, inset_z_back),
                  set(-inset_x + leg_hw + brace_span, deck_underside_y - apron_h, inset_z_back),
                  0.08, 0.06, set(0, 0, 1));
