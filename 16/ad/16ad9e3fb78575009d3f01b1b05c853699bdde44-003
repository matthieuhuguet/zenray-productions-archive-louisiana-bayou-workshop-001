    for (int k = 0; k < 8; k++) {
        vector pt = center + (corners[k] * m);
        ipt[k] = addpoint(0, pt);
    }
    
    int pr0 = addprim(0, \"poly\", ipt[3], ipt[2], ipt[1], ipt[0]);
    int pr1 = addprim(0, \"poly\", ipt[4], ipt[5], ipt[6], ipt[7]);
    int pr2 = addprim(0, \"poly\", ipt[0], ipt[1], ipt[5], ipt[4]);
    int pr3 = addprim(0, \"poly\", ipt[7], ipt[6], ipt[2], ipt[3]);
    int pr4 = addprim(0, \"poly\", ipt[0], ipt[4], ipt[7], ipt[3]);
    int pr5 = addprim(0, \"poly\", ipt[1], ipt[2], ipt[6], ipt[5]);
    
    int prims[] = array(pr0, pr1, pr2, pr3, pr4, pr5);
    foreach (int pr; prims) {
        setprimgroup(0, grp_name, pr, 1);
        setprimattrib(0, \"piece_id\", pr, pid);
    }
}

float W = ch(\"../window_width\") - 0.055;
float H = ch(\"../window_height\") - 0.055;
float ifw = ch(\"../inner_frame_width\");
float mw = ch(\"../center_mullion_width\");

float louver_angle_deg = ch(\"../louver_angle\");
int count = chi(\"../louver_count\");
float l_thick = ch(\"../louver_thickness\");
float l_depth = ch(\"../louver_depth\");
float recess = ch(\"../louver_recess\");

int pid = 200;

float total_opening_w = W - ifw*2.0;
float bay_w = (total_opening_w - mw) * 0.5;
float bay_h = H - ifw*2.0;

float left_bay_x = -mw*0.5 - bay_w*0.5;
float right_bay_x = mw*0.5 + bay_w*0.5;

float step_y = bay_h / float(count + 1);
float z_pos = -recess;

for (int k = 1; k <= count; k++) {
    float y_pos = ifw + float(k) * step_y;
    make_slat(set(left_bay_x, y_pos, z_pos), set(bay_w, l_thick, l_depth), louver_angle_deg, \"group_louvers\", pid++);
}

for (int k = 1; k <= count; k++) {
    float y_pos = ifw + float(k) * step_y;
    make_slat(set(right_bay_x, y_pos, z_pos), set(bay_w, l_thick, l_depth), louver_angle_deg, \"group_louvers\", pid++);
}

