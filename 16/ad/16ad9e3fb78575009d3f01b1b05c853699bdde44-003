// Invert curve_v with 8 Newton-Raphson iterations
float invert_curve_v(float v; float flare) {
    float u = v;
    for (int it = 0; it < 8; it++) {
        float f = (1.0 - flare) * u + flare * pow(u, 1.5) - v;
        float df = (1.0 - flare) + 1.5 * flare * sqrt(max(0.0001, u));
        u = clamp(u - f / df, 0.0, 1.0);
    }
    return u;
}

// 1. CORNER TRIMS
float trim_w = 0.075;
float trim_th = 0.024;
// 9 October 2026 (Matthieu) : ONE corner post per outer edge instead of two overlapping boards. Same outer extent as before (front board + side board), merged into a single square post of trim_w + trim_th. FR : un seul poteau par arête extérieure.
add_box(0, set(-hw - trim_th, y0, zf - trim_w), set(-hw + trim_w, ye, zf + trim_th), \"group_trim\", pid++);
add_box(0, set(hw - trim_w, y0, zf - trim_w), set(hw + trim_th, ye, zf + trim_th), \"group_trim\", pid++);

// Rear trims penetrating church wall
add_box(0, set(-hw - trim_th, y0, zb), set(-hw, ye, zb + trim_w), \"group_trim\", pid++);
add_box(0, set(hw, y0, zb), set(hw + trim_th, ye, zb + trim_w), \"group_trim\", pid++);

// 2. HORIZONTAL LAP SIDING ON SIDE WALLS (PENETRATES TO zb=2.95)
float plank_h = 0.105;
float plank_th = 0.016;
float plank_overlap = 0.018;
float step_y = plank_h - plank_overlap;
int num_planks = int(ceil(wh / step_y));

for (int i = 0; i < num_planks; i++) {
    float py_bot = y0 + float(i) * step_y;
    float py_top = min(ye, py_bot + plank_h);
    if (py_bot >= ye) break;
    add_lap_plank_side(0, -hw, py_bot, py_top, zb, zf, plank_th, -1, \"group_siding\", pid);
    add_lap_plank_side(0,  hw, py_bot, py_top, zb, zf, plank_th,  1, \"group_siding\", pid);
    pid++;
}

// 3. FRONT WALL LAP SIDING (FLANKING DOORWAY)
for (int i = 0; i < num_planks; i++) {
    float py_bot = y0 + float(i) * step_y;
    float py_top = min(ye, py_bot + plank_h);
    if (py_bot >= ye) break;
    add_lap_plank_front(0, -hw, -hdw, py_bot, py_top, zf, plank_th, \"group_siding\", pid);
    add_lap_plank_front(0,  hdw,  hw, py_bot, py_top, zf, plank_th, \"group_siding\", pid);
    pid++;
}

