python	[ 0	locks=0 ]	(	"# 10 October 2026 (v8 lower end cropped by the post inner face) (v7, rafter ends extended to the centre plane then cut flat) (v6) / (v5) : church cross + inverted arrow, ONE component. EN: the armature generator now builds the cross post as the SAME beam as the king post and starts the arrow exactly at the top of window B, so this node only (1) makes the crossbar thinner in depth, centred on the post depth, (2) gives post, crossbar and arms one piece_id and px_per_m = 1024. Pieces are found by shape on the front gable (z 6.1 to 6.45). FR : croix et fleche inversee = un seul composant ; la geometrie vient du generateur, ce noeud amincit le croisillon et unifie les identifiants.
import hou
import numpy as np
geo = hou.pwd().geometry()
CROSSBAR_DEPTH_RATIO = 0.78
PX_PER_M = 1024.0

# 16 October 2026 : roof height field in Python (same function as the VEX zr_dy) and the REAL rafter axes (chord of the first and last curve segment), so the cropped ends stay on the curved beam. FR : axes reels des chevrons courbes.
import math
def _zr_dy(c, x, z):
    u = min(max(1.0 - abs(x) / max(c[0], 1e-6), 0.0), 1.0)
    k = math.log(0.5) / math.log(c[3]) if 0.001 < c[3] < 0.999 else 1.0
    ub = u ** k
    zn = min(abs(z) / max(c[1], 1e-6), 1.0)
    zt = 1.0 - zn ** max(c[5], 0.01)
    return -c[2] * 4.0 * ub * (1.0 - ub) - c[4] * zt * u
def rafter_axes(left, gz):
