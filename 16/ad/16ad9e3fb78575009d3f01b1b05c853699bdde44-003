    addvertex(geo, pr, addpoint(geo, p1));
    addvertex(geo, pr, addpoint(geo, p2));
    addvertex(geo, pr, addpoint(geo, p3));
    setprimgroup(geo, grp, pr, 1);
    setprimattrib(geo, \"piece_id\", pr, piece);
}

float curve_v(float u; float flare) {
    return (1.0 - flare) * u + flare * pow(u, 1.5);
}

vector get_roof_pt(float u; int side; float z; float hw_eave; float ye; float gh; float flare) {
    float v = curve_v(u, flare);
    float x = float(side) * hw_eave * (1.0 - u);
    float y = ye + gh * v;
    return set(x, y, z);
}

vector get_roof_norm(float u; int side; float hw_eave; float gh; float flare) {
    float d_dx = hw_eave;
    float d_dy = gh * ((1.0 - flare) + 1.5 * flare * sqrt(max(0.001, u)));
    if (side == -1) {
        return normalize(set(-d_dy, d_dx, 0.0));
    } else {
        return normalize(set( d_dy, d_dx, 0.0));
    }
}

