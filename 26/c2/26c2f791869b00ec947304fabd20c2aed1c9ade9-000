result = {'$obj': {'s': round(time.time() - t, 1), 'res': r}}
" > $W/Scripts/RunM1Artist_$obj.out 2>&1
  /opt/homebrew/bin/python3 -c "
import json
try:
    r = json.load(open('$W/Scripts/RunM1Artist_$obj.out'))['result']['$obj']
    print('$obj', r['s'], {k: (v['score'], v['weakest'], (v['errors'] or [''])[0][:300] if v['errors'] else '') for k, v in r['res'].items()})
except Exception as e:
    print('$obj', 'unreadable', e, open('$W/Scripts/RunM1Artist_$obj.out').read()[-1500:])
" >> $W/Scripts/RunM1Artist.sum
  echo "$obj done $(date +%H:%M:%S)" >> $W/Scripts/RunM1Artist.sum
