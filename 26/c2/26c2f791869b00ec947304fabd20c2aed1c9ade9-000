W=/Users/zenray/.claude/tmp/tmp-houdini-september-2026/tmp-bayou-louisiana/03_work/uv/ZenRayUV_5Methods_19-October-2026
P=/Users/zenray/.claude/skills/zenray-houdini/templates/zenray-uv-patterns
B="/opt/homebrew/bin/python3 /Users/zenray/.claude/Memory1/Houdini/MCP/zrhoudini.py hom"
: > $W/Scripts/RunM1Artist.sum
for obj in ZRUV_ShaderBall ZRUV_RubberToy ZRUV_Manny; do
  ZR_BRIDGE_TIMEOUT=5400 $=B "
import time
exec(open('/Users/zenray/.claude/skills/zenray-houdini/scripts/zenray_uv/ZenRayUV.py').read(), globals())
_reload()
t = time.time()
geo = ensure('$obj', None, ('M1',))
