#!/bin/zsh
# 20 October 2026 : second pass of the organic assets after a tailor change : every method with its bake, one asset per bridge call, then the sheets.
W=/Users/zenray/.claude/tmp/tmp-houdini-september-2026/tmp-bayou-louisiana/03_work/uv/ZenRayUV_5Methods_19-October-2026
B="/opt/homebrew/bin/python3 /Users/zenray/.claude/Memory1/Houdini/MCP/zrhoudini.py hom"
for spec in "ZRUV_RubberToy:M1,M2,M3,M3B,M3C,M4,M5" "ZRUV_ShaderBall:M1,M2,M3,M3B,M3C,M4,M5" "ZRUV_Manny:M1,M2,M3,M3B,M3C,M4,M5"; do
  obj=${spec%%:*}; meths=${spec#*:}; py_meths="('${meths//,/','}',)"
  ZR_BRIDGE_TIMEOUT=3600 $=B "OBJS=('$obj',); METHS=$py_meths; BAKE=True; RUNS='$W/runs'; exec(open('$W/Scripts/RunSheets.py').read())" > $W/Scripts/RunOrganic_$obj.out 2>&1
  echo $obj done
done
echo all done
