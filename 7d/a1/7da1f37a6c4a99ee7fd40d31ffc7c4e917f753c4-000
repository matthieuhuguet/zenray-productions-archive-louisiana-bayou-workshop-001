# 20 October 2026 : which island borders the artist laid as straight lines in uv (and axis aligned), per asset : each border chain of an island (between two
# points where the border changes neighbour island) is tested for collinearity in the artist's uv. Usage : python -I StraightEdges.py <asset>
# FR : quels bords d'ile l'artiste a poses en lignes droites.
import sys, os, json, math
import numpy as np
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, '/Users/zenray/.claude/skills/zenray-houdini/scripts/zenray_uv')
import ZrMesh as Z, OrigStudy as O, ZruvArtist as A, ZruvTailor as T

def border_chains(m, S, cut, lab, k, ref):
    fs = [int(f) for f in np.where(lab == k)[0]]
    loc = T.Local(S, fs, cut)
    U = np.zeros((loc.n, 2))
    for (f, j), lv in loc.corner.items():
        U[lv] = m.uv[ref][f][j]
    out = []
    for loop in loc.loops:
        n = len(loop)
        if n < 3:
            continue
        # the neighbour island across each border edge of the loop (local vertices a -> b) : break the loop where it changes
        gv = loc.gv
        def other(a, b):
            e = S.emap.get((min(gv[a], gv[b]), max(gv[a], gv[b])))
            if e is None:
                return -1
            fl = S.ef[e]
            others = [int(lab[f]) for f in fl if lab[f] != k]
            return others[0] if others else (k if len(fl) == 2 else -2)
        nb = [other(loop[i], loop[(i + 1) % n]) for i in range(n)]
        cuts = [i for i in range(n) if nb[i] != nb[i - 1]]
        if not cuts:
            cuts = [0]
        for ci, c0 in enumerate(cuts):
            c1 = cuts[(ci + 1) % len(cuts)] if len(cuts) > 1 else c0 + n
            if c1 <= c0:
                c1 += n
            ids = [loop[i % n] for i in range(c0, c1 + 1)]
            out.append((nb[c0 % n], U[ids], S.P[gv[ids]]))
    return out, U

asset = sys.argv[1]
m, _ = O.load_pair(asset)
seams = A.inner_seams(m, 'orig', 1e-5)
S, cut, lab, n = A._local_islands(m, seams)
tot_len = 0.0; straight_len = 0.0; aligned_len = 0.0; rows = []
for k in range(n):
    chains, U = border_chains(m, S, cut, lab, k, 'orig')
    diag = float(np.linalg.norm(U.max(0) - U.min(0)))
    if diag < 1e-9:
        continue
    for nbk, UV, P3 in chains:
        L3 = float(np.linalg.norm(np.diff(P3, axis=0), axis=1).sum())
        if len(UV) < 4:
            continue
        c = UV.mean(0)
        w, v = np.linalg.eigh((UV - c).T @ (UV - c))
        d = v[:, 1]
        dev = float(np.abs((UV - c) @ v[:, 0]).max())
        span = float(np.ptp((UV - c) @ d))
        tot_len += L3
        if span > 0.05 * diag and dev <= 0.004 * diag:
            straight_len += L3
            ang = math.degrees(math.atan2(abs(d[1]), abs(d[0])))
            al = min(ang, 90 - ang) < 1.0
            if al:
                aligned_len += L3
            rows.append((round(L3, 3), k, nbk, round(dev / diag, 5), round(ang, 1), al))
rows.sort(reverse=True)
print(asset, 'border length %.2f m ; straight in the artist uv %.1f %% ; straight and axis aligned %.1f %%' % (tot_len, 100 * straight_len / tot_len, 100 * aligned_len / tot_len))
for r in rows[:30]:
    print('  len %.3f m island %d next to %d : deviation %.5f of the island, angle %.1f deg, axis aligned %s' % r)
