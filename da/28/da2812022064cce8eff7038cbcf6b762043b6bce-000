P = np.array(g.pointFloatAttribValues('P')).reshape(-1, 3) * 0.01        # the asset is in cm, the test object scales it by 0.01
UVp = np.array(g.pointFloatAttribValues('uv')).reshape(-1, 3)[:, :2]
polys = [[v.point().number() for v in pr.vertices()] for pr in g.prims()]
m = Z.Mesh(P, polys)
find, union = Z.uf(m.n)
for e, fl in m.edges.items():
    for k in range(1, len(fl)):
        union(fl[0], fl[k])
isl = collections.Counter(find(f) for f in range(m.n))
border = sum(m.edge_length(e) for e, fl in m.edges.items() if len(fl) == 1)
tris = np.array([(p[0], p[k], p[k + 1]) for p in polys for k in range(1, len(p) - 1)])
r, s, a3 = O.distortion(P, tris, UVp, 0.0)
sc = np.sqrt((a3).sum() / (r ** 2 * a3).sum())
r2, s2, _ = O.distortion(P, tris, UVp * sc, 0.0)
w = a3 / a3.sum()
uvA = 0.0
for t in tris:
    q = UVp[t]
    uvA += 0.5 * abs((q[1, 0] - q[0, 0]) * (q[2, 1] - q[0, 1]) - (q[2, 0] - q[0, 0]) * (q[1, 1] - q[0, 1]))
ok10 = (np.abs(r2 - 1) <= 0.1) & (s2 <= 0.1)
result = {'islands': len(isl), 'seams_m': round(border / 2.0, 2), 'area_m2': round(float(a3.sum()), 4), 'uv_area_in_unit_square': round(uvA, 4),
