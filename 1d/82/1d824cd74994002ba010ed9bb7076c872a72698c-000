# 29 October 2026 : applies the post-process effects listed in ON (global, default all) with the off/on values of lb_postprocess_29-October-2026.json; prints which properties were accepted. FR : applique les effets de post-traitement.
import unreal, json
P = json.load(open('/Users/zenray/Create/Build/Productions/ZenRayHoudini/LouisianaBayou/unreal/lb_postprocess_29-October-2026.json'))['effects']
ON = globals().get('ON'); ON = list(P) if ON is None else ON
eas = unreal.get_editor_subsystem(unreal.EditorActorSubsystem); eal = unreal.EditorAssetLibrary
by = {a.get_actor_label(): a for a in eas.get_all_level_actors()}
pp = by['LB_PostProcess']; st = pp.settings
class _Null:
    def set_editor_property(self, *a, **k): pass
if 'LB_UDS' in by:   # 29 October 2026 : Ultra Dynamic Sky owns the sun, fog and clouds / FR : UDS porte soleil, brouillard et nuages
    sun = by['LB_UDS'].get_editor_property('sun_LightComponent'); fog = by['LB_UDS'].get_editor_property('height Fog Component')
else:
    sun = by['LB_Sun'].light_component if 'LB_Sun' in by else _Null(); fog = by['LB_HeightFog'].component if 'LB_HeightFog' in by else _Null()
rep = {}
def setp(obj, prop, val, override=True, tag=''):
    try:
        if override:
            try: obj.set_editor_property('override_' + prop, True)
            except Exception: pass
        obj.set_editor_property(prop, val); rep[tag + prop] = 'ok'
    except Exception as e: rep[tag + prop] = 'FAIL ' + str(e)[:60]
for name, E in P.items():
    k = 1 if name in ON else 0
    for prop, v in E.get('pp', {}).items(): setp(st, prop, v[k])
    for prop, v in E.get('pp4', {}).items(): setp(st, prop, unreal.Vector4(x=v[k][0], y=v[k][1], z=v[k][2], w=v[k][3]))
    for prop, v in E.get('sun', {}).items(): setp(sun, prop, v[k], False, 'sun.')
    for prop, v in E.get('fog', {}).items(): setp(fog, prop, v[k], False, 'fog.')
    if 'clouds' in E and 'LB_UDS' in by: rep['clouds'] = 'owned by UDS'
    elif 'clouds' in E:
        c = by.get('LB_Clouds')
        if k and not c:
            c = eas.spawn_actor_from_class(unreal.VolumetricCloud, unreal.Vector(0, 0, 0)); c.set_actor_label('LB_Clouds')
            try:
                comp = c.get_component_by_class(unreal.VolumetricCloudComponent)
                comp.set_editor_property('material', eal.load_asset('/Engine/EngineSky/VolumetricClouds/m_SimpleVolumetricCloud_Inst'))
            except Exception as e: rep['clouds.material'] = 'FAIL ' + str(e)[:60]
        if (not k) and c: eas.destroy_actor(c)
        rep['clouds'] = 'on' if k else 'off'
pp.set_editor_property('settings', st)
print('ON', [n for n in P if n in ON]); print(json.dumps(rep, indent=0))

# 29 October 2026 : color grading, the 8 values of the slider page. NEUTRAL=True gives the neutral base used for the slider-page images; otherwise the values of lb_grading_values_29-October-2026.json (or the defaults). FR : étalonnage.
import os
G = json.load(open('/Users/zenray/Create/Build/Productions/ZenRayHoudini/LouisianaBayou/unreal/lb_postprocess_29-October-2026.json'))['grading']
VF = '/Users/zenray/Create/Build/Productions/ZenRayHoudini/LouisianaBayou/unreal/lb_grading_values_29-October-2026.json'
V = globals().get('GVALUES') or (json.load(open(VF)) if os.path.exists(VF) else {})
st = pp.settings
for k, g in G.items():
    if k.startswith('_'): continue
    v = g['neutral'] if globals().get('NEUTRAL') else V.get(k, g['default'])
    if g['kind'] == 'v4': setp(st, g['prop'], unreal.Vector4(x=v, y=v, z=v, w=1.0), True, 'grade.')
    else: setp(st, g['prop'], float(v), True, 'grade.')
pp.set_editor_property('settings', st)
print('grading', 'NEUTRAL' if globals().get('NEUTRAL') else V or 'defaults')
