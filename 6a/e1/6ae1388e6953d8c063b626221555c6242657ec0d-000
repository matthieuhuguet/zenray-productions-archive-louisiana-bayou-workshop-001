def font(sz):
    for p in (FONT, '/Users/zenray/Library/Fonts/AnthropicSans-Medium.ttf'):
        try:
            f = ImageFont.truetype(p, sz)
            try:
                f.set_variation_by_axes([500])
            except Exception:
                pass
            return f
        except Exception:
            pass
    return ImageFont.load_default()

def rows_board(rows, out, size=(420, 720)):
    """rows : [(title, mesh)] ; four views per row, the title above."""
    panels = []
    for title, m in rows:
        e = RV.seams(m)
        L = sum(m.edge_length(x) for x in e if len(m.edges[x]) == 2)
        lo, hi = m.P.min(0), m.P.max(0)
        c = 0.5 * (lo + hi)
        ext = hi - lo
        half = 0.5 * max(ext[1], max(ext[0], ext[2]) * size[1] / size[0]) * 1.06
        ims = []
        for d in ((0, 0, 1), (0, 0, -1), (1, 0, 0), (-1, 0, 0)):
            cam = {'ortho': True, 'eye': c + 10.0 * np.array(d, float), 'target': c, 'half': half, 'size': size, 'c': c}
            ims.append(RV.panel(m, e, cam))
        panels.append(('%s, %.2f m de coutures' % (title, L), ims))
    W, H = size[0] * 4, (size[1] + 44) * len(panels)
    B = Image.new('RGB', (W, H), (255, 255, 255))
    d = ImageDraw.Draw(B)
    f = font(22)
    for i, (t, ims) in enumerate(panels):
        d.text((14, i * (size[1] + 44) + 10), t, fill=(28, 28, 30), font=f)
        for j, im in enumerate(ims):
            B.paste(im, (j * size[0], i * (size[1] + 44) + 44))
    B.save(out)
    return out

def uvc_of(m):
