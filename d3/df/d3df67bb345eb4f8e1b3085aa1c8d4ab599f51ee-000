    res = {'asset': asset, 'method': method, 'load': info}
    txt = []
    for name in ('orig', 'zr'):
        lab, seams, isl, summ = catalog(m, name)
        cols = palette(len(isl))
        board_3d(m, lab, seams, cols, '%s %s : %d islands, %.2f m of inner seams' % (asset, 'artist original' if name == 'orig' else 'ZenRay ' + method, summ['islands'], summ['seams_inner_m']), out + '/%s_3d.png' % name, isl)
        tag = 'artist original' if name == 'orig' else 'ZenRay ' + method
        pcs = sorted(set(m.prim['piece'])) if name == 'orig' else ['']
        for pc in pcs:
            fs = [f for f in range(m.n) if not pc or m.prim['piece'][f] == pc]
            board_uv(m, name, lab, isl, cols, '%s %s uv %s' % (asset, tag, pc), out + '/%s_uv%s.png' % (name, ('_' + pc.replace('/', '_')) if pc else ''), faces=fs)
        res[name] = {'summary': summ, 'islands': isl}
        txt.append('== %s : %s' % (name, json.dumps(summ)))
        for i in sorted(isl, key=lambda x: -x['share']):
            txt.append('#%-3d faces %5d  share %5.1f%%  dens %.2f  +u %-10s +v %-10s mir %.2f  box [%.3f %.3f %.3f %.3f]  twin %s  stack %s  zero %s  slit %.3f  pieces %s  centre %s  nb %s' % (
                i['id'], i['faces'], 100 * i['share'], i['density_rel'], i['u_dir'], i['v_dir'], i['mirrored'], *i['uv_box'], i['mirror_of'], i['stacked_with'], i['zero_uv'], i['slit_m'], ','.join(i['pieces']), i['centre'], i['neighbours']))
    res['match'] = seam_match(m)
    txt.append('== match ' + json.dumps(res['match']))
    json.dump(res, open(out + '/catalog.json', 'w'), indent=1)
    open(out + '/catalog.txt', 'w').write('\n'.join(txt) + '\n')
    print('\n'.join(txt[:3]))
    print(res['match'])
