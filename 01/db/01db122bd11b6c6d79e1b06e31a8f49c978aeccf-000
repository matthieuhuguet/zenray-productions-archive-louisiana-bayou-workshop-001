    out = os.path.join(WORKSHOP, cfg['out_dir'], 'index.html')
    open(out + '.tmp', 'w', encoding='utf-8').write(page)
    os.replace(out + '.tmp', out)
    return out


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--config', default=os.path.join(HERE, 'articles.json'))
    ap.add_argument('--only', default=None, help='rebuild one article (its slug), then the index')
    a = ap.parse_args()
    cfg = json.load(open(a.config, encoding='utf-8'))
    by_source = {os.path.normpath(x['source']): x['slug'] for x in cfg['articles']}
    results_path = os.path.join(HERE, 'build-state.json')
    state = json.load(open(results_path)) if os.path.exists(results_path) else {}
    with tempfile.TemporaryDirectory() as tmp:
        for art in cfg['articles']:
            if a.only and art['slug'] != a.only and art['slug'] in state:
                continue
            state[art['slug']] = build_article(art, cfg, by_source, tmp)
            r = state[art['slug']]
            print(f"{art['slug']} : {r['bytes'] / 1e6:.2f} MB, missing {r['missing'][:5]}, js errors {len(r['js_errors'])}")
    json.dump(state, open(results_path, 'w'), indent=1)
    print('index :', build_index(cfg, state))


if __name__ == '__main__':
    main()
