# 20 October 2026, 13:15 Europe/Paris: measure recorded usage without binding or changing transcripts.
import argparse, collections, datetime, glob, json
from pathlib import Path

FIELDS = ('input_tokens', 'cache_creation_input_tokens', 'cache_read_input_tokens', 'output_tokens')

def usage_counts(usage):
    iterations = usage.get('iterations')
    items = iterations if iterations else [usage]
    return {key: sum(int(item.get(key, 0) or 0) for item in items) for key in FIELDS}

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--index', required=True)
    parser.add_argument('--root', default='/Users/zenray/.claude/projects')
    parser.add_argument('--out', required=True)
    args = parser.parse_args()
    index = json.loads(Path(args.index).read_text())
    rows, global_messages = [], {}
    for entry in index['conversations']:
        if entry.get('provider') != 'claude':
            continue
        session_id = entry['sessionId']
        paths = sorted(glob.glob(f'{args.root}/*/{session_id}.jsonl'))
        messages, boundaries, users, errors = {}, {}, {}, 0
        first, last = None, None
        for path in paths:
            with open(path) as stream:
                for line in stream:
                    try:
                        event = json.loads(line)
                    except (ValueError, TypeError):
                        errors += 1
                        continue
                    stamp = event.get('timestamp')
                    if stamp:
                        first = min(first or stamp, stamp)
                        last = max(last or stamp, stamp)
                    key = event.get('uuid')
                    if event.get('subtype') == 'compact_boundary':
                        boundaries[key or stamp] = {'timestamp': stamp, 'metadata': event.get('compactMetadata')}
                    if event.get('type') == 'user':
                        users[key or stamp] = stamp
                    message = event.get('message') or {}
                    usage = message.get('usage')
                    if event.get('type') != 'assistant' or not usage:
                        continue
                    message_key = message.get('id') or event.get('requestId') or key
                    if not message_key:
                        errors += 1
                        continue
                    counts = usage_counts(usage)
                    record = messages.setdefault(message_key, {'counts': dict.fromkeys(FIELDS, 0), 'timestamp': stamp, 'origin': event.get('sessionId')})
                    for field in FIELDS:
                        record['counts'][field] = max(record['counts'][field], counts[field])
        totals = {field: sum(record['counts'][field] for record in messages.values()) for field in FIELDS}
        boundary_times = sorted(v['timestamp'] for v in boundaries.values() if v['timestamp'])
        before = sum(1 for v in messages.values() if boundary_times and v['timestamp'] and v['timestamp'] < boundary_times[0])
        after = sum(1 for v in messages.values() if boundary_times and v['timestamp'] and v['timestamp'] > boundary_times[-1])
        row = {key: entry.get(key) for key in ('sessionId', 'title', 'strength', 'boundProject')}
        row.update(paths=paths, first=first, last=last, messages=len(messages), user_events=len(users), compactions=len(boundaries), messages_before_first_compaction=before, messages_after_last_compaction=after, parse_errors=errors, **totals)
        row['input_total'] = sum(totals[field] for field in FIELDS[:3])
        row['total'] = row['input_total'] + totals['output_tokens']
        rows.append(row)
        for key, record in messages.items():
            current = global_messages.setdefault(key, dict.fromkeys(FIELDS, 0))
            for field in FIELDS:
                current[field] = max(current[field], record['counts'][field])
    report = {'measuredAt': datetime.datetime.now(datetime.timezone.utc).isoformat(), 'index': args.index, 'scope': 'Main Claude Code transcripts referenced by the project index; includes other topics and inherited fork messages; excludes subagent files; not a billing statement.', 'method': 'Deduplicate message.id across copies and content blocks; maximum recorded counters per message; sum iterations if present, otherwise top-level usage; input total includes uncached, cache creation and cache reads.', 'uniqueUsageAcrossAllIndexedConversations': {field: sum(v[field] for v in global_messages.values()) for field in FIELDS}, 'conversations': rows}
    output = Path(args.out)
    output.parent.mkdir(parents=True, exist_ok=True)
    output.with_suffix('.json').write_text(json.dumps(report, ensure_ascii=False, indent=2))
    text = ['# Claude Code token audit (20 October 2026)', '', report['scope'], '', report['method'], '', '| Conversation | ID | Index relation | Input including cache | Output | Compactions | Messages before / after compaction |', '|---|---|---|---:|---:|---:|---:|']
    for row in rows:
        relation = row['boundProject'] or row['strength']
        text.append(f"| {row['title'].replace('|', '/')} | {row['sessionId']} | {relation} | {row['input_total']:,} | {row['output_tokens']:,} | {row['compactions']} | {row['messages_before_first_compaction']} / {row['messages_after_last_compaction']} |")
    output.with_suffix('.md').write_text('\n'.join(text)+'\n')
    print(json.dumps({'report': str(output.with_suffix('.md')), 'conversations': len(rows), 'strong': [r for r in rows if r['strength'] != 'weak' or r['boundProject']=='louisiana-bayou'], 'unique_all_index': report['uniqueUsageAcrossAllIndexedConversations']}, ensure_ascii=False))

if __name__ == '__main__':
    main()
