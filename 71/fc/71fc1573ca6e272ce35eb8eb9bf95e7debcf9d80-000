# 10 October 2026 : INCLINED RAKE BOARDS ARE CROPPED BY THE POST PLANE (Matthieu : the sloped beam enters the vertical one, cut only the edge that goes inside, never the straight post). EN: the four thin boards that follow the gable slope behind the front and back gable faces (long in x and y, thinner than 0.12 m in z, |z| about 6.2) run through the corner posts and stick out 0.29 m on the other side ; their lower-end points slide ALONG THE BOARD AXIS onto the vertical plane of the post inner face, so each board stops flat against the post. FR : planches de rive inclinees coupees au plan de la face interieure du poteau, le poteau droit n'est jamais coupe.
import hou, numpy as np
geo = hou.pwd().geometry()
arm = hou.node(hou.pwd().parent().path() + '/Component_Armature')
x_in = arm.parm('width').eval() * 0.5 - arm.parm('beam_size').eval() * 0.5
pieces = {}
for pr in geo.prims(): pieces.setdefault(pr.attribValue('piece_id'), []).append(pr)
for pid, prs in pieces.items():
    P = np.array([v.point().position() for pr in prs for v in pr.vertices()], float)
    lo, hi = P.min(axis=0), P.max(axis=0); sx, sy, sz = hi[0] - lo[0], hi[1] - lo[1], hi[2] - lo[2]
    if not (sx > 3.0 and sy > 3.0 and sz < 0.12 and 6.1 < abs((lo[2] + hi[2]) / 2.0) < 6.3): continue
    left = (lo[0] + hi[0]) / 2.0 < 0
    nrm = (sx * sx + sy * sy) ** 0.5; dx, dy = sx / nrm, sy / nrm
    done = set()
    for pr in prs:
        for v in pr.vertices():
            pt = v.point()
            if pt.number() in done: continue
            done.add(pt.number()); p = pt.position()
            if left and p[0] < -x_in:
                t = (-x_in - p[0]) / dx; pt.setPosition((-x_in, p[1] + dy * t, p[2]))
            elif (not left) and p[0] > x_in:
                t = (x_in - p[0]) / (-dx); pt.setPosition((x_in, p[1] + dy * t, p[2]))


