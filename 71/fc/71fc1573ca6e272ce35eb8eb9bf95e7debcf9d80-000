#### compute_uvs

int pt = vertexpoint(0, @vtxnum);
vector p = point(0, "P", pt);
int pr = vertexprim(0, @vtxnum);
int pid = prim(0, "piece_id", pr);

float density = chf("../../texel_density");
if (density <= 0.001) density = 2.0;
int seed = chi("../uv_seed");
int is_checker = chi("../../debug_uv_03") || chi("../../debug_uv_all");

float w = ch("../width");
float l = ch("../length");
float wh = ch("../wall_height");
float gh = ch("../gable_height");
float eave_oh = ch("../eave_overhang");
float gable_oh = ch("../gable_overhang");
float half_w = w * 0.5 + eave_oh;
float total_len = l + gable_oh * 2.0;
float slope_len = sqrt(half_w * half_w + gh * gh);
float pitch_angle = atan2(gh, half_w);
float cos_p = cos(pitch_angle);
float sin_p = sin(pitch_angle);

vector T_l = set( cos_p,  sin_p, 0.0);
vector T_r = set(-cos_p,  sin_p, 0.0);
vector N_l = set(-sin_p,  cos_p, 0.0);
vector N_r = set( sin_p,  cos_p, 0.0);

vector T = (p.x < 0.0) ? T_l : T_r;
vector N = (p.x < 0.0) ? N_l : N_r;

vector eave_ref = (p.x < 0.0) ? set(-half_w, wh, 0.0) : set(half_w, wh, 0.0);

float z_norm = (p.z + total_len * 0.5);
float dist_slope = dot(p - eave_ref, T) + 0.10;

vector2 uv_val = set(0.0, 0.0);

if (inprimgroup(0, "group_shingles", pr)) {
    float u_slope = dist_slope * density;
    float v_width = z_norm * density;
    float rnd_u = is_checker ? 0.0 : rand(float(pid) * 17.3 + float(seed));
    float rnd_v = is_checker ? 0.0 : rand(float(pid) * 31.7 + float(seed));
    uv_val = set(u_slope + rnd_u, v_width + rnd_v);
}
else if (inprimgroup(0, "group_ridge", pr)) {
    float u_len = z_norm * density;
    float v_arch = (p.x + 0.30) * density;
    float rnd_u = is_checker ? 0.0 : rand(float(pid) * 19.1 + float(seed));
    uv_val = set(u_len + rnd_u, v_arch);
}
else if (inprimgroup(0, "group_bargeboard", pr) || inprimgroup(0, "group_rafters", pr)) {
    float u_slope = dist_slope * density;
    float v_depth = dot(p, N) * density;
    float rnd_u = is_checker ? 0.0 : rand(float(pid) * 23.4 + float(seed));
    uv_val = set(u_slope + rnd_u, v_depth);
}
else if (inprimgroup(0, "group_fascia", pr)) {
    float u_len = z_norm * density;
    float v_h = dot(p, N) * density;
    uv_val = set(u_len, v_h);
}
else {
    float u_len = z_norm * density;
    float v_slope = dist_slope * density;
    uv_val = set(u_len, v_slope);
}

@uv = set(uv_val.x, uv_val.y, 0.0);


