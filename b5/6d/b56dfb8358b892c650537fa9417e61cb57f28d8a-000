# CINE_TIMELINE_CALLBACK_29_OCTOBER_2026
# Restore automatic viewport cuts after loading, 29 October 2026, 19:05 Europe/Paris.
def cine_timeline_event(event_type, frame):
    if event_type != hou.playbarEvent.FrameChanged:
        return
    controller = hou.node('/stage/CINE_REVIEW')
    if controller is None:
        return
    index = max(0, min(5, int((frame - 1) // 120)))
    controller.parm('shot').set(index)
    for viewer in hou.ui.paneTabs():
        if viewer.type() != hou.paneTabType.SceneViewer or viewer.pwd().path() != '/stage':
            continue
        viewport = viewer.curViewport()
        if viewport.cameraPath() != '/cameras/CINE_TIMELINE':
            viewport.setCamera('/cameras/CINE_TIMELINE')
        mode = hou.glShadingType.WireGhost if index == 4 else hou.glShadingType.Smooth
        settings = viewport.settings()
        for kind in [hou.displaySetType.DisplayModel, hou.displaySetType.CurrentModel, hou.displaySetType.SceneObject, hou.displaySetType.SelectedObject]:
            display = settings.displaySet(kind)
            if display.shadedMode() != mode:
                display.setShadedMode(mode)

def install_cine_timeline():
    for callback in hou.playbar.eventCallbacks():
        if getattr(callback, '__name__', '') == 'cine_timeline_event':
            hou.playbar.removeEventCallback(callback)
    hou.playbar.addEventCallback(cine_timeline_event)
    cine_timeline_event(hou.playbarEvent.FrameChanged, hou.frame())

if hou.isUIAvailable():
    install_cine_timeline()
