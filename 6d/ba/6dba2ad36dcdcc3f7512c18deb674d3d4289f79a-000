def mk(m, cls, x, y, **kw):
    n = mel.create_material_expression(m, cls, x, y)
    for k, v in kw.items(): n.set_editor_property(k, v)
    return n
def conn(a, ao, b, bi):
    for pin in (bi, 'Position', '', 'Input', 'A'):
        try:
            if mel.connect_material_expressions(a, ao, b, pin): return
        except Exception: pass
    raise AssertionError(('connect failed', b.get_class().get_name(), bi))
