def measure(P3, tris, uv, area_w):
    r, s, a3 = O.distortion(P3, tris, uv, 0.0)
    sc = np.sqrt(a3.sum() / (r ** 2 * a3).sum())
    r, s, a3 = O.distortion(P3, tris, uv * sc, 0.0)
    w = a3 / a3.sum()
    out = {}
    for t in (0.1, 0.2):
        out['within_%d' % int(t * 100)] = round(float(w[(np.abs(r - 1) <= t) & (s <= t)].sum()), 4)
    out['stretch_p50'] = round(float(np.median(s)), 3)
    out['stretch_p95'] = round(float(np.percentile(s, 95)), 3)
    return out

def chart_measure(m, name, chart):
    # every chart scaled on its own (an island is normalised to the density by itself, like the layout does), then the surface shares
    R, S_, A = [], [], []
    for k in sorted(set(chart.tolist()) - {-1}):
        fs = [int(f) for f in np.where(chart == k)[0]]
        P3, T, uv, corner = O._island_arrays(m, name, fs)
        r, s, a3 = O.distortion(P3, T, uv, 0.0)
        sc = np.sqrt(a3.sum() / max((r ** 2 * a3).sum(), 1e-30))
        r, s, a3 = O.distortion(P3, T, uv * sc, 0.0)
        R.append(r); S_.append(s); A.append(a3)
    R, S_, A = np.concatenate(R), np.concatenate(S_), np.concatenate(A)
    w = A / A.sum()
    out = {t: round(float(w[(np.abs(R - 1) <= t) & (S_ <= t)].sum()), 4) for t in (0.1, 0.2)}
    return {'within_10': out[0.1], 'within_20': out[0.2], 'stretch_p50': round(float(np.median(S_)), 3), 'stretch_p95': round(float(np.percentile(S_, 95)), 3)}

