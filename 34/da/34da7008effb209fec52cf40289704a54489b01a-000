  <path d="M290 150 H400" stroke="var(--ink)" stroke-width="2"/><path d="M390 142 L402 150 L390 158" stroke="var(--ink)" fill="none" stroke-width="2"/>
  <text class="svgtext2" x="296" y="138">ses UV</text>
  <rect x="440" y="30" width="240" height="230" fill="var(--bg2)" stroke="var(--ink)" stroke-width="2"/>
  <rect x="470" y="60" width="90" height="70" fill="var(--t4)" opacity=".85"/>
