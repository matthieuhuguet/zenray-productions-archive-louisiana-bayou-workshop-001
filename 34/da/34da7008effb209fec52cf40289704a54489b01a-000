<script>
/* ---------- simulation partagée : même règle que Houdini ---------- */
function mulberry(a){return function(){a|=0;a=a+0x6D2B79F5|0;var t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
var PAL=['#d97e63','#e9a35c','#c8b25a','#7fb08a','#6fa3bd','#8a86c7','#b57fb6','#e0687f','#58b7a5','#d9c27a'];
function layout(rows,cols,W,H,seed,glued){
  var tiles=[],step=H/rows,cw=W/cols;
  for(var r=0;r<rows;r++){
    var R=mulberry(seed*131+r*7919+17);
    if(glued){
      var cur=-R()*cw;
      for(var c=0;c<200&&cur<W+0.01;c++){var w=cw*(0.86+0.28*R());var x0=cur,x1=cur+w-0.003;cur+=w;tiles.push({r:r,x0:x0,x1:x1,k:Math.floor(R()*PAL.length)});}
    }else{
      var off=R()*cw;
      for(var c2=-1;c2<=cols;c2++){var cen=c2*cw+cw/2+off+(R()-0.5)*0.10*cw,wd=cw*(0.96+(R()-0.5)*0.20);tiles.push({r:r,x0:cen-wd/2,x1:cen+wd/2,k:Math.floor(R()*PAL.length)});}
    }
  }
  return {tiles:tiles,step:step,cw:cw};
}
function draw(cv,rows,cols,W,H,seed,glued,showGaps){
  var ctx=cv.getContext('2d'),cwpx=cv.width,chpx=cv.height,sx=cwpx/W,sy=chpx/H,L=layout(rows,cols,W,H,seed,glued),n=0,gaps=0;
  ctx.clearRect(0,0,cwpx,chpx);
  var style=getComputedStyle(document.documentElement);
  ctx.fillStyle=showGaps?'#e8344f':'#2a2826';ctx.fillRect(0,0,cwpx,chpx);
  var byRow=[];for(var i=0;i<rows;i++)byRow.push([]);
  L.tiles.forEach(function(t){
    var x0=Math.max(0,t.x0),x1=Math.min(W,t.x1);if(x1-x0<0.01)return;n++;
    var y=chpx-(t.r+1)*L.step*sy;
    ctx.fillStyle=PAL[t.k];ctx.fillRect(x0*sx,y+1,(x1-x0)*sx,L.step*sy-2);
    byRow[t.r].push([x0,x1]);
  });
  if(showGaps){
    for(var r=0;r<rows;r++){var a=byRow[r].sort(function(p,q){return p[0]-q[0]}),prev=0;
      a.forEach(function(p){if(p[0]-prev>0.01)gaps++;prev=Math.max(prev,p[1]);});
      if(W-prev>0.01)gaps++;}
  }
  return {n:n,gaps:gaps,step:L.step,cw:L.cw};
}
/* ----- démo 1 ----- */
(function(){
  var cv=document.getElementById('c1'),rows=document.getElementById('d1rows'),cols=document.getElementById('d1cols'),seed=1,
      P={church:{r:13,c:20,W:8.24,H:3.269},porch:{r:7,c:6,W:1.45,H:0.909}},cur='church';
  function fmt(x){return (Math.round(x*1000)/1000).toString().replace('.',',')}
  function go(){
    var p=P[cur];cv.width=1200;cv.height=Math.round(1200*p.H/p.W);if(cv.height>520)cv.height=520;
    var o=draw(cv,+rows.value,+cols.value,p.W,p.H,seed,true,false);
    document.getElementById('d1rowsO').textContent=rows.value;document.getElementById('d1colsO').textContent=cols.value;
    document.getElementById('d1n').textContent=o.n;document.getElementById('d1n2').textContent=o.n*2;
    document.getElementById('d1step').textContent=fmt(o.step);document.getElementById('d1cw').textContent=fmt(o.cw);
  }
  rows.oninput=go;cols.oninput=go;
  document.getElementById('d1seed').onclick=function(){seed++;go()};
  document.querySelectorAll('#demo1 [data-preset]').forEach(function(b){b.onclick=function(){cur=b.dataset.preset;rows.value=P[cur].r;cols.value=P[cur].c;
    document.querySelectorAll('#demo1 [data-preset]').forEach(function(x){x.setAttribute('aria-pressed',x===b)});go()}});
  go();
})();
