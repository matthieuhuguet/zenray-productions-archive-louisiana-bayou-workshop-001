</svg>
<figcaption>Les 13 pics se trouvent à 0,13 m, 0,38 m, 0,62 m… 3,18 m : un écart presque parfait de <b>0,256 m</b> d'un pic au suivant. Un écart régulier est le signe qu'on a bien trouvé les rangées.</figcaption>
</figure>
<script>
/* histogramme : 13 pics aux hauteurs mesurées */
(function(){var v=[0.13,0.38,0.62,0.86,1.11,1.36,1.62,1.87,2.13,2.39,2.65,2.92,3.18],h=[20,19,17,19,17,22,20,18,21,22,18,18,19],g=document.getElementById('hist'),s='';
