import hou, math, random
geo = hou.pwd().geometry()
# ---- trim sheet map (v from the bottom), measured on the height map: dark groove rows = seams ----------
SEAMS_LOUVER = [0.0, 0.111, 0.212, 0.313, 0.421]       # groove rows between the 4 louvers (bottom to top)
LOUVER_MARGIN_V, LOUVER_U = 0.012, (0.03, 0.97)         # stay off the grooves, off the end caps
PLANK_STRIPS = [(0.825, 0.990), (0.675, 0.805), (0.430, 0.550), (0.575, 0.630)]   # bands between seams : plank 1, plank 2, patch plank, molding
GROUP_STRIP = {'frame': 0, 'sash': 1, 'rail': 2, 'glass': 3}                       # one band per group (blue, cyan, yellow, green)
STRIP_U = (0.012, 0.988)
PAD = 0.004                                              # gap between two islands
PLANK_GROUPS = {'frame', 'sash', 'rail', 'glass'}
# ---- keep the original uv in uvl and switch to a vertex uv ------------------------------------------
if geo.findPointAttrib('uvl') is None: geo.addAttrib(hou.attribType.Point, 'uvl', (0.0, 0.0, 0.0))
old = geo.findPointAttrib('uv')
if old is not None:
    for pt in geo.points(): pt.setAttribValue('uvl', pt.attribValue('uv'))
    old.destroy()
if geo.findVertexAttrib('uv') is None: geo.addAttrib(hou.attribType.Vertex, 'uv', (0.0, 0.0, 0.0))
