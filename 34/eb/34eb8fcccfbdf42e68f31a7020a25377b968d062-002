python	[ 0	locks=0 ]	(	"# 9 October 2026 : white paint on the trim (corner boards, sills, eaves, rakes, stairs, rails). EN: every trim piece is mapped as ONE plank band of the AI-generated paint sheet (TMP: red node, to be replaced by a Copernicus height + 5 maps), the grain (u) runs along the LONG axis of the piece, v across its width. FR : chaque pièce de bordure = une planche de la feuille, sens du grain = sens de la longueur.
import hou, random
import numpy as np
geo = hou.pwd().geometry()
OLD = 'M_WornWood_02'; WHITE = 'M_PeelingWhiteWood_01'
GROOVES = [0.077, 0.195, 0.313, 0.435, 0.553, 0.671, 0.787, 0.897]
MARGIN_V = 0.010
UV_PER_M = 0.63
sel = [pr for pr in geo.prims() if pr.attribValue('material_id') == OLD]
cd = None
for pr in geo.prims():
    if pr.attribValue('material_id') == WHITE: cd = pr.attribValue('Cd'); break
parent = {}
def find(a):
    while parent.setdefault(a, a) != a:
        parent[a] = parent[parent[a]]; a = parent[a]
    return a
for pr in sel:
    pts = [v.point().number() for v in pr.vertices()]
    for q in pts[1:]: parent[find(q)] = find(pts[0])
pieces = {}
for pr in sel:
    pieces.setdefault(find(pr.vertices()[0].point().number()), []).append(pr)
for key, prs in pieces.items():
    uvm = UV_PER_M
    if geo.findPrimAttrib('px_per_m') is not None and prs[0].attribValue('px_per_m') > 0: uvm = prs[0].attribValue('px_per_m') / 2048.0      # 9 October 2026 : texel density in pixels per metre on the 2048 sheet (cross = 1024 px/m). FR : densité en px/m
    P = np.array([v.point().position() for pr in prs for v in pr.vertices()], dtype=float)
    c = P.mean(axis=0); Q = P - c
    if len(prs) == 1 or Q.shape[0] < 4:
        # 9 October 2026 : single face = its own frame, u along the longest edge, v across (aligned with the board edge). FR : une face seule suit son plus long bord.
        pr0 = prs[0]; P0 = np.array([v.point().position() for v in pr0.vertices()], dtype=float); n0 = np.array(pr0.normal())
        lens = [np.linalg.norm(P0[(i + 1) % len(P0)] - P0[i]) for i in range(len(P0))]; i0 = int(np.argmax(lens)); e0 = P0[(i0 + 1) % len(P0)] - P0[i0]; e0 = e0 / max(np.linalg.norm(e0), 1e-9)
        m0 = np.cross(n0, e0); m0 = m0 / max(np.linalg.norm(m0), 1e-9); ev = np.stack([e0, m0, n0], axis=1)
    else:
        w, V = np.linalg.eigh(np.cov(Q.T) + 1e-12 * np.eye(3)); ev = V[:, ::-1]      # columns: long, mid, short
    e1 = ev[:, 0]
    rnd = random.Random(key * 7919 + 13); k = rnd.randrange(len(GROOVES) - 1); off = rnd.random()
    lo, hi = GROOVES[k] + MARGIN_V, GROOVES[k + 1] - MARGIN_V
    for pr in prs:
        n = np.array(pr.normal())
        cand = [ev[:, 1], ev[:, 2]]
        across = cand[0] if abs(np.dot(n, cand[0])) < abs(np.dot(n, cand[1])) else cand[1]
        dp = [np.dot(np.array(v.point().position()) - c, across) for v in pr.vertices()]
        pr_all = np.dot(Q, across); dmin, dmax = pr_all.min(), pr_all.max(); width = max(dmax - dmin, 1e-4)
        vspan = min(width * uvm, hi - lo); mid = 0.5 * (lo + hi)
        for v, d in zip(pr.vertices(), dp):
            p = np.array(v.point().position())
            u = np.dot(p - c, e1) * uvm + off
            vv = mid + ((d - dmin) / width - 0.5) * vspan
            v.setAttribValue('uv', (float(u), float(vv), 0.0))
        pr.setAttribValue('material_id', WHITE); pr.setAttribValue('material_name', '01 Bois peint')
        if cd is not None: pr.setAttribValue('Cd', cd)
        pr.setAttribValue('grp', 'paint_trim')
"	)
