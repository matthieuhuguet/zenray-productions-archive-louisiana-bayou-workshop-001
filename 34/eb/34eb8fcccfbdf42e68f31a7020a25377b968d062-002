    int pr0 = addprim(0, \"poly\", pt3, pt2, pt1, pt0); // -Z (back)
    int pr1 = addprim(0, \"poly\", pt4, pt5, pt6, pt7); // +Z (front)
    int pr2 = addprim(0, \"poly\", pt0, pt1, pt5, pt4); // -Y (bottom)
    int pr3 = addprim(0, \"poly\", pt7, pt6, pt2, pt3); // +Y (top)
    int pr4 = addprim(0, \"poly\", pt0, pt4, pt7, pt3); // -X (left)
