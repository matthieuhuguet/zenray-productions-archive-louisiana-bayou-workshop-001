            disablewhentab "{ octane_objprop_objecttype != gaussiansplat }"
            hidewhentab "{ octane_objprop_objecttype != gaussiansplat }"

            parm {
                name    "octane_objprop_gsMode"
                label   "Source"
                type    ordinal
                default { "0" }
                help    "There are two modes for Gaussian Splat import. 1. Using a .ply file. This file will be rendered and any internals of the object node will be ignored. 2. Splat geo. This node reads splat information from the geometry inside the node. You can import a ply file using a \"file\" sop node, and it will render in Octane. If you want more control and the ability to modify the splats, Houdini 21's Bake GSplat sop node or the free GSOPS toolset can be used."
                menu {
                    "ply"   "File"
                    "geo"   "Geo"
                }
                parmtag { "script_callback" "" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "octane_objprop_gsPLYFile"
                label   "GS file"
                type    file
                default { "" }
                help    "Point to .ply or .spz gaussian splat file."
                hidewhen "{ octane_objprop_gsMode != ply }"
                parmtag { "filechooser_pattern" "*.ply,*.spz" }
            }
            parm {
                name    "sepparm16"
                label   "Separator"
                type    separator
                default { "" }
            }
            groupcollapsible {
                name    "octane_objprop_gsSettings"
                label   "Splat Settings"
                parmtag { "group_default" "1" }

                parm {
                    name    "octane_objprop_gstintColor"
                    label   "Tint color"
                    type    color
                    size    3
                    default { "1" "1" "1" }
                    help    "Color tint for the Gaussian splats."
                    range   { 0 1 }
                }
                parm {
                    name    "octane_objprop_gsalphaMin"
                    label   "Alpha min"
                    type    float
                    default { "0.01" }
                    help    "Regions of the Gaussian splats with alpha smaller than this will be invisible. Setting it to higher values will produce better performance but worse visual quality."
                    range   { 0.001 1 }
                }
                parm {
                    name    "octane_objprop_gscovarianceBias"
                    label   "Covariance bias"
                    type    log
                    default { "0" }
                    help    "Bias added to the Gaussian splats scale. Increase it to make thin lines such as text more clearly visible. Note: it may negatively affect rendering performance."
                    range   { 0 0.01 }
                }
                parm {
                    name    "octane_objprop_gscovarianceScale"
                    label   "Covariance scale"
                    type    float
                    default { "1" }
                    help    "Scale multiplier of the Gaussian splats."
                    range   { 0 2 }
                }
                parm {
                    name    "octane_objprop_gsintensity"
                    label   "Intensity"
                    type    float
                    default { "1" }
                    help    "The Gaussian splats color will be multiplied by this value."
                    range   { 0 2 }
                }
                parm {
                    name    "octane_objprop_gsflipAxes"
                    label   "Flip axes"
                    type    toggle
                    default { "0" }
                    help    "Inverts the Gaussian splat X and Y axes (scale by -1)."
                    range   { 0 2 }
                }
                parm {
                    name    "octane_objprop_gsshadowStrength"
                    label   "Shadow strength"
                    type    float
                    default { "0" }
                    help    "When set to non-zero, Gaussian splats will simulate shadows from the light sources. Larger value will produce darker shadow. Setting it to 0 effectively disables shadows."
                    range   { 0 1 }
                }
                parm {
                    name    "octane_objprop_gsshadowRayOffset"
                    label   "Shadow ray offset"
                    type    log
                    default { "0" }
                    help    "Offset that's added to the shadow ray position when tracing Gaussian splat shadows.Can be used to adjust the look of self-shadowing Gaussian splats."
                    range   { 0 10 }
                }
                parm {
                    name    "octane_objprop_gslightingMode"
                    label   "Lighting mode"
                    type    string
                    default { "0" }
                    help    "The way Gaussian splats interact with lights.\n\n'None': Gaussian splat brightness will not be scaled by the emitter power. Note: shadows from mesh emitters are not supported in this mode.\n'Power': Gaussian splat brightness will be scaled by the emitter power and dimmed with distance to the light.\n'Power and color': Gaussian splat brightness will be scaled by the emitter power and dimmed with distance to the light. Additionally, it will be tinted by the light color."
                    menu {
                        "0" "None"
                        "1" "Power"
                        "2" "Power and color"
                    }
                    range   { 0 10 }
                }
                parm {
                    name    "octane_objprop_gslightPassId"
                    label   "Light pass ID"
                    type    integer
                    default { "1" }
                    help    "ID of the light pass that captures the contribution of this Gaussian splat cloud."
                    range   { 1 20 }
                }
            }

            groupcollapsible {
                name    "octane_objprop_gsClippingFolder"
                label   "Clipping"

                parm {
                    name    "octane_objprop_gsclipMode"
                    label   "Clipping mode"
                    type    string
                    default { "0" }
                    help    "The way Gaussian splat cloud points are culled by clipping bounds.\n\n'None': no points are culled.\n'Box': points outside the specified clipping box primitive will be excluded from rendering.\n'Ellipsoid': points outside the specified clipping ellipsoid primitive will be excluded from rendering."
                    menu {
                        "0" "None"
                        "1" "Box"
                        "2" "Ellipsoid"
                    }
                }
                parm {
                    name    "sepparm19"
                    label   "Spacer"
                    type    separator
                    default { "" }
                    parmtag { "sidefx::layout_height" "small" }
                    parmtag { "sidefx::look" "blank" }
                }
                parm {
                    name    "octane_objprop_gsCBT_A_ROTATION_ORDER"
                    label   "Rotation Order"
                    type    integer
                    default { "5" }
                    help    "The axis order in which the rotation will be executed."
                    menu {
                        "0" "XYZ"
                        "1" "XZY"
                        "2" "YXZ"
                        "3" "YZX"
                        "4" "ZXY"
                        "5" "ZYX"
                    }
                    range   { 0! 5! }
                }
                parm {
                    name    "octane_objprop_gsCBT_A_TRANSLATION"
                    label   "Translation"
                    type    vector
                    size    3
                    default { "0" "0" "0" }
                    help    "Translation applied to the clipping primitive (either box or ellipsoid)."
                    range   { 0 1 }
                }
                parm {
                    name    "octane_objprop_gsCBT_A_ROTATION"
                    label   "Rotation"
                    type    vector
                    size    3
                    default { "0" "0" "0" }
                    help    "Rotation applied to the clipping primitive (either box or ellipsoid)."
                    range   { 0 1 }
                }
                parm {
                    name    "octane_objprop_gsCBT_A_SCALE"
                    label   "Scale"
                    type    vector
                    size    3
                    default { "1" "1" "1" }
                    help    "Scale applied to the clipping primitive (either box or ellipsoid). \n E.g. setting scale to (10, 10, 10) will make a clipping primitive with dimensions (10, 10, 10) centered at the origin of Gaussian splat cloud local space."
                    range   { 0 1 }
                }
                parm {
                    name    "sepparm18"
                    label   "Spacer"
                    type    separator
                    default { "" }
                    parmtag { "sidefx::layout_height" "small" }
                    parmtag { "sidefx::look" "blank" }
                }
                parm {
                    name    "octane_objprop_gsclipCreateControl"
                    label   "Create Control Object"
                    type    button
                    joinnext
                    default { "0" }
                    help    "Creates a control null and links it via a python expression."
                    parmtag { "script_callback" "import octane_objectparmutils; octane_objectparmutils.GaussianSplatClippingNullCreator(hou.pwd())" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "octane_objprop_gsclipLinkControl"
                    label   "Link Control Object"
                    type    button
                    joinnext
                    default { "0" }
                    help    "Links clipping parms to clipping control object. You can use this to link the clipping to any other object as well, but it won't have a guide or clipping mode parameter. For best results link to an \"Octane GS Clipping Control\" object"
                    parmtag { "script_callback" "import octane_objectparmutils; octane_objectparmutils.GaussianSplatClippingNullLinker(hou.pwd())" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "octane_objprop_gsclipDeleteNull"
                    label   "Bake Transforms"
                    type    button
                    default { "0" }
                    help    "Bakes the current values of the control null into the local parameters. Be aware that this will not bake animations."
                    parmtag { "script_callback" "import octane_objectparmutils; octane_objectparmutils.GaussianSplatClippingBakeTransforms(hou.pwd())" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "sepparm"
                    label   "Separator"
                    type    separator
                    default { "" }
                }
                parm {
                    name    "octane_objprop_gspriority"
                    label   "Clipping mat priority"
                    type    integer
                    default { "0" }
                    help    "The priority used to determine whether clipping material should clip this Gaussian splat cloud.\nClipping materials with lower or equal priority will be ignored.\nNote: intersection material is not supported when clipping Gaussian splats."
                    range   { -100 100 }
                }
            }

            groupcollapsible {
                name    "octane_objprop_gsOther"
                label   "Other Settings"

                parm {
                    name    "octane_objprop_gsclipWireframeMaterial"
                    label   "Wireframe material"
                    type    oppath
                    default { "" }
                    parmtag { "opfilter" "!!CUSTOM/MATERIAL!!" }
                    parmtag { "oprelative" "." }
