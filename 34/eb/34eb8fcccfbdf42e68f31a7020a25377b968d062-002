    p[3] = addpoint(geo, p_post - v_w + v_th);
    p[4] = addpoint(geo, p_beam - v_w - v_th);
    p[5] = addpoint(geo, p_beam + v_w - v_th);
    p[6] = addpoint(geo, p_beam + v_w + v_th);
    p[7] = addpoint(geo, p_beam - v_w + v_th);
    
    int pr;
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[3]); addvertex(geo, pr, p[2]); addvertex(geo, pr, p[1]); addvertex(geo, pr, p[0]);
    pr = addprim(geo, \"poly\"); addvertex(geo, pr, p[4]); addvertex(geo, pr, p[5]); addvertex(geo, pr, p[6]); addvertex(geo, pr, p[7]);
