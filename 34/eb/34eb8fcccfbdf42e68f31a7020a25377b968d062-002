import hou
geo = hou.pwd().geometry()
zw = hou.pwd().parent().parm('length').eval() * 0.5 + 0.0255
for pt in geo.points():
    p = pt.position()
    if p[2] < zw: pt.setPosition((p[0], p[1], zw))

# faces squashed to zero area by the clamp are removed (hidden boxes entirely behind the wall)
kill = [pr for pr in geo.prims() if pr.intrinsicValue('measuredarea') < 1e-7]
geo.deletePrims(kill, True)
"	)
