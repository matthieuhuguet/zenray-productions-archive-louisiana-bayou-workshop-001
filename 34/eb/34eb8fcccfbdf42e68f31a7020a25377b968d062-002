void make_slat(vector center, size; float tilt_deg; string grp_name; int pid) {
    matrix m = ident();
    rotate(m, radians(tilt_deg), set(1, 0, 0));
    
    vector h = size * 0.5;
    vector corners[8];
    corners[0] = set(-h.x, -h.y, -h.z);
    corners[1] = set( h.x, -h.y, -h.z);
    corners[2] = set( h.x,  h.y, -h.z);
    corners[3] = set(-h.x,  h.y, -h.z);
    corners[4] = set(-h.x, -h.y,  h.z);
    corners[5] = set( h.x, -h.y,  h.z);
    corners[6] = set( h.x,  h.y,  h.z);
    corners[7] = set(-h.x,  h.y,  h.z);
    
    int ipt[8];
    for (int k = 0; k < 8; k++) {
        vector pt = center + (corners[k] * m);
        ipt[k] = addpoint(0, pt);
    }
    
    int pr0 = addprim(0, \"poly\", ipt[3], ipt[2], ipt[1], ipt[0]);
    int pr1 = addprim(0, \"poly\", ipt[4], ipt[5], ipt[6], ipt[7]);
    int pr2 = addprim(0, \"poly\", ipt[0], ipt[1], ipt[5], ipt[4]);
    int pr3 = addprim(0, \"poly\", ipt[7], ipt[6], ipt[2], ipt[3]);
    int pr4 = addprim(0, \"poly\", ipt[0], ipt[4], ipt[7], ipt[3]);
    int pr5 = addprim(0, \"poly\", ipt[1], ipt[2], ipt[6], ipt[5]);
    
    int prims[] = array(pr0, pr1, pr2, pr3, pr4, pr5);
    foreach (int pr; prims) {
        setprimgroup(0, grp_name, pr, 1);
        setprimattrib(0, \"piece_id\", pr, pid);
    }
}

