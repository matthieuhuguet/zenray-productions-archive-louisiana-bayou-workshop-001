function void add_knee_brace(int geo; vector p_post; vector p_beam; float brace_w; float brace_th; vector normal_axis) {
    vector dir = normalize(p_beam - p_post);
    vector v_w = normalize(cross(dir, normal_axis)) * (brace_w * 0.5);
