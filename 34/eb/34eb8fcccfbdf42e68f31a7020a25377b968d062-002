float row_y = prim(0, \"min_v\", pr);
int row_id = int(floor(row_y * 10.0 + 0.5));
int wall_id = is_left ? 1 : (is_right ? 2 : (is_front ? 3 : 4));
int row_seed = row_id * 101 + wall_id * 37 + 13;

float u_offset = is_checker ? 0.0 : rand(float(row_seed) + 137.42) * 5.0;

@uv.x = (wall_u + u_offset) * density;
@uv.y = wall_v * density;
@uv.z = 0.0;

