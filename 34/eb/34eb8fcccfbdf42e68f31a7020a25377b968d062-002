for (int k = 1; k <= count; k++) {
    float y_pos = ifw + float(k) * step_y;
    make_slat(set(left_bay_x, y_pos, z_pos), set(bay_w, l_thick, l_depth), louver_angle_deg, \"group_louvers\", pid++);
