python	[ 0	locks=0 ]	(	"# 10 October 2026 (v2) : no two faces may lie on the same plane and overlap. This node removes the EXACT cases : (1) same points, same orientation : one face is kept (they z-fight and show as black wedges) ; (2) same points, opposite orientation, from two DIFFERENT pieces that are both closed solids : the faces are an internal contact, both are removed and the two solids stay closed together. Partial overlaps are reported by the scan, not deleted here. FR : retire les faces en double exactes ; deux faces opposees entre deux pieces fermees = contact interne, on retire les deux.
geo = hou.pwd().geometry()
P = geo.pointFloatAttribValues('P')
def pid_of(p): return p.attribValue('piece_id')
# closed pieces : every edge of the piece is shared by exactly two faces of that piece
edge_count = {}
for p in geo.prims():
    pid = pid_of(p)
    vs = [v.point().number() for v in p.vertices()]
    for a, b in zip(vs, vs[1:] + vs[:1]):
