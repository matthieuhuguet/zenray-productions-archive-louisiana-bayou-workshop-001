import hou, math, random
geo = hou.pwd().geometry()
# ---- trim sheet map (v from the bottom), measured on the height map: dark groove rows = seams ----------
SEAMS_LOUVER = [0.0, 0.111, 0.212, 0.313, 0.421]       # groove rows between the 4 louvers (bottom to top)
LOUVER_MARGIN_V, LOUVER_U = 0.012, (0.03, 0.97)         # stay off the grooves, off the end caps
PLANK_STRIPS = [(0.825, 0.990), (0.675, 0.805), (0.430, 0.550), (0.575, 0.630)]   # bands between seams : plank 1, plank 2, patch plank, molding
GROUP_STRIP = {'frame': 0, 'sash': 1, 'rail': 2, 'glass': 3}                       # one band per group (blue, cyan, yellow, green)
STRIP_U = (0.012, 0.988)
PAD = 0.004                                              # gap between two islands
PLANK_GROUPS = {'frame', 'sash', 'rail', 'glass'}
# ---- keep the original uv in uvl and switch to a vertex uv ------------------------------------------
if geo.findPointAttrib('uvl') is None: geo.addAttrib(hou.attribType.Point, 'uvl', (0.0, 0.0, 0.0))
old = geo.findPointAttrib('uv')
if old is not None:
    for pt in geo.points(): pt.setAttribValue('uvl', pt.attribValue('uv'))
    old.destroy()
if geo.findVertexAttrib('uv') is None: geo.addAttrib(hou.attribType.Vertex, 'uv', (0.0, 0.0, 0.0))
piece = {}
for pr in geo.prims():
    pid = pr.attribValue('piece_id'); b = piece.setdefault(pid, [1e9]*3 + [-1e9]*3)
    for v in pr.vertices():
        p = v.point().position()
        for i in range(3): b[i] = min(b[i], p[i]); b[3+i] = max(b[3+i], p[i])
rank = {}
for gname in ('slat_L', 'slat_R'):
    ids = sorted({pr.attribValue('piece_id') for pr in geo.prims() if pr.attribValue('grp') == gname})
    for i, pid in enumerate(ids): rank[pid] = i
def plane_axes(pr, b):
    n = pr.normal(); ax = max(range(3), key=lambda i: abs(n[i]))
    uax, vax = {0: (2, 1), 1: (0, 2), 2: (0, 1)}[ax]
    pts = [v.point().position() for v in pr.vertices()]
    eu = max(p[uax] for p in pts) - min(p[uax] for p in pts); ev = max(p[vax] for p in pts) - min(p[vax] for p in pts)
    if ev > eu: uax, vax = vax, uax                      # long side of the face runs along u
    return ax, uax, vax, pts
islands = {}; slat_front = []; slat_side = []
for pr in geo.prims():
    gname = pr.attribValue('grp'); pid = pr.attribValue('piece_id'); b = piece[pid]
    ax, uax, vax, pts = plane_axes(pr, b)
    if gname in ('slat_L', 'slat_R'):
        (slat_front if ax == 2 else slat_side).append((pr, gname, pid, ax, uax, vax))
    else:
        u0 = min(p[uax] for p in pts); v0 = min(p[vax] for p in pts)
        w = max(p[uax] for p in pts) - u0; h = max(p[vax] for p in pts) - v0
        islands.setdefault(gname, []).append({'pr': pr, 'pid': pid, 'uax': uax, 'vax': vax, 'u0': u0, 'v0': v0, 'w': w, 'h': h})
# ---- TRIM SHEET RULE : one group = one band, islands are stacked on the SAME band (overlap is the point of a trim sheet).
# The scale is the largest uniform one that makes the longest face of the group span the whole band width and its widest face the whole band height.
SHARED_DENSITY = True      # wooden groups share the smallest of the per-band maxima, so frame, sash and rail show planks of the same size
def band_scale(gname):
    v0s, v1s = PLANK_STRIPS[GROUP_STRIP[gname]]; items = islands[gname]
    return min((STRIP_U[1] - STRIP_U[0]) / max(i['w'] for i in items), (v1s - v0s) / max(i['h'] for i in items))
D_WOOD = min(band_scale(gn) for gn in ('frame', 'sash', 'rail') if gn in islands)
for gname, items in islands.items():
    v0s, v1s = PLANK_STRIPS[GROUP_STRIP[gname]]
    D = D_WOOD if (SHARED_DENSITY and gname in ('frame', 'sash', 'rail')) else band_scale(gname)
    for it in items:
        rnd = random.Random(it['pid']); room = max(0.0, (STRIP_U[1] - STRIP_U[0]) - it['w'] * D)
        ustart = STRIP_U[0] + rnd.random() * room                   # a different place on the band for every piece
        for v in it['pr'].vertices():
            p = v.point().position()
            v.setAttribValue('uv', (ustart + (p[it['uax']] - it['u0']) * D, v0s + (p[it['vax']] - it['v0']) * D, 0.0))
    geo.addAttrib(hou.attribType.Global, 'density_' + gname, float(D)) if geo.findGlobalAttrib('density_' + gname) is None else None
lo = D
# ---- louver slats : the front of each slat fills one whole louver between two grooves ----------------
for pr, gname, pid, ax, uax, vax in slat_front:
    b = piece[pid]; k = rank[pid] % 4
    va, vb = SEAMS_LOUVER[k] + LOUVER_MARGIN_V, SEAMS_LOUVER[k+1] - LOUVER_MARGIN_V
    for v in pr.vertices():
        p = v.point().position()
        u = (p[0] - b[0]) / max(b[3] - b[0], 1e-4); w = (p[1] - b[1]) / max(b[4] - b[1], 1e-4)
        v.setAttribValue('uv', (LOUVER_U[0] + (LOUVER_U[1] - LOUVER_U[0]) * u, va + (vb - va) * w, 0.0))
for pr, gname, pid, ax, uax, vax in slat_side:       # thin sides : a thin strip in the middle of the same louver
    b = piece[pid]; k = rank[pid] % 4; vm = (SEAMS_LOUVER[k] + SEAMS_LOUVER[k+1]) / 2
    for v in pr.vertices():
        p = v.point().position()
        v.setAttribValue('uv', (LOUVER_U[0] + (p[uax] - b[uax]) * 0.8, vm + (p[vax] - b[vax]) * 0.8 - 0.01, 0.0))
"	)
