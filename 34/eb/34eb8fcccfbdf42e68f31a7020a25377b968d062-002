import hou, numpy as np
geo = hou.pwd().geometry()
quads = []
for pr in geo.prims():
    if pr.numVertices() != 4: continue
    P = np.array([v.point().position() for v in pr.vertices()], float)
    quads.append((pr.number(), P))
kill = set()
for num, P in quads:
    if np.abs(P[:, 1]).max() >= 1e-4: continue
    x0, x1, z0, z1 = P[:, 0].min(), P[:, 0].max(), P[:, 2].min(), P[:, 2].max()
    if (x1 - x0) > 0.06 or (z1 - z0) < 0.2: continue
    for q, Q in quads:
        if q == num: continue
        if abs(Q[:, 0].min() - x0) < 1e-4 and abs(Q[:, 0].max() - x1) < 1e-4 and abs(Q[:, 2].min() - z0) < 1e-4 and abs(Q[:, 2].max() - z1) < 1e-4 and 1e-4 < Q[:, 1].max() <= 0.05 and Q[:, 1].min() >= -1e-6:
            kill.add(num); break
geo.deletePrims([geo.prim(i) for i in sorted(kill)], True)
"	)
maintainstate	[ 0	locks=0 ]	(	"off"	)
}
