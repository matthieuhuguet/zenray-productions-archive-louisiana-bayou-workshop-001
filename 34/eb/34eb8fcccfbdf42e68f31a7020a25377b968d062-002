    add_quad(0, l0_t, l1_t, l1_b, l0_b, \"group_trim\", pid);
    // Rear edge embedded (-Z)
    add_quad(0, l3_b, l2_b, l2_t, l3_t, \"group_roof_deck\", pid);
    
    // Right slope points
    vector r0_b = get_roof_pt(u0,  1, r_zf, hw_eave, ye, gh, flare);
    vector r1_b = get_roof_pt(u0,  1, r_zb, hw_eave, ye, gh, flare);
    vector r2_b = get_roof_pt(u1,  1, r_zb, hw_eave, ye, gh, flare);
    vector r3_b = get_roof_pt(u1,  1, r_zf, hw_eave, ye, gh, flare);
    
    vector r0_t = r0_b + nr0 * deck_th;
    vector r1_t = r1_b + nr1 * deck_th;
    vector r2_t = r2_b + nr1 * deck_th;
    vector r3_t = r3_b + nr0 * deck_th;
    
    // Top deck (outward +Y, +X)
    add_quad(0, r3_t, r2_t, r1_t, r0_t, \"group_roof_deck\", pid);
    // Bottom deck (facing interior -Y)
    add_quad(0, r0_b, r1_b, r2_b, r3_b, \"group_roof_deck\", pid);
    // Front edge bargeboard (+Z)
    add_quad(0, r0_b, r1_b, r1_t, r0_t, \"group_trim\", pid);
    // Rear edge (-Z)
    add_quad(0, r2_b, r3_b, r3_t, r2_t, \"group_roof_deck\", pid);
    
    // 9 October 2026 : the RIGHT slope had no front (+Z) and no back (-Z) face (its front edge quad ran along the slope's lower end instead), so the deck edge was open and you saw through it. FR : la pente droite n'avait ni face avant ni face arriere.
    add_quad(0, r3_t, r0_t, r0_b, r3_b, \"group_trim\", pid);
    add_quad(0, r2_b, r1_b, r1_t, r2_t, \"group_roof_deck\", pid);
    // At eave (u0 = 0), close the eave edge
    if (i == 0) {
        // Left eave fascia (-X)
        add_quad(0, l0_b, l0_t, l3_t, l3_b, \"group_trim\", pid);
        // Right eave fascia (+X)
        add_quad(0, r0_b, r3_b, r3_t, r0_t, \"group_trim\", pid);
    }
    pid++;
}

// 2. SOLID 3D WEDGE SHINGLES WITH CLEAN BOUNDED CUT AT VERGE
void make_wedge_shingle(int geo; vector center; float L, W_sh, T_butt, T_head; int side; float pitch_ang; string grp_name; int piece) {
    float hx = L * 0.5;
    float hz = W_sh * 0.5;
    
    // U = tangent along roof slope pointing UP towards ridge
    // V = normal pointing OUTWARD from roof into sky
    // W_dir = cross(U, V), tangent along roof course (right-handed orthonormal basis)
    vector U, V, W_dir;
    if (side == -1) {
        V = set(-sin(pitch_ang), cos(pitch_ang), 0.0);
        U = set( cos(pitch_ang), sin(pitch_ang), 0.0);
    } else {
        V = set( sin(pitch_ang), cos(pitch_ang), 0.0);
        U = set(-cos(pitch_ang), sin(pitch_ang), 0.0);
    }
    W_dir = cross(U, V);
    
    // 8 points in (U, V, W_dir) frame:
    // U: -hx (butt, down-slope towards eave), +hx (head, up-slope towards ridge)
    // V: 0 (bottom at deck), T (top facing sky)
    // W_dir: -hz to +hz along course
    vector p[];
    resize(p, 8);
    p[0] = center - hx * U + 0.0    * V - hz * W_dir;
    p[1] = center + hx * U + 0.0    * V - hz * W_dir;
    p[2] = center + hx * U + 0.0    * V + hz * W_dir;
    p[3] = center - hx * U + 0.0    * V + hz * W_dir;
    p[4] = center - hx * U + T_butt * V - hz * W_dir;
    p[5] = center + hx * U + T_head * V - hz * W_dir;
    p[6] = center + hx * U + T_head * V + hz * W_dir;
    p[7] = center - hx * U + T_butt * V + hz * W_dir;
    
    int ipt[];
    resize(ipt, 8);
    for (int k = 0; k < 8; ++k) ipt[k] = addpoint(geo, p[k]);
    
    int pr0 = addprim(geo, \"poly\", ipt[5], ipt[6], ipt[7], ipt[4]); // Top face (+V: outward into sky)
    int pr1 = addprim(geo, \"poly\", ipt[3], ipt[2], ipt[1], ipt[0]); // Bottom face (-V: inward to deck)
    int pr2 = addprim(geo, \"poly\", ipt[4], ipt[7], ipt[3], ipt[0]); // Butt face (-U: down-slope towards eave)
    int pr3 = addprim(geo, \"poly\", ipt[2], ipt[6], ipt[5], ipt[1]); // Head face (+U: up-slope towards ridge)
    int pr4 = addprim(geo, \"poly\", ipt[1], ipt[5], ipt[4], ipt[0]); // -W face
    int pr5 = addprim(geo, \"poly\", ipt[7], ipt[6], ipt[2], ipt[3]); // +W face
    
    int prims[] = array(pr0, pr1, pr2, pr3, pr4, pr5);
    foreach (int pr; prims) {
        setprimgroup(geo, grp_name, pr, 1);
        setprimattrib(geo, \"piece_id\", pr, piece);
    }
}

int num_rows = chi(\"../shingle_rows\");   // 9 October 2026 : slider, default 7 = counted on the colour-index reference
int num_cols = chi(\"../shingle_cols\");   // 9 October 2026 : slider, default 6 = 6 to 7 tiles per row on the reference
float col_w = r_len / float(num_cols);
float slope_len = sqrt(hw_eave * hw_eave + gh * gh);
float row_step = slope_len / float(num_rows);
float sh_len = row_step * 1.30;
float sh_th_butt = 0.016;
float sh_th_head = 0.004;

float z_front_limit = r_zf - 0.006;
float z_back_limit  = r_zb + 0.010;

for (int side = -1; side <= 1; side += 2) {
    for (int r = 0; r < num_rows; r++) {   // 9 October 2026 : last row reaches the ridge, cut_ridge trims it
        float u_bot = float(r) / float(num_rows);
        float u_top = min(1.0, u_bot + 0.15);
        float u_mid = 0.5 * (u_bot + u_top);
        
        vector pt_mid = get_roof_pt(u_mid, side, 0.0, hw_eave, ye, gh, flare);
        vector n_mid  = get_roof_norm(u_mid, side, hw_eave, gh, flare);
        
        float d_dx = hw_eave;
        float d_dy = gh * ((1.0 - flare) + 1.5 * flare * sqrt(max(0.001, u_mid)));
        float pitch_ang = atan2(d_dy, d_dx);
        
        matrix3 rot = ident();
        if (side == -1) {
            rotate(rot, pitch_ang, set(0, 0, 1));
        } else {
            rotate(rot, -pitch_ang, set(0, 0, 1));
        }
        
        float tw_min = ch(\"../tile_width_min\");   // 9 October 2026 : porch tile widths random in [0.09, 0.18] m, glued by a cursor
        float tw_max = ch(\"../tile_width_max\");
        float ref_cols = ch(\"../width_ref_cols\");
        float cursor = r_zb - rand(float(r) * 7.3 + float(side) * 11.0) * tw_max;
        
        for (int c = 0; c < 400; c++) {
            if (cursor > z_front_limit + 0.01) break;
            float seed = float(r * 41 + (c + 5) * 19 + side * 67);
            float w_tile = lerp(tw_min, tw_max, rand(seed + 1.0)) * (ref_cols / float(num_cols));
            float z_min = cursor;
            float z_max = cursor + w_tile - 0.003;
            cursor += w_tile;
            
            if (z_max <= z_back_limit || z_min >= z_front_limit) continue;
            
            float z0_clip = max(z_back_limit, z_min);
            float z1_clip = min(z_front_limit, z_max);
            float final_w = z1_clip - z0_clip;
            if (final_w < 0.025) continue;
            
            float final_z = 0.5 * (z0_clip + z1_clip);
            vector center = set(pt_mid.x, pt_mid.y, final_z) + n_mid * (deck_th + 0.001);
            
            make_wedge_shingle(0, center, sh_len, final_w, sh_th_butt, sh_th_head, side, pitch_ang, \"group_shingles\", pid++);
        }
    }
}

// 3. ARCHED RIDGE CAP TILES
void make_arched_ridge_tile(int geo; float z_center; float wing_w, tile_len, thickness; float pitch_angle, peak_y, h_sh; string grp_name; int pid) {
    float hz = tile_len * 0.5;
    int num_pts = 7;
    vector prof_top[];
    resize(prof_top, 7);
    vector prof_bot[];
    resize(prof_bot, 7);
    
    float cos_p = cos(pitch_angle);
    float sin_p = sin(pitch_angle);
    
    vector dir_l  = set(-cos_p, -sin_p, 0.0);
    vector dir_r  = set( cos_p, -sin_p, 0.0);
    vector norm_l = set(-sin_p,  cos_p, 0.0);
    vector norm_r = set( sin_p,  cos_p, 0.0);
    
    float r_in = 0.024;
    float r_out = r_in + thickness;
    float y_c = peak_y + max(0.004, (h_sh - r_in * 0.5) / cos_p);
    
    float pi_half = 1.57079632679;
    float theta_left  = pi_half + pitch_angle;
    float theta_right = pi_half - pitch_angle;
    
    prof_bot[0] = dir_l * wing_w + norm_l * h_sh + set(0, peak_y, 0);
    prof_top[0] = prof_bot[0] + norm_l * thickness;
    
    for (int k = 0; k < 5; ++k) {
        float t = float(k) / 4.0;
        float ang = theta_left + t * (theta_right - theta_left);
        float nx = cos(ang);
        float ny = sin(ang);
        prof_bot[k + 1] = set(nx * r_in,  y_c + ny * r_in,  0.0);
        prof_top[k + 1] = set(nx * r_out, y_c + ny * r_out, 0.0);
    }
    
    prof_bot[6] = dir_r * wing_w + norm_r * h_sh + set(0, peak_y, 0);
    prof_top[6] = prof_bot[6] + norm_r * thickness;
    
    int pts_t0[]; resize(pts_t0, 7);
    int pts_b0[]; resize(pts_b0, 7);
    int pts_t1[]; resize(pts_t1, 7);
    int pts_b1[]; resize(pts_b1, 7);
    
    for (int i = 0; i < num_pts; ++i) {
        pts_t0[i] = addpoint(geo, prof_top[i] + set(0, 0, z_center - hz));
        pts_b0[i] = addpoint(geo, prof_bot[i] + set(0, 0, z_center - hz));
        pts_t1[i] = addpoint(geo, prof_top[i] + set(0, 0, z_center + hz));
        pts_b1[i] = addpoint(geo, prof_bot[i] + set(0, 0, z_center + hz));
    }
    
    for (int i = 0; i < num_pts - 1; ++i) {
        int pr = addprim(geo, \"poly\", pts_t0[i], pts_t0[i+1], pts_t1[i+1], pts_t1[i]);
        setprimgroup(geo, grp_name, pr, 1);
        setprimattrib(geo, \"piece_id\", pr, pid);
    }
    for (int i = 0; i < num_pts - 1; ++i) {
        int pr = addprim(geo, \"poly\", pts_b1[i], pts_b1[i+1], pts_b0[i+1], pts_b0[i]);
        setprimgroup(geo, grp_name, pr, 1);
        setprimattrib(geo, \"piece_id\", pr, pid);
    }
    int pr_l = addprim(geo, \"poly\", pts_b0[0], pts_t0[0], pts_t1[0], pts_b1[0]);
    setprimgroup(geo, grp_name, pr_l, 1);
    setprimattrib(geo, \"piece_id\", pr_l, pid);
    int pr_r = addprim(geo, \"poly\", pts_t0[6], pts_b0[6], pts_b1[6], pts_t1[6]);
    setprimgroup(geo, grp_name, pr_r, 1);
    setprimattrib(geo, \"piece_id\", pr_r, pid);
    for (int i = 0; i < num_pts - 1; ++i) {
        int pr_f = addprim(geo, \"poly\", pts_b0[i], pts_b0[i+1], pts_t0[i+1], pts_t0[i]);
        setprimgroup(geo, grp_name, pr_f, 1);
        setprimattrib(geo, \"piece_id\", pr_f, pid);
        int pr_b = addprim(geo, \"poly\", pts_t1[i], pts_t1[i+1], pts_b1[i+1], pts_b1[i]);
        setprimgroup(geo, grp_name, pr_b, 1);
        setprimattrib(geo, \"piece_id\", pr_b, pid);
    }
}

float peak_pitch = atan2(gh * ((1.0 - flare) + 1.5 * flare), hw_eave);
int ridge_count = 0;   // 9 October 2026 : no inverted-gutter ridge cap, the slopes are cut flush at the ridge
float ridge_step = r_len / float(ridge_count);
float tile_len = ridge_step * 1.36;
float wing_w = 0.11;
float tile_th = 0.016;
float h_sh = deck_th + 0.008;

for (int i = 0; i < ridge_count; ++i) {
    float z_pos = r_zb + float(i) * ridge_step + ridge_step * 0.5;
    if (z_pos + tile_len * 0.5 > r_zf + 0.005) {
        z_pos = r_zf - tile_len * 0.5 + 0.005;
    }
    make_arched_ridge_tile(0, z_pos, wing_w, tile_len, tile_th, peak_pitch, yp + deck_th, h_sh, \"group_ridge_cap\", pid++);
}
