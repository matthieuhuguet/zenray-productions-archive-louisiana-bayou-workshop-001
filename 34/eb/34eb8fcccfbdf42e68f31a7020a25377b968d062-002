import hou
geo = hou.pwd().geometry()
SET_CD = False   # in the church the windows keep the church colours; True gives the diagnostic colours
# group -> (piece id ranges, colour). Edit here only.
GROUPS = [
    ('frame',   [(1, 11)],                   (0.20, 0.40, 0.95)),
    ('sash',    [(100, 113)],                (0.10, 0.80, 0.80)),
    ('glass',   [(200, 211)],                (0.25, 0.80, 0.30)),
    ('rail',    [(300, 310), (351, 361)],    (0.95, 0.85, 0.10)),
    ('slat_L',  [(311, 350)],                (1.00, 0.50, 0.10)),
    ('slat_R',  [(362, 401)],                (0.90, 0.15, 0.20)),
]
NAME = {'frame': 'Frame', 'sash': 'Frame', 'glass': 'Glass', 'rail': 'Shutters', 'slat_L': 'Shutters', 'slat_R': 'Shutters'}
# 9 October 2026 : shape fallback, a piece outside the id table that looks like a louver slat is a slat (the tables ended at 401 and 243 and 96 slats fell into 'frame'). FR : repli par la forme : une pièce hors table qui a la forme d'une lamelle est une lamelle.
SIZES = {}
for _pr in geo.prims():
    _b = SIZES.setdefault(_pr.attribValue('piece_id'), [1e9] * 3 + [-1e9] * 3)
    for _v in _pr.vertices():
