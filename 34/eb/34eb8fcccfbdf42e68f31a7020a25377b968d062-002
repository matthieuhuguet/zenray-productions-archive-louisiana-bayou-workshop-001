import hou
geo = hou.pwd().geometry()
occ = hou.Geometry(); occ.merge(geo)
occ.deletePrims([p for p in occ.prims() if p.stringAttribValue('material_name') not in ('01 Bois peint', '04 Bois des fenêtres', '03 Bardeaux')])
grp = geo.createPrimGroup('inward')
P = hou.Vector3(); N = hou.Vector3(); U = hou.Vector3()
for p in geo.prims():
    if p.stringAttribValue('material_name') != '01 Bois peint': continue
    vs = p.vertices()
    if len(vs) < 3: continue
    n = p.normal()
    c = hou.Vector3(0, 0, 0)
    for v in vs: c += v.point().position()
    c = c / len(vs)
    if occ.intersect(c + n * 0.002, n * 50.0, P, N, U) >= 0 and occ.intersect(c - n * 0.002, -n * 50.0, P, N, U) < 0: grp.add(p)
"	)
