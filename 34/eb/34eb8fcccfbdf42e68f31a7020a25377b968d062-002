// 16 October 2026 : ROOF HEIGHT FIELD. EN: dy(x, z) = - slope_sag * profile(u) - ridge_sag * ridge(z) * u, u = 1 - |x| / half_width (0 at the eave, 1 at the ridge), ridge(z) = 1 - |z / half_length| ^ power. Every board of the roof line is built along it. FR : champ de hauteur du toit, chaque planche le suit.
// curve array : 0 half width, 1 half length, 2 slope sag, 3 sag position, 4 ridge dip, 5 ridge power (VEX structs are not accepted in a wrangle snippet, so the field is a float array).
float zr_dy(float c[]; float x; float z) {
    float u = clamp(1.0 - abs(x) / max(c[0], 0.000001), 0.0, 1.0);
    float k = (c[3] > 0.001 && c[3] < 0.999) ? log(0.5) / log(c[3]) : 1.0;
    float ub = pow(u, k);
    float zn = min(abs(z) / max(c[1], 0.000001), 1.0);
    float zt = 1.0 - pow(zn, max(c[5], 0.01));
    return -c[2] * 4.0 * ub * (1.0 - ub) - c[4] * zt * u;
}
float zr_ddx(float c[]; float x; float z) { float e = 0.01; return (zr_dy(c, x + e, z) - zr_dy(c, x - e, z)) / (2.0 * e); }
float zr_ddz(float c[]; float x; float z) { float e = 0.05; return (zr_dy(c, x, z + e) - zr_dy(c, x, z - e)) / (2.0 * e); }
void make_arched_ridge_tile(float cv[]; float z_center; float wing_w, tile_len, thickness; float pitch_angle, peak_y, h_sh; string grp_name; int pid) {
    float hz = tile_len * 0.5;
    
    int num_pts = 7;
    vector prof_top[];
    resize(prof_top, 7);
    vector prof_bot[];
    resize(prof_bot, 7);
    
    float cos_p = cos(pitch_angle);
    float sin_p = sin(pitch_angle);
    
    vector dir_l  = set(-cos_p, -sin_p, 0.0);
    vector dir_r  = set( cos_p, -sin_p, 0.0);
    vector norm_l = set(-sin_p,  cos_p, 0.0);
    vector norm_r = set( sin_p,  cos_p, 0.0);
    
    float r_in = 0.030;
    float r_out = r_in + thickness;
    
    float y_c = peak_y + max(0.004, (h_sh - r_in * 0.5) / cos_p);
    
    float pi_half = 1.57079632679;
    float theta_left  = pi_half + pitch_angle;
    float theta_right = pi_half - pitch_angle;
    
    prof_bot[0] = dir_l * wing_w + norm_l * h_sh + set(0, peak_y, 0);
    prof_top[0] = prof_bot[0] + norm_l * thickness;
    
    for (int k = 0; k < 5; ++k) {
        float t = float(k) / 4.0;
        float ang = theta_left + t * (theta_right - theta_left);
        float nx = cos(ang);
        float ny = sin(ang);
        
        prof_bot[k + 1] = set(nx * r_in,  y_c + ny * r_in,  0.0);
        prof_top[k + 1] = set(nx * r_out, y_c + ny * r_out, 0.0);
    }
    
    prof_bot[6] = dir_r * wing_w + norm_r * h_sh + set(0, peak_y, 0);
    prof_top[6] = prof_bot[6] + norm_r * thickness;
    
    int pts_t0[];
    resize(pts_t0, 7);
    int pts_b0[];
    resize(pts_b0, 7);
    int pts_t1[];
    resize(pts_t1, 7);
    int pts_b1[];
    resize(pts_b1, 7);
    
    for (int i = 0; i < num_pts; ++i) {
        pts_t0[i] = addpoint(0, set(prof_top[i].x, prof_top[i].y + zr_dy(cv, prof_top[i].x, z_center - hz), z_center - hz));
        pts_b0[i] = addpoint(0, set(prof_bot[i].x, prof_bot[i].y + zr_dy(cv, prof_bot[i].x, z_center - hz), z_center - hz));
        pts_t1[i] = addpoint(0, set(prof_top[i].x, prof_top[i].y + zr_dy(cv, prof_top[i].x, z_center + hz), z_center + hz));
        pts_b1[i] = addpoint(0, set(prof_bot[i].x, prof_bot[i].y + zr_dy(cv, prof_bot[i].x, z_center + hz), z_center + hz));
    }
    
    // Top surface quads (strictly outward normal: +Y)
    for (int i = 0; i < num_pts - 1; ++i) {
        int pr = addprim(0, \"poly\", pts_t0[i], pts_t0[i+1], pts_t1[i+1], pts_t1[i]);
        setprimgroup(0, grp_name, pr, 1);
        setprimattrib(0, \"piece_id\", pr, pid);
    }
    
    // Bottom surface quads (strictly inward normal: -Y)
    for (int i = 0; i < num_pts - 1; ++i) {
        int pr = addprim(0, \"poly\", pts_b1[i], pts_b1[i+1], pts_b0[i+1], pts_b0[i]);
        setprimgroup(0, grp_name, pr, 1);
        setprimattrib(0, \"piece_id\", pr, pid);
    }
    
    // Left edge
    int pr_l = addprim(0, \"poly\", pts_b0[0], pts_t0[0], pts_t1[0], pts_b1[0]);
    setprimgroup(0, grp_name, pr_l, 1);
    setprimattrib(0, \"piece_id\", pr_l, pid);
    
    // Right edge
    int pr_r = addprim(0, \"poly\", pts_t0[6], pts_b0[6], pts_b1[6], pts_t1[6]);
    setprimgroup(0, grp_name, pr_r, 1);
    setprimattrib(0, \"piece_id\", pr_r, pid);
    
    // End caps
    for (int i = 0; i < num_pts - 1; ++i) {
        int pr_f = addprim(0, \"poly\", pts_b0[i], pts_b0[i+1], pts_t0[i+1], pts_t0[i]);
        setprimgroup(0, grp_name, pr_f, 1);
        setprimattrib(0, \"piece_id\", pr_f, pid);
        
        int pr_b = addprim(0, \"poly\", pts_t1[i], pts_t1[i+1], pts_b1[i+1], pts_b1[i]);
        setprimgroup(0, grp_name, pr_b, 1);
        setprimattrib(0, \"piece_id\", pr_b, pid);
    }
}

