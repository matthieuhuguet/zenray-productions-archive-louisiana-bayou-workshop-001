float seed = chf(\"../uv_seed\");
float v_scale = chf(\"../uv_v_offset_scale\");
float texel = chf(\"../../texel_density\");
if (texel <= 0.0) texel = 2.0;

int is_checker = chi(\"../../debug_uv_02\") || chi(\"../../debug_uv_all\");
if (is_checker) {
    v_scale = 0.0;
}

float u = 0.0;
float v = 0.0;

// Orthogonal box projection per dominant normal (Metric Scale)
if (abs(n.y) >= abs(n.x) && abs(n.y) >= abs(n.z)) {
    // Horizontal faces (treads, landing deck, post tops)
    u = @P.z * texel;
    v = @P.x * texel;
} else if (abs(n.x) >= abs(n.y) && abs(n.x) >= abs(n.z)) {
    // Left/Right faces (stringers, post sides, balusters)
    u = @P.z * texel;
    v = @P.y * texel;
} else {
    // Front/Back faces (risers, post front/back, balusters)
    u = @P.x * texel;
    v = @P.y * texel;
}

// Procedural variation per individual timber piece
float v_rand = rand(piece + seed + 0.1234);
v += v_rand * v_scale;

if (!is_checker && chi(\"../uv_random_flip\") && rand(piece + seed + 0.7891) > 0.5) {
