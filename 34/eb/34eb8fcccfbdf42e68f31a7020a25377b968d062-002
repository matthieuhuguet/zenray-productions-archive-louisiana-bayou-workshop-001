                if gname in ('slat_L', 'slat_R'): return 'rail', (0.95, 0.85, 0.10)      # 9 October 2026 : the id table put the whole right shutter (stiles, rails, hinges) in the slat group; only a SLAT SHAPE is a slat. FR : tout le volet droit (montants, traverses, charnières) était dans le groupe des lamelles.
                return gname, col
    return fallback(pid)
for nm, t, dv in (('grp', hou.attribType.Prim, ''), ('name', hou.attribType.Prim, '')):
    if geo.findPrimAttrib(nm) is None: geo.addAttrib(t, nm, dv)
if geo.findPointAttrib('Cd') is None: geo.addAttrib(hou.attribType.Point, 'Cd', (1.0, 1.0, 1.0))
for pr in geo.prims():
    pid = pr.attribValue('piece_id'); gname, col = find(pid)
    pr.setAttribValue('grp', gname); pr.setAttribValue('name', 'Window_A_' + NAME[gname])
    if SET_CD:
